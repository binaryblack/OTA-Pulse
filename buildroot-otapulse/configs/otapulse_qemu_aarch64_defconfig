# OTA-Pulse Example Configuration for QEMU AArch64
#
# This is a minimal example configuration for testing OTA-Pulse
# in a QEMU virtual machine. For production use, create a
# configuration specific to your hardware platform.
#
# Usage:
#   cd buildroot
#   make BR2_EXTERNAL=/path/to/OTA-Pulse/buildroot-otapulse otapulse_qemu_aarch64_defconfig
#   make menuconfig  # Configure OTA server URL and verification key
#   make
#

# Architecture
BR2_aarch64=y

# Toolchain
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Target packages - Core
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"

# System configuration
BR2_TARGET_GENERIC_HOSTNAME="otapulse-device"
BR2_TARGET_GENERIC_ISSUE="OTA-Pulse Buildroot System"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY=""
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_OTAPULSE_PATH)/board/otapulse/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OTAPULSE_PATH)/board/otapulse/post-image.sh"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="defconfig"
BR2_LINUX_KERNEL_IMAGE=y

# Bootloader (QEMU uses direct kernel boot, no U-Boot)

# Init system
BR2_INIT_SYSTEMD=y
BR2_PACKAGE_SYSTEMD_NETWORKD=y
BR2_PACKAGE_SYSTEMD_RESOLVED=y

# Required packages for OTA
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_LIBBLKID=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y
BR2_PACKAGE_POPT=y
BR2_PACKAGE_DBUS=y

# Network tools
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y

# OTA-Pulse Package
BR2_PACKAGE_OTAPULSE=y
# GAP-OTA-014: no live credential is committed here. Leave BR2_PACKAGE_OTAPULSE_TENANT_TOKEN
# unset and inject a real smk_/spt_ token at build time instead, e.g.:
#   make BR2_PACKAGE_OTAPULSE_TENANT_TOKEN="smk_<your-real-token>" otapulse_qemu_aarch64_defconfig
# or override it in a local post-defconfig fragment that isn't committed to git.
BR2_PACKAGE_OTAPULSE_SERVER_URL="http://192.168.0.123:8000"
# BR2_PACKAGE_OTAPULSE_TENANT_TOKEN is not set
BR2_PACKAGE_OTAPULSE_VERIFY_KEY="/home/krishna/buildroot-otapulse-test/keys/artifact-signing-public.pem"
BR2_PACKAGE_OTAPULSE_SIGNING_KEY="/home/krishna/buildroot-otapulse-test/keys/artifact-signing-private.pem"
BR2_PACKAGE_OTAPULSE_DEVICE_TYPE="qemu-aarch64"
BR2_PACKAGE_OTAPULSE_UPDATE_POLL_INTERVAL=300
BR2_PACKAGE_OTAPULSE_INVENTORY_POLL_INTERVAL=3600
BR2_PACKAGE_OTAPULSE_RETRY_POLL_INTERVAL=60
# Static partition layout — genimage pre-creates all A/B partitions
# BR2_PACKAGE_OTAPULSE_PARTITION_DYNAMIC is not set
# QEMU VirtIO disk layout: vda2=rootfs_a, vda3=rootfs_b
# Use direct device paths (not by-partlabel) to avoid udev timing dependency
BR2_PACKAGE_OTAPULSE_ROOTFS_PART_A="/dev/vda2"
BR2_PACKAGE_OTAPULSE_ROOTFS_PART_B="/dev/vda3"
BR2_PACKAGE_OTAPULSE_ROOTFS_SIZE="512M"
BR2_PACKAGE_OTAPULSE_DATA_SIZE="256M"
BR2_PACKAGE_OTAPULSE_BOOT_FILE=y
BR2_PACKAGE_OTAPULSE_DBUS=y
BR2_PACKAGE_OTAPULSE_INVENTORY=y
BR2_PACKAGE_OTAPULSE_STATE_SCRIPTS=y
BR2_PACKAGE_OTAPULSE_UPDATE_MODULES=y
BR2_PACKAGE_OTAPULSE_SYSTEMD=y

# SoC Monitoring (memfaultd, soc-ctl)
BR2_PACKAGE_MEMFAULT=y

# Host tools
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
