comment "socmond requires systemd (BR2_INIT_SYSTEMD)"
	depends on !BR2_INIT_SYSTEMD

config BR2_PACKAGE_SOCMOND
	bool "socmond"
	depends on BR2_INIT_SYSTEMD
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBCURL_CURL
	select BR2_PACKAGE_JQ
	help
	  SoC Monitoring daemon and CLI tools for embedded Linux devices.
	  Provides telemetry collection, crash capture, coredump handling,
	  device provisioning, and system health monitoring.

	  Installs:
	  - socmond: monitoring daemon (metrics, heartbeat, coredumps)
	  - socmond-watchdog: hardware watchdog monitor
	  - soc-ctl: device control CLI (config, provision, status)
	  - soc-deregister: device deregistration utility
	  - show-version: firmware version display

	  Requires systemd as the init system (BR2_INIT_SYSTEMD=y).

if BR2_PACKAGE_SOCMOND

comment "--- Server Provisioning (Optional) ---"

config BR2_PACKAGE_SOCMOND_SERVER_URL
	string "SoC Monitoring Server URL"
	default ""
	help
	  Base URL of the SoC Monitoring backend (e.g. http://192.168.0.123:8000),
	  baked into /etc/socmond/config.json's server.base_url at build time.

	  Leave empty to keep the shipped config.json default and provision
	  socmond at runtime instead — the normal path for boards with a
	  persistent (non-snapshot) rootfs.

config BR2_PACKAGE_SOCMOND_PROVISIONING_TOKEN
	string "SoC Monitoring Provisioning Token"
	default ""
	help
	  An spt_... provisioning token (see socMonitoring's
	  POST /api/provisioning-tokens) baked into config.json's
	  auth.provisioning_token at build time.

	  Required for devices with an ephemeral/snapshot-mode disk (e.g. QEMU
	  in snapshot mode), where a runtime SSH-based credential push cannot
	  survive the next VM restart.

config BR2_PACKAGE_SOCMOND_DASHBOARD
	bool "Local web dashboard"
	select BR2_PACKAGE_PYTHON3
	help
	  Install the local web dashboard (soc-dashboard) that provides
	  real-time device status via a browser interface on port 8080.

	  Requires Python 3. Adds ~5MB to the image.
	  The dashboard service is disabled by default and must be
	  enabled manually with: soc-ctl dashboard enable

endif # BR2_PACKAGE_SOCMOND
