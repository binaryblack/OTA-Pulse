diff --git a/otapulse-convert-package b/otapulse-convert-package
index 1d11d30..9babe93 100755
--- a/otapulse-convert-package
+++ b/otapulse-convert-package
@@ -293,7 +293,10 @@ log_info "  Boot partition    $(disk_sectors_to_mb ${boot_part_sectors}) MiB"
 log_info "  RootFS partitions $(disk_sectors_to_mb ${rootfs_part_sectors}) MiB x 2"
 log_info "  Data partition    $(disk_sectors_to_mb ${data_part_sectors}) MiB"
 
-# Initialize sdcard image file
+# Initialize sdcard image file. Remove a leftover image of an earlier conversion first: dd with
+# count=0 and seek only extends an existing file, and the partitions below are written sparsely
+# (OTAPULSE_SPARSE_IMAGE), so stale blocks of the old image would survive into the new one.
+run_and_log_cmd "rm -f ${img_path}"
 run_and_log_cmd \
     "dd if=/dev/zero of=${img_path} bs=512 count=0 seek=${disk_image_total_sectors} status=none"
 
