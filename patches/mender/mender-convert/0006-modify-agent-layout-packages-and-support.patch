diff --git a/modules/support.sh b/modules/support.sh
new file mode 100644
index 0000000..c3c5835
--- /dev/null
+++ b/modules/support.sh
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: Apache-2.0
+#
+# Checks and additions that make a converted image behave like an OTA-Pulse device image, beyond
+# what the soc-ota-agent and socmond packages bring.
+
+# Fail unless the OTA-Pulse packages are installed in the image and in bootloader mode.
+#
+#  $1 - image root directory
+function otapulse_check_packages_installed() {
+    local -r root="$1"
+    local pkg status
+
+    for pkg in soc-ota-agent socmond; do
+        status=$(dpkg-query --admindir="${root}/var/lib/dpkg" -W -f='${db:Status-Status}' "${pkg}" 2>/dev/null || true)
+        if [ "${status}" != "installed" ]; then
+            log_error "The package ${pkg} is not installed in the image (status: '${status:-unknown}')."
+            log_fatal "Put the soc-ota-agent and socmond .deb files for the image architecture into ${OTAPULSE_INSTALL_INPUT_PACKAGES_PATH}."
+        fi
+    done
+    if [ "$(tr -d '[:space:]' < "${root}/etc/otapulse/boot_mode" 2>/dev/null)" != "bootloader" ]; then
+        log_fatal "/etc/otapulse/boot_mode of the image is not 'bootloader'. The converted image must run in bootloader compatibility mode."
+    fi
+    log_info "The soc-ota-agent and socmond packages are installed, bootloader compatibility mode"
+}
+
+# Install the helpers and defaults of a converted image.
+#
+#  $1 - image root directory
+function otapulse_install_image_support() {
+    local -r root="$1"
+    local -r wants="${root}/etc/systemd/system"
+
+    if [ "${OTAPULSE_MACHINE_ID_PERSIST}" = "y" ]; then
+        log_info "Keeping the machine-id on the data partition across updates"
+        run_and_log_cmd "sudo install -D -m 755 support/otapulse-machine-id ${root}/usr/lib/otapulse/otapulse-machine-id"
+        run_and_log_cmd "sudo install -D -m 644 support/otapulse-machine-id.service ${root}/lib/systemd/system/otapulse-machine-id.service"
+        run_and_log_cmd "sudo mkdir -p ${wants}/sysinit.target.wants"
+        run_and_log_cmd "sudo ln -sf /lib/systemd/system/otapulse-machine-id.service ${wants}/sysinit.target.wants/otapulse-machine-id.service"
+    fi
+
+    # The package enables the watchdog like on a device image. See OTAPULSE_SOCMOND_WATCHDOG.
+    if [ "${OTAPULSE_SOCMOND_WATCHDOG}" != "y" ]; then
+        log_info "Disabling the monitoring watchdog (OTAPULSE_SOCMOND_WATCHDOG is not 'y')"
+        run_and_log_cmd "sudo rm -f ${wants}/multi-user.target.wants/socmond-watchdog.service"
+    fi
+}
diff --git a/support/otapulse-machine-id b/support/otapulse-machine-id
new file mode 100755
index 0000000..f48eda1
--- /dev/null
+++ b/support/otapulse-machine-id
@@ -0,0 +1,53 @@
+#!/bin/sh
+# SPDX-License-Identifier: Apache-2.0
+#
+# otapulse-machine-id - keep one machine-id across OTA-Pulse root file system updates.
+#
+# The root file system is replaced by every update, and the copy that an update writes carries
+# the machine-id the image had when it was converted (none). Without this unit the device would
+# generate a new machine-id after every update and show up in the OTA-Pulse backend under a new
+# identity (the monitoring daemon identifies the device by its machine-id).
+#
+# The persistent copy lives on the data partition (/data/etc/machine-id):
+#   - first boot: remember the machine-id the system generated;
+#   - later boots, and the first boot of an updated slot: put the remembered one back.
+# Only the machine-id is handled here, nothing else about the network interfaces.
+
+set -e
+
+PERSIST="${OTAPULSE_MACHINE_ID_PERSIST_FILE:-/data/etc/machine-id}"
+TARGET="${OTAPULSE_MACHINE_ID_FILE:-/etc/machine-id}"
+LOG_TAG="otapulse-machine-id"
+
+log() {
+    logger -t "$LOG_TAG" "$1" 2>/dev/null || true
+    echo "[$LOG_TAG] $1"
+}
+
+# A valid machine-id is exactly 32 lowercase hex characters, optionally followed by one newline.
+# An "uninitialized" marker or an empty file is not valid.
+is_valid_machine_id() {
+    [ -s "$1" ] || return 1
+    LC_ALL=C head -c 32 "$1" 2>/dev/null | LC_ALL=C grep -Eq '^[0-9a-f]{32}$'
+}
+
+mkdir -p "$(dirname "$PERSIST")"
+
+if is_valid_machine_id "$PERSIST"; then
+    if ! cmp -s "$PERSIST" "$TARGET"; then
+        cp "$PERSIST" "$TARGET"
+        log "Restored the machine-id from $PERSIST"
+    fi
+else
+    [ ! -e "$PERSIST" ] || log "$PERSIST is not a valid machine-id, replacing it"
+    if ! is_valid_machine_id "$TARGET"; then
+        if command -v systemd-machine-id-setup >/dev/null 2>&1; then
+            systemd-machine-id-setup >/dev/null 2>&1 || true
+        fi
+    fi
+    if ! is_valid_machine_id "$TARGET"; then
+        tr -d '-' < /proc/sys/kernel/random/uuid > "$TARGET"
+    fi
+    cp "$TARGET" "$PERSIST"
+    log "Saved the machine-id to $PERSIST"
+fi
diff --git a/support/otapulse-machine-id.service b/support/otapulse-machine-id.service
new file mode 100644
index 0000000..7e908d6
--- /dev/null
+++ b/support/otapulse-machine-id.service
@@ -0,0 +1,22 @@
+[Unit]
+Description=OTA-Pulse persistent machine-id
+Documentation=https://github.com/binaryblack/OTA-Pulse
+DefaultDependencies=no
+RequiresMountsFor=/data
+After=local-fs.target
+Before=sysinit.target soc-ota-agent.service socmond.service systemd-machine-id-commit.service
+Conflicts=shutdown.target
+Before=shutdown.target
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+# The first boot of an updated slot starts with an empty machine-id, which systemd answers with a
+# read-only transient file mounted over /etc/machine-id. Drop it so that the restore can write.
+ExecStartPre=-/bin/sh -c "grep -q ' /etc/machine-id ' /proc/self/mountinfo && umount /etc/machine-id"
+ExecStart=/usr/lib/otapulse/otapulse-machine-id
+StandardOutput=journal
+StandardError=journal
+
+[Install]
+WantedBy=sysinit.target
