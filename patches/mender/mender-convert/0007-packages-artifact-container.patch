+# Write the OTA-Pulse artifact (the .otapulse file) of the converted root file system. This function
+# is defined here so that a configuration file passed with '--config' can replace it.
+#
+#  $1 - device type(s), space separated
+#  $2 - artifact name
+#  $3 - base name of the output files
+#
+# The state scripts of the soc-ota-agent package are embedded: an update runs the scripts that
+# come with the ARTIFACT, never the ones of the installed image.
+function otapulse_create_artifact() {
+    local -r device_types="${1}"
+    local -r artifact_name="${2}"
+    local -r image_name="${3}"
+    local -a device_type_args=()
+    local -a script_args=()
+    local -a key_args=()
+    local device_type script
+
+    for device_type in ${device_types}; do
+        device_type_args+=(--device-type "${device_type}")
+    done
+    for script in work/rootfs/usr/share/otapulse/state-scripts/*; do
+        [ -f "${script}" ] && script_args+=(--script "${script}")
+    done
+    if [ "${#script_args[@]}" -eq 0 ]; then
+        log_fatal "No state scripts found in /usr/share/otapulse/state-scripts of the image: the soc-ota-agent package is missing."
+    fi
+    if [ -n "${OTAPULSE_ARTIFACT_SIGNING_KEY}" ]; then
+        [ -f "${OTAPULSE_ARTIFACT_SIGNING_KEY}" ] || log_fatal "OTAPULSE_ARTIFACT_SIGNING_KEY: file not found: ${OTAPULSE_ARTIFACT_SIGNING_KEY}"
+        key_args=(--key "${OTAPULSE_ARTIFACT_SIGNING_KEY}")
+    else
+        log_warn "OTAPULSE_ARTIFACT_SIGNING_KEY is not set: the artifact is not signed and an agent that requires signed artifacts will refuse it"
+    fi
+
+    otapulse_artifact=deploy/${image_name}.otapulse
+    log_info "Writing the OTA-Pulse artifact to: ${otapulse_artifact}"
+    log_info "This can take up to 20 minutes depending on which compression method is used"
+
+    run_and_log_cmd "otapulse-artifact write rootfs-image \
+      --compression ${OTAPULSE_ARTIFACT_COMPRESSION} \
+      --no-progress \
+      --file work/rootfs.img \
+      --output-path ${otapulse_artifact} \
+      --artifact-name ${artifact_name} \
+      ${device_type_args[*]} \
+      ${script_args[*]} \
+      ${key_args[*]:-}"
+}
