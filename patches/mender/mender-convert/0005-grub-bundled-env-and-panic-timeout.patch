+# grub_install_panic_dropin
+#
+# Kernel panic timeout for the GRUB integration: a drop-in for the image's own GRUB configuration
+# (read by update-grub), so that every menu entry it generates carries panic=N.
+function grub_install_panic_dropin() {
+    run_and_log_cmd "sudo mkdir -p work/rootfs/etc/default/grub.d"
+    printf 'GRUB_CMDLINE_LINUX="${GRUB_CMDLINE_LINUX:+${GRUB_CMDLINE_LINUX} }panic=%s"\n' \
+        "${OTAPULSE_PANIC_TIMEOUT_S}" > work/otapulse-panic.cfg
+    run_and_log_cmd "sudo install -m 644 work/otapulse-panic.cfg work/rootfs/etc/default/grub.d/90-otapulse-panic.cfg"
