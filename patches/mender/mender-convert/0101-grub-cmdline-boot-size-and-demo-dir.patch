diff --git a/configs/debian_arm64_uefi_config b/configs/debian_arm64_uefi_config
index 49d0aa2..0ec5bb0 100644
--- a/configs/debian_arm64_uefi_config
+++ b/configs/debian_arm64_uefi_config
@@ -39,5 +39,8 @@ OTAPULSE_SPARSE_IMAGE="y"
 OTAPULSE_GRUB_EFI_INTEGRATION=y
 OTAPULSE_GRUB_D_INTEGRATION=y
 
-# Packages (soc-ota-agent, socmond) come from input/packages. A file system resize tool and the
-# kernel tools of the image are already there.
+# The boot partition of the input image is 127 MiB
+OTAPULSE_BOOT_PART_SIZE_MB="128"
+
+# Kernel console: the serial port of the QEMU "virt" machine, then the screen
+OTAPULSE_GRUB_KERNEL_BOOT_ARGS="console=tty0 console=ttyAMA0,115200n8"
diff --git a/configs/otapulse_grub_config b/configs/otapulse_grub_config
index dfd00be..2427122 100644
--- a/configs/otapulse_grub_config
+++ b/configs/otapulse_grub_config
@@ -13,10 +13,9 @@ OTAPULSE_GRUB_D_INTEGRATION=auto
 # Version of the GRUB EFI binary of the assets (standalone mode only).
 GRUB_VERSION=2.12
 
-# Extra Linux kernel arguments for standalone mode, for example the content of /proc/cmdline of a
-# known good system. Ignored when the GRUB integration is used (set the arguments in
-# /etc/default/grub of the image instead). The panic timeout (OTAPULSE_PANIC_TIMEOUT_S) is added
-# when the arguments do not carry one.
+# Extra Linux kernel arguments, for example a console. With the GRUB integration of the image's own
+# GRUB they are added to its command line (GRUB_CMDLINE_LINUX); in standalone mode they replace the
+# default arguments. The panic timeout (OTAPULSE_PANIC_TIMEOUT_S) is always added last.
 OTAPULSE_GRUB_KERNEL_BOOT_ARGS=""
 
 # Names of the Linux kernel image and the initial ram disk in /boot. The tool detects them; only
