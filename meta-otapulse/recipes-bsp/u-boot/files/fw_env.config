# U-Boot Environment Configuration
# Used by fw_printenv/fw_setenv utilities
# Format: Device offset size [erase_size] [env_count]

# For eMMC/SD card (adjust device and offset for your platform)
# Primary environment
/dev/mmcblk0        0x100000    0x4000

# Redundant environment (for reliability)
/dev/mmcblk0        0x104000    0x4000
