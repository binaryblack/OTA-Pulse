# Sample local.conf for OTAPulse integration
# Copy relevant sections to your build/conf/local.conf
#
# MINIMAL CONFIGURATION (just 1 line needed!):
#   OTA_SERVER_URL = "https://your-ota-server.com"
#
# Then in your image recipe, add:
#   inherit otapulse        # For standard images
#   inherit otapulse-large  # For Qt/multimedia images (>1GB)

# =============================================================
# REQUIRED: OTA Server Configuration
# =============================================================
OTA_SERVER_URL = "https://ota.example.com"

# =============================================================
# OPTIONAL: Below settings have sensible defaults
# =============================================================

# Target machine configuration
MACHINE ?= "qemuarm64"

# Distribution (use your BSP's distro, e.g., fsl-imx-xwayland for NXP)
# DISTRO ?= "soc-monitoring"

# Package format
PACKAGE_CLASSES ?= "package_ipk"

# Build optimization
BB_NUMBER_THREADS ?= "${@oe.utils.cpu_count()}"
PARALLEL_MAKE ?= "-j ${@oe.utils.cpu_count()}"

# Download and cache directories (adjust paths)
DL_DIR ?= "${TOPDIR}/../downloads"
SSTATE_DIR ?= "${TOPDIR}/../sstate-cache"
TMPDIR = "${TOPDIR}/tmp"

# License acceptance
LICENSE_FLAGS_ACCEPTED += "commercial"

# Extra image features for development
EXTRA_IMAGE_FEATURES += "debug-tweaks ssh-server-openssh"

# SDK configuration
SDKMACHINE ?= "x86_64"

# Disk space monitoring
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},1G,100K \
    STOPTASKS,${DL_DIR},1G,100K \
    STOPTASKS,${SSTATE_DIR},1G,100K \
    STOPTASKS,/tmp,100M,100K \
    HALT,${TMPDIR},100M,1K \
    HALT,${DL_DIR},100M,1K \
    HALT,${SSTATE_DIR},100M,1K \
    HALT,/tmp,10M,1K"

# QEMU configuration (for testing)
QEMU_USE_KVM = "1"
QB_MEM = "-m 1024"

# Image types
IMAGE_FSTYPES = "wic wic.gz ext4"

# SoC Monitoring specific configuration
# Uncomment and set your API endpoint
# SOC_MONITORING_API_URL = "https://your-api-server.com"
# SOC_MONITORING_API_KEY = "your-api-key"

# OTA Server URL (REQUIRED - set to your OTAPulse server)
OTA_SERVER_URL = "https://ota.example.com"

# Firmware version (auto-incremented or set manually)
DISTRO_VERSION = "1.0.0"

# Enable/disable debug build (affects symbol generation)
DEBUG_BUILD = "0"

# =============================================================
# OTA Signature Configuration
# =============================================================

# Enable/disable signature verification on device
# When enabled, the device will only accept signed firmware updates
# Options: "1" (enabled) or "0" (disabled)
SOC_OTA_SIGNATURE_VERIFICATION = "1"

# Private key for signing Mender artifacts during build
# This key will be used to sign the .mender artifact automatically
# Supports RSA (recommended: RSA-4096) and ECDSA (ECDSA-P384) keys
# Leave empty to disable automatic signing
SOC_OTA_SIGNING_KEY = "/home/krishna/radxa-cm5/testkeys/Test_private.pem"

# Optional: Signing certificate (required for some key types)
# If your private key requires a certificate chain, specify it here
# Example: SOC_OTA_SIGNING_CERT = "/path/to/certificate.pem"
SOC_OTA_SIGNING_CERT ?= ""

# Public key(s) for signature verification on device
# These keys will be deployed to /etc/soc-monitoring/signing-keys/active/
# Multiple keys can be specified (space-separated) for key rotation
# Leave empty to use the default production-rsa-public.pem from the layer
# Example: SOC_OTA_VERIFICATION_KEYS = "/path/to/custom-public-key.pem"
SOC_OTA_VERIFICATION_KEYS ?= ""

# Directory where signing keys are stored on the device
# Default: /etc/soc-monitoring/signing-keys
SOC_OTA_SIGNING_KEYS_DIR ?= "/etc/soc-monitoring/signing-keys"

# =============================================================
# Mender Artifact Configuration
# =============================================================

# Device type identifier for Mender artifacts
# This must match the device_type file on the target device
MENDER_DEVICE_TYPE ?= "${MACHINE}"

# Compression algorithm for artifacts: "gzip", "lzma", "none"
MENDER_ARTIFACT_COMPRESSION ?= "gzip"

# =============================================================

# For production builds, uncomment:
# EXTRA_IMAGE_FEATURES:remove = "debug-tweaks"
# IMAGE_FEATURES:remove = "ssh-server-openssh"
# IMAGE_INSTALL:remove = "strace gdb"

# =============================================================
# Partition Size Configuration (for WIC images)
# =============================================================
# Default partition sizes work for images < 1GB
# For larger images (Qt, multimedia), increase these values

# Boot partition size (kernel, DTB, overlays)
# SOC_WKS_BOOT_SIZE = "100M"

# Root filesystem size (both A and B partitions)
# Default: 1G, increase for Qt/multimedia images
# SOC_WKS_ROOTFS_SIZE = "1G"

# For 5GB+ Qt images, use:
# SOC_WKS_ROOTFS_SIZE = "6G"
# SOC_WKS_DATA_SIZE = "2G"
# WKS_FILE = "soc-monitoring-large.wks"

# Persistent data partition size
# SOC_WKS_DATA_SIZE = "500M"

# Storage requirements:
#   Default (1G rootfs): 4GB minimum (boot + 2×1G + data + overhead)
#   Large (6G rootfs): 16GB minimum (boot + 2×6G + data + overhead)

# =============================================================
# SPDX / License Compliance Configuration
# =============================================================
# IMPORTANT: If using NXP i.MX (fsl-imx-*), Poky, or any distro that enables
# SPDX globally, you MUST disable SPDX to avoid build errors:
#
INHERIT:remove = "create-spdx"
#
# This is required because soc-ota-agent uses externalsrc (local Go code),
# which is incompatible with SPDX generation. Without this line, you'll see:
#   ERROR: No SPDX file found for package soc-ota-agent

# =============================================================
# Integration with Existing BSP
# =============================================================
# If integrating into an existing Yocto build (NXP i.MX, TI, etc.):
#
# 1. Add meta-otapulse to your bblayers.conf
# 2. Set OTA_SERVER_URL above
# 3. Add to your image: IMAGE_INSTALL:append = " soc-ota-agent"
# 4. For production, set SOC_OTA_VERIFICATION_KEYS to your public key path
