# /etc/sudoers.d/10-soc-support
# Managed by OTA — do not edit; changes are overwritten on update.
#
# This file is installed by the soc-shell-access OTA package.
# It is root-owned (mode 0440) and replaced on every OTA update,
# so operator edits do not persist.  The support user has no write
# access (non-root, not in wheel/sudo groups) and cannot elevate
# beyond this curated allowlist.
#
# Scope: Standard shell tier — read-only diagnostics + a controlled
#        set of service restarts for approved daemons only.

# ---------------------------------------------------------------------------
# Command aliases — one alias per capability group, all absolute paths.
# ---------------------------------------------------------------------------

# Read system journal (read-only, no editing, no --root/-M manipulations)
Cmnd_Alias SOC_JOURNALCTL = \
    /usr/bin/journalctl, \
    /bin/journalctl

# Kernel message ring buffer (read-only)
Cmnd_Alias SOC_DMESG = \
    /usr/bin/dmesg, \
    /bin/dmesg

# Network address inspection (read-only; 'ip addr' only — NOT ip link set, ip route add, etc.)
Cmnd_Alias SOC_IP_ADDR = \
    /sbin/ip addr, \
    /usr/sbin/ip addr, \
    /bin/ip addr, \
    /usr/bin/ip addr

# NOTE: there is intentionally NO 'cat /var/log/*' entry here.  In sudoers,
# a '*' in a command ARGUMENT is matched by fnmatch() WITHOUT FNM_PATHNAME,
# so '*' matches '/' and '..'.  An entry like '/bin/cat /var/log/*' would
# therefore allow 'sudo cat /var/log/../../etc/shadow' to read ANY root-owned
# file.  Log reading is instead done through the validated wrapper
# /usr/libexec/soc-diag/soc-readlog (covered by the SOC_DIAG alias below),
# which rejects path traversal and confines reads to /var/log/.

# Vendor diagnostic scripts (drop-in directory; scripts are root-owned 0755).
# This also covers the soc-readlog log-reader wrapper shipped by this package.
Cmnd_Alias SOC_DIAG = \
    /usr/libexec/soc-diag/*

# systemctl status — read-only, any unit. 'status' is read-only by design
# (it queries unit state and never modifies it), so the '*' wildcard here is
# safe: no traversal/escalation is possible through a read-only subcommand.
Cmnd_Alias SOC_SYSTEMCTL_STATUS = \
    /usr/bin/systemctl status *, \
    /bin/systemctl status *

# systemctl restart — RESTRICTED to the approved daemon list only.
# Do NOT add a wildcard here; each approved service is listed explicitly.
# Approved: OTA agent, tunnel daemon, networking, NTP.
Cmnd_Alias SOC_SYSTEMCTL_RESTART = \
    /usr/bin/systemctl restart soc-ota-agent.service, \
    /usr/bin/systemctl restart soc-ota-tunneld.service, \
    /usr/bin/systemctl restart NetworkManager.service, \
    /usr/bin/systemctl restart systemd-networkd.service, \
    /usr/bin/systemctl restart systemd-resolved.service, \
    /usr/bin/systemctl restart chronyd.service, \
    /bin/systemctl restart soc-ota-agent.service, \
    /bin/systemctl restart soc-ota-tunneld.service, \
    /bin/systemctl restart NetworkManager.service, \
    /bin/systemctl restart systemd-networkd.service, \
    /bin/systemctl restart systemd-resolved.service, \
    /bin/systemctl restart chronyd.service

# ---------------------------------------------------------------------------
# Grant: support user may run the above aliases as root, no password required.
# No other sudo commands are permitted (implicit NOPASSWD: ALL denial).
#
# BUG-308: SOC_JOURNALCTL/SOC_DMESG/SOC_SYSTEMCTL_STATUS are granted on a
# SEPARATE, NOEXEC: line. Without NOEXEC, journalctl/dmesg/'systemctl status'
# invoke the system default pager (less) AS ROOT whenever output doesn't fit
# one screen, and less's own '!<command>'/'v' shell-escapes then spawn a root
# shell — a real support-tier privilege escalation to root. NOEXEC blocks the
# pager (or anything else) from being exec'd by the sudo'd process, closing
# that path. This mirrors soc-shell-access-privileged's soc-elevated.sudoers,
# which grants its own SOC_ELEV_SYSTEMCTL/SOC_ELEV_JOURNAL the same way.
#
# SOC_IP_ADDR/SOC_DIAG/SOC_SYSTEMCTL_RESTART stay on the original, non-NOEXEC
# grant below: NOEXEC would break SOC_DIAG's soc-readlog wrapper, which
# legitimately execs 'cat' internally (exactly why soc-elevated.sudoers keeps
# its own SOC_ELEV_DIAG grant on a separate, non-NOEXEC line too) — and
# 'ip addr' / the enumerated systemctl-restart verbs don't invoke a pager and
# are outside this bug's threat model, so they are left untouched.
# ---------------------------------------------------------------------------
support ALL=(root) NOEXEC: NOPASSWD: \
    SOC_JOURNALCTL, \
    SOC_DMESG, \
    SOC_SYSTEMCTL_STATUS
support ALL=(root) NOPASSWD: \
    SOC_IP_ADDR, \
    SOC_DIAG, \
    SOC_SYSTEMCTL_RESTART
