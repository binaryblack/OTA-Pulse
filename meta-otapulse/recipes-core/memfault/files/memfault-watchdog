#!/bin/sh
# Memfault Watchdog Monitor
# Monitors application health and triggers reboot on failure

CONFIG_FILE="/etc/memfault/config.json"
WATCHDOG_DEVICE="/dev/watchdog"
REBOOT_REASON_FILE="/var/lib/memfault/last_reboot_reason"
LOG_FILE="/var/log/memfault/watchdog.log"

# Parse config
TIMEOUT=30
PET_INTERVAL=10

if [ -f "${CONFIG_FILE}" ]; then
    TIMEOUT=$(jq -r '.watchdog.timeout_seconds // 30' "${CONFIG_FILE}" 2>/dev/null || echo "30")
    PET_INTERVAL=$(jq -r '.watchdog.pet_interval_seconds // 10' "${CONFIG_FILE}" 2>/dev/null || echo "10")
fi

mkdir -p "$(dirname "${LOG_FILE}")" 2>/dev/null
mkdir -p "$(dirname "${REBOOT_REASON_FILE}")" 2>/dev/null

log() {
    echo "$(date -Iseconds) [watchdog] $*"
    echo "$(date -Iseconds) $*" >> "${LOG_FILE}" 2>/dev/null
}

# Check if hardware watchdog is available
USE_HW_WATCHDOG=0
if [ -c "${WATCHDOG_DEVICE}" ]; then
    USE_HW_WATCHDOG=1
    log "Hardware watchdog enabled (timeout=${TIMEOUT}s)"
else
    log "Hardware watchdog not available, using software monitoring only"
fi

pet_watchdog() {
    if [ "${USE_HW_WATCHDOG}" = "1" ]; then
        echo "1" > "${WATCHDOG_DEVICE}" 2>/dev/null || true
    fi
}

check_memfaultd() {
    # Check if memfaultd process is running
    pgrep -x memfaultd >/dev/null 2>&1
    return $?
}

check_system_health() {
    # Check available memory (fail if less than 5%)
    local mem_available_percent
    mem_available_percent=$(awk '/MemTotal/{total=$2} /MemAvailable/{available=$2} END {printf "%d", available*100/total}' /proc/meminfo 2>/dev/null || echo "100")
    if [ "${mem_available_percent}" -lt 5 ]; then
        log "CRITICAL: Available memory below 5% (${mem_available_percent}%)"
        return 1
    fi

    # Check available disk space (fail if less than 5%)
    local disk_available_percent
    disk_available_percent=$(df / 2>/dev/null | awk 'NR==2 {print 100-$5}' | tr -d '%' || echo "100")
    if [ "${disk_available_percent}" -lt 5 ]; then
        log "CRITICAL: Available disk space below 5% (${disk_available_percent}%)"
        return 1
    fi

    return 0
}

trigger_reboot() {
    local reason="${1:-unknown}"
    log "Triggering reboot due to: ${reason}"

    # Store reboot reason
    echo "${reason}" > "${REBOOT_REASON_FILE}" 2>/dev/null

    # Sync filesystems
    sync

    # Fallback to manual reboot
    sleep 2
    reboot -f
}

cleanup() {
    log "Shutting down watchdog monitor"
    # Disable watchdog gracefully by writing magic close character
    if [ "${USE_HW_WATCHDOG}" = "1" ]; then
        echo "V" > "${WATCHDOG_DEVICE}" 2>/dev/null || true
    fi
    exit 0
}

trap cleanup TERM INT

# Main monitoring loop
main() {
    log "Starting watchdog monitor (timeout=${TIMEOUT}s, pet_interval=${PET_INTERVAL}s)"

    consecutive_failures=0
    max_failures=3

    while true; do
        # Pet the hardware watchdog
        pet_watchdog

        # Check memfaultd health
        if ! check_memfaultd; then
            consecutive_failures=$((consecutive_failures + 1))
            log "memfaultd check failed (${consecutive_failures}/${max_failures})"

            if [ ${consecutive_failures} -ge ${max_failures} ]; then
                # Try to restart memfaultd first
                log "Attempting to restart memfaultd"
                # Use init script if available, otherwise try to start directly
                if [ -x /etc/init.d/memfaultd ]; then
                    /etc/init.d/memfaultd restart 2>/dev/null || true
                else
                    # Kill and restart
                    pkill -x memfaultd 2>/dev/null || true
                    sleep 1
                    /usr/bin/memfaultd &
                fi
                sleep 5

                if ! check_memfaultd; then
                    trigger_reboot "memfaultd_failure"
                fi
            fi
        else
            consecutive_failures=0
        fi

        # Check system health
        if ! check_system_health; then
            trigger_reboot "system_health_failure"
        fi

        sleep "${PET_INTERVAL}"
    done
}

case "${1:-}" in
    --help)
        echo "Usage: memfault-watchdog [--help]"
        echo "Monitors system and application health, triggers reboot on failure"
        exit 0
        ;;
    --config)
        CONFIG_FILE="${2}"
        shift 2
        ;;
esac

main
