[Unit]
Description=SoC Monitoring Local Dashboard
Documentation=https://github.com/example/soc-monitoring
After=network.target memfaultd.service

[Service]
Type=simple
ExecStart=/usr/bin/soc-dashboard --port 8080
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=soc-dashboard

[Install]
WantedBy=multi-user.target
