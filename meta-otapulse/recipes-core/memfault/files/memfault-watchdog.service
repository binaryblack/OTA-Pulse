[Unit]
Description=SoC Monitoring System Watchdog
Documentation=https://github.com/example/soc-monitoring
After=memfaultd.service
Wants=memfaultd.service

[Service]
Type=simple
ExecStart=/usr/bin/memfault-watchdog --config /etc/memfault/config.json
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=memfault-watchdog

[Install]
WantedBy=multi-user.target
