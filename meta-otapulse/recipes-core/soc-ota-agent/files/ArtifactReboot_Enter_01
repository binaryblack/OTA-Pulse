#!/bin/sh
# OTAPulse State Script: ArtifactReboot_Enter
#
# TWO-COPY FILE — keep ALL sections (1/2/3/4) identical in both locations:
#   (1) otapulse_testagent/framework/state_scripts/ArtifactReboot_Enter_01  [test-repo / artifact re-bake]
#   (2) multiboard_yocto/sources/OTA-Pulse/meta-otapulse/recipes-core/soc-ota-agent/files/ArtifactReboot_Enter_01  [Yocto image build]
# Section 1 (RPi4 VideoCore boot) was previously diverged (test-repo kept the dead
# tryboot one-shot); it is now ALIGNED and IS checked by the sync hook — leaving it
# diverged broke E2E-001 p3->p2 because the test embeds THIS copy into its
# on-the-fly artifact (BUG-074).
# After editing either copy run:  scripts/check-state-script-sync.sh
# The pre-commit hook enforces this automatically.
#
# LOGGING (BUG-252 discovery): the agent collects state-script output from
# STDERR ONLY — soc-ota-agent/statescript/executor.go pipes just stderr into
# the deployment log/journal; stdout is never captured and goes to /dev/null.
# Every diagnostic echo in this script therefore MUST end with >&2 or it is
# silently lost.
#
# Runs (from the incoming artifact) right after an OTA install, just before the
# reboot. Responsibilities, checked in order:
#
# 1. RPi4 direct-boot (VideoCore) A/B slot switch (BUG-245): build a TRY
#    configuration that the AGENT's own post-install reboot (`reboot "0 tryboot"`,
#    BUG-353) boots via the firmware's tryboot one-shot, WITHOUT touching the
#    permanent config.txt/cmdline.txt. See the section-1 comment block below for
#    the full history and rationale. The switch is made permanent later, by
#    ArtifactCommit_Enter_01, only after the new slot has booted and the agent
#    has confirmed it healthy.
#
# 2. FAT boot-env sync (iMX8MP and any boot.scr board): copy
#    /data/ota/mender_boot_part to the FAT boot partition so U-Boot's boot.scr
#    can read the target slot on the next boot.
#
# 3. extlinux.conf slot switch (Rockchip RK3588 U-Boot distroboot).
#
# 4. systemd-boot / EFI ABA slot switch (Dragon Q6A) — see BUG-245/BUG-097 note
#    in that section: the OLD slot's entry is kept bootable as the fallback.

BOOT_PART_FILE="/data/ota/mender_boot_part"

# Locate the FAT "boot" partition by filesystem label (works regardless of /boot
# being mounted; the firmware reads the same partition for the tryboot one-shot).
find_fat_boot() {
    for dev in /dev/disk/by-partlabel/boot /dev/mmcblk*p1 /dev/nvme*n1p1 /dev/sd?1; do
        [ -b "$dev" ] || continue
        FSTYPE=$(blkid -s TYPE -o value "$dev" 2>/dev/null)
        LABEL=$(blkid -s LABEL -o value "$dev" 2>/dev/null)
        if [ "$FSTYPE" = "vfat" ] && [ "$LABEL" = "boot" ]; then
            echo "$dev"; return 0
        fi
    done
    return 1
}

FAT_DEV=$(find_fat_boot)
if [ -z "$FAT_DEV" ]; then
    echo "ArtifactReboot_Enter: No FAT boot partition found, nothing to do" >&2
    exit 0
fi

MNT="/tmp/.otapulse_fat_$$"
mkdir -p "$MNT"
if ! mount "$FAT_DEV" "$MNT" 2>/dev/null; then
    echo "ArtifactReboot_Enter: WARNING: Failed to mount $FAT_DEV — NO boot-slot switch of any kind can run this deployment; the device will keep booting the current slot (BUG-252)" >&2
    rmdir "$MNT" 2>/dev/null || true
    exit 0
fi

cleanup() { umount "$MNT" 2>/dev/null || true; rmdir "$MNT" 2>/dev/null || true; }

# ── 1. RPi4 direct-boot (VideoCore) tryboot one-shot, commit-after-verified-boot
# ─────────────────────────────────────────────────────────────────────────────
# VideoCore direct-boot platform = config.txt + cmdline.txt on the FAT boot part.
#
# HISTORY: this section used to PERMANENTLY rewrite cmdline.txt's root= at
# install time (BUG-074 — an earlier tryboot attempt never actually engaged the
# firmware one-shot on this image, so permanent-rewrite was adopted as the only
# switch that reliably took). BUG-245: that scheme has no failure path — a
# validly-signed but unbootable image bricks the board, because the switch is
# committed before the new rootfs has ever booted, with no way back to the old
# slot short of physically editing the SD card.
#
# NEW SCHEME (BUG-245): build a TRY configuration (tryboot.txt + cmdline_tryboot.txt)
# that the VideoCore firmware boots via ITS OWN tryboot one-shot, entirely
# without touching the permanent config.txt/cmdline.txt:
#   - tryboot.txt        a copy of config.txt with `cmdline=cmdline_tryboot.txt`
#                        (replacing any existing cmdline= line rather than
#                        duplicating it).
#   - cmdline_tryboot.txt the current cmdline.txt content with root= pointed at
#                        the new slot, `rootwait` replaced by `rootdelay=20`,
#                        ` panic=15` appended if no panic= is already present,
#                        and an explicit `init=/sbin/init` pinned if no init=
#                        is already present. rootwait waits forever for the
#                        root device — it would hang the TRY boot instead of
#                        letting it fail and reset; panic=15 turns a kernel
#                        panic into a reset, which is what clears the
#                        firmware's one-shot flag and falls back to
#                        config.txt/cmdline.txt (the OLD slot).
#
#                        BUG-348 (live-reproduced): WITHOUT an explicit init=,
#                        a broken new-slot image whose real init binary is
#                        missing/corrupt does NOT panic — the kernel's
#                        built-in fallback chain (/sbin/init -> /etc/init ->
#                        /bin/init -> /bin/sh) silently execs /bin/sh as PID 1
#                        instead, since that candidate still exists on a
#                        normal rootfs even when the real init is broken. No
#                        panic means panic=15 never fires, no reset ever
#                        happens, and the board hangs in that shell forever —
#                        the tryboot recovery mechanism depends entirely on a
#                        panic to trigger the reset that clears the one-shot
#                        flag, so a failure mode that boots to a shell instead
#                        of panicking defeats it completely. Pinning the
#                        REAL init path explicitly removes the fallback chain
#                        the kernel would otherwise walk: an unusable pinned
#                        init now panics immediately ("Requested init ...
#                        failed") instead of trying /bin/sh next, converting
#                        this failure mode into the same bounded,
#                        panic-then-reset-then-fallback recovery every other
#                        boot failure already gets.
#
#                        These TRY-only edits never reach the PERMANENT
#                        cmdline.txt — ArtifactCommit_Enter_01 writes that from
#                        the ORIGINAL argument list, unmodified.
#
# One-shot semantics this relies on: the firmware clears the tryboot flag on
# ANY reset (panic, watchdog, power cycle). A failed try therefore boots
# config.txt/cmdline.txt = the OLD slot on the very next boot; the agent there
# finds an uncommitted update and rolls back — the deployment reports failed,
# the device keeps running. A try that reaches a healthy, agent-confirmed boot
# is made permanent by ArtifactCommit_Enter_01 (see that script), which is the
# ONLY thing that ever writes to the permanent cmdline.txt again.
#
# NOTE for otapulse-tryboot-watchdog/otapulse-tryboot-commit (meta-custom
# otapulse-rpi4-tryboot recipe, installed on raspberrypi4-64 only): their
# "Role 1" (promote cmdline_tryboot.txt -> cmdline.txt as soon as tryboot.txt
# is seen at basic.target) has been DISABLED as part of BUG-245 — it fired long
# before any health check and would have permanently committed the TRY-only
# cmdline arguments (rootdelay=20/panic=15/init=) instead of leaving the commit
# to ArtifactCommit_Enter_01. Their "Role 2" (boot-count watchdog keyed on
# cmdline_prev.txt) only ever sees a cmdline_prev.txt written by
# ArtifactCommit_Enter_01 at commit time (cleared right after by the agent's
# CommitUpdate) — this script no longer has any permanent-rewrite fallback for
# it to guard (BUG-353, see the end of this section).
#
# WHO DOES WHAT on this board class (BUG-353 contract — all of these must agree,
# and each one is gated on the same VideoCore signature, config.txt + cmdline.txt
# side by side on the FAT boot partition):
#   - agent file_bootenv.go (applyDirectBootSlot): never touches the permanent
#                                  cmdline.txt on this board class
#   - switch-boot-slot.sh Method 8 : defers (BUG-348 gate, returns 0)
#   - THIS script                  : builds tryboot.txt + cmdline_tryboot.txt
#   - agent Reboot()               : `reboot "0 tryboot"` iff tryboot.txt armed
#   - ArtifactCommit_Enter_01      : the ONLY writer of the permanent cmdline.txt
if [ -f "$MNT/config.txt" ] && [ -f "$MNT/cmdline.txt" ] && [ -f "$BOOT_PART_FILE" ]; then
    TARGET_PART=$(tr -dc '0-9' < "$BOOT_PART_FILE")
    if [ -n "$TARGET_PART" ] && grep -q 'root=' "$MNT/cmdline.txt"; then
        # Target rootfs device shares the FAT's disk. find_fat_boot may have
        # returned a /dev/disk/by-* SYMLINK (e.g. .../by-partlabel/boot), so resolve
        # it to the real node first (/dev/mmcblk0p1), strip the trailing partition
        # number, and append the target partition number -> /dev/mmcblk0p<N>. This
        # matches the existing cmdline.txt root= format (root=/dev/mmcblk0pN).
        FAT_REAL=$(readlink -f "$FAT_DEV" 2>/dev/null || echo "$FAT_DEV")
        DISK_PREFIX=$(printf '%s' "$FAT_REAL" | sed -E 's/[0-9]+$//')
        TARGET_DEV="${DISK_PREFIX}${TARGET_PART}"

        # Build tryboot.txt from config.txt, pointing its cmdline= at the TRY file.
        if grep -q '^cmdline=' "$MNT/config.txt" 2>/dev/null; then
            sed -E 's/^cmdline=.*/cmdline=cmdline_tryboot.txt/' "$MNT/config.txt" > "$MNT/tryboot.txt.new"
        else
            cp -f "$MNT/config.txt" "$MNT/tryboot.txt.new"
            printf 'cmdline=cmdline_tryboot.txt\n' >> "$MNT/tryboot.txt.new"
        fi
        mv -f "$MNT/tryboot.txt.new" "$MNT/tryboot.txt"

        # Build cmdline_tryboot.txt: TRY-only argument list (see comment block above).
        CUR=$(cat "$MNT/cmdline.txt")
        NEW=$(printf '%s' "$CUR" | sed -E "s#root=[^ ]+#root=${TARGET_DEV}#")
        NEW=$(printf '%s' "$NEW" | sed -E 's/(^| )rootwait( |$)/\1rootdelay=20\2/')
        case " $NEW " in
            *' panic='*) : ;;
            *) NEW="$NEW panic=15" ;;
        esac
        # BUG-348: pin the real init path explicitly so a broken/missing
        # init panics the kernel instead of silently falling through to
        # /bin/sh (see the block comment above this section for the full
        # rationale). Only added if this cmdline doesn't already pin one.
        case " $NEW " in
            *' init='*) : ;;
            *) NEW="$NEW init=/sbin/init" ;;
        esac
        printf '%s\n' "$NEW" > "$MNT/cmdline_tryboot.txt"
        sync

        echo "ArtifactReboot_Enter: built tryboot.txt/cmdline_tryboot.txt for root=${TARGET_DEV} on ${FAT_DEV} (permanent cmdline.txt left untouched; see ArtifactCommit_Enter_01)" >&2
        cleanup

        # BUG-353: the reboot itself is NOT issued from here. The agent issues
        # it right after this script returns (dual_rootfs_device.go Reboot()),
        # as `reboot "0 tryboot"` whenever tryboot.txt is armed — that reboot(2)
        # RESTART2 string is what the VideoCore firmware keys its one-shot on
        # (downstream kernel rpi_firmware_notify_reboot matches " tryboot").
        # Proven live on a real RPi4 (2026-08-22): device-tree
        # chosen/bootloader/tryboot=1 and the TRY cmdline in /proc/cmdline,
        # permanent cmdline.txt/config.txt byte-identical before and after.
        #
        # History — why this script must NOT try to reboot by itself: an
        # earlier version backgrounded a deferred "systemctl reboot
        # --reboot-argument -> raw reboot(2) syscall -> LAST-RESORT permanent
        # cmdline.txt rewrite" chain from here. That could never work: (1) the
        # agent issues its own plain `reboot` about one second after this
        # script exits, and on systemd a BARE `reboot` UNLINKS
        # /run/systemd/reboot-param (update_reboot_parameter_and_warn(NULL)),
        # so any argument set earlier is discarded — and the deferred chain is
        # killed with the agent's cgroup during the very shutdown it raced;
        # (2) its LAST-RESORT branch permanently rewrote cmdline.txt to the new
        # slot BEFORE that slot had ever booted — exactly the commit-before-
        # verify brick path this whole section exists to eliminate. Both are
        # gone. If the agent running this artifact predates BUG-353 it reboots
        # plainly: the firmware then boots the untouched permanent cmdline.txt
        # (the OLD slot), ArtifactCommit_Enter_01 refuses the wrong-slot commit,
        # and the deployment fails CLEANLY with the board alive — fail-safe,
        # never a permanent switch without a net.
        echo "ArtifactReboot_Enter: tryboot armed — the agent's own reboot carries the \"0 tryboot\" argument (BUG-353); no reboot is issued from this script" >&2
        exit 0
    fi
fi

# ── 2. FAT boot-env sync (boot.scr platforms: iMX8, BeaglePlay, Rockchip) ───
if [ -f "$BOOT_PART_FILE" ] && [ -f "$MNT/boot.scr" ]; then
    TARGET_PART=$(cat "$BOOT_PART_FILE")
    printf '%s' "$TARGET_PART" > "$MNT/mender_boot_part"

    # Marker-file slot scheme: some boot.scr variants ignore the numeric
    # mender_boot_part entirely and instead select Slot B *iff* the marker file
    # 'mender_boot_slot_b' is PRESENT on this FAT (absent => Slot A). This scheme
    # is used by vendor U-Boots that lack setexpr.b (Rockchip RK3588 2017.09 — see
    # README-rockchip-rk3588.md). Writing only the numeric mender_boot_part there
    # leaves the marker untouched, so the boot.scr always falls through to Slot A
    # and the A/B switch never takes. Detect the scheme directly from the boot.scr
    # (it embeds the literal string) so this is correct on marker boards and a
    # NO-OP on numeric-scheme boards; derive the target slot from the rootfs_b
    # PARTLABEL so there are no hardcoded partition numbers.
    if grep -q mender_boot_slot_b "$MNT/boot.scr" 2>/dev/null; then
        PART_B=""
        if [ -e /dev/disk/by-partlabel/rootfs_b ]; then
            PART_B=$(readlink -f /dev/disk/by-partlabel/rootfs_b | grep -oE '[0-9]+$')
        fi
        if [ -n "$PART_B" ] && [ "$TARGET_PART" = "$PART_B" ]; then
            printf 'b' > "$MNT/mender_boot_slot_b"
            rm -f "$MNT/mender_boot_slot_a"
            echo "ArtifactReboot_Enter: marker scheme -> Slot B (mender_boot_slot_b created)" >&2
        else
            rm -f "$MNT/mender_boot_slot_b"
            printf 'a' > "$MNT/mender_boot_slot_a"
            echo "ArtifactReboot_Enter: marker scheme -> Slot A (mender_boot_slot_b removed)" >&2
        fi
    fi
    sync
    echo "ArtifactReboot_Enter: Updated $FAT_DEV mender_boot_part=$TARGET_PART" >&2
else
    echo "ArtifactReboot_Enter: not an RPi tryboot platform and no boot.scr — nothing to sync" >&2
fi

# ── 3. extlinux.conf slot switch ─────────────────────────────────────────────
# Some boards (e.g. Rockchip RK3588 via U-Boot distroboot) boot via extlinux
# even when boot.scr is present — distroboot picks up extlinux/extlinux.conf
# FIRST and never executes boot.scr. In that case the static root=PARTLABEL=...
# in the extlinux.conf 'append' line determines the boot slot; neither the
# numeric mender_boot_part NOR the mender_boot_slot_b marker is consulted.
# Detect by presence of extlinux/extlinux.conf and update root=PARTLABEL= there.
if [ -f "$BOOT_PART_FILE" ] && [ -f "$MNT/extlinux/extlinux.conf" ]; then
    TARGET_PART=$(cat "$BOOT_PART_FILE")
    PART_B=""
    if [ -e /dev/disk/by-partlabel/rootfs_b ]; then
        PART_B=$(readlink -f /dev/disk/by-partlabel/rootfs_b | grep -oE '[0-9]+$')
    fi
    if [ -n "$PART_B" ] && [ "$TARGET_PART" = "$PART_B" ]; then
        TARGET_LABEL="rootfs_b"
    else
        TARGET_LABEL="rootfs_a"
    fi
    sed -i "s/root=PARTLABEL=rootfs_[ab]/root=PARTLABEL=${TARGET_LABEL}/g" \
        "$MNT/extlinux/extlinux.conf"
    sync
    echo "ArtifactReboot_Enter: extlinux.conf -> root=PARTLABEL=${TARGET_LABEL}" >&2
fi

# ── 4. systemd-boot / EFI ABA (loader/entries) slot switch ───────────────────
# UEFI + systemd-boot Automatic Boot Assessment: loader/entries/ holds
# slot-a+N.conf and/or slot-b+N.conf. The +N suffix is the remaining boot-count;
# systemd-boot selects the entry with the highest positive count. otapulse-boot-
# confirm resets the winning entry back to +3 on every successful boot.
#
# BUG-245/BUG-097: this section used to EXHAUST the current (old) slot's entry
# (rename it to +0) before pointing `default` at the target. That leaves BOTH
# entries bad if the target's 3 tries all fail — systemd-boot has no good entry
# left to fall back to, and the board bricks (the documented RB-004/BP-001 brick
# history). The old slot is, by definition, the one currently running and known
# bootable; it MUST remain the fallback. So: create/restore the target entry at
# +3 and repoint `default` at it (that alone selects the new slot among GOOD
# entries), but leave the current entry's try-count exactly as found (restoring
# it to +3 only if some earlier version of this script, or an interrupted OTA,
# left it at +0). After 3 failed tries of the target, systemd-boot's Automatic
# Boot Assessment excludes it and falls back to the still-good old entry.
# BUG-252 diagnostics (read-only, logging ONLY — never changes any decision
# below): probe the ACTUALLY-running root partition so a stale/missing
# BOOT_PART_FILE can be called out loudly instead of silently producing a
# no-op "switch" whose log line looks exactly like a successful one. This
# section previously derived CURRENT_SLOT purely as the opposite of the
# TARGET read from BOOT_PART_FILE — it never looked at what is really
# running, so a stale target equal to the running slot logged "success"
# while changing nothing (the BUG-252 silent-no-op shape).
RUNNING_ROOT_DEV=$(awk '$2 == "/" { print $1; exit }' /proc/mounts 2>/dev/null)
if [ "$RUNNING_ROOT_DEV" = "/dev/root" ]; then
    RUNNING_ROOT_DEV=$(readlink -f /dev/root 2>/dev/null || echo /dev/root)
fi
RUNNING_PART=$(printf '%s' "$RUNNING_ROOT_DEV" | grep -oE '[0-9]+$')

if [ -d "$MNT/loader/entries" ] && [ ! -f "$BOOT_PART_FILE" ]; then
    echo "ArtifactReboot_Enter: WARNING (BUG-252): systemd-boot loader/entries present but $BOOT_PART_FILE is MISSING — EFI ABA slot switch CANNOT run; device will keep booting the current slot (running root=$RUNNING_ROOT_DEV)" >&2
fi

if [ -f "$BOOT_PART_FILE" ] && [ -d "$MNT/loader/entries" ]; then
    TARGET_PART=$(cat "$BOOT_PART_FILE")
    if [ -z "$TARGET_PART" ]; then
        echo "ArtifactReboot_Enter: WARNING (BUG-252): $BOOT_PART_FILE exists but is EMPTY — EFI ABA target unknown; the slot mapping below will default to slot A" >&2
    elif [ -n "$RUNNING_PART" ] && [ "$TARGET_PART" = "$RUNNING_PART" ]; then
        echo "ArtifactReboot_Enter: WARNING (BUG-252): EFI ABA target partition p${TARGET_PART} (from $BOOT_PART_FILE) == ACTUALLY-RUNNING root partition (root=$RUNNING_ROOT_DEV) — boot-part file is stale or was never updated for this deployment; the 'switch' below is a NO-OP and the device will boot the SAME slot again" >&2
    fi
    PART_B=""
    if [ -e /dev/disk/by-partlabel/rootfs_b ]; then
        PART_B=$(readlink -f /dev/disk/by-partlabel/rootfs_b | grep -oE '[0-9]+$')
    fi
    if [ -n "$PART_B" ] && [ "$TARGET_PART" = "$PART_B" ]; then
        TARGET_SLOT="b"; CURRENT_SLOT="a"
        TARGET_LABEL="rootfs_b"; CURRENT_LABEL="rootfs_a"
    else
        TARGET_SLOT="a"; CURRENT_SLOT="b"
        TARGET_LABEL="rootfs_a"; CURRENT_LABEL="rootfs_b"
    fi
    ENTRIES="$MNT/loader/entries"
    # sort -r picks slot-a+3.conf before slot-a+0.conf (higher count first)
    CURRENT_CONF=$(find "$ENTRIES" -maxdepth 1 -name "slot-${CURRENT_SLOT}+*.conf" 2>/dev/null \
                   | sort -r | head -1)
    TARGET_CONF=$(find "$ENTRIES" -maxdepth 1 -name "slot-${TARGET_SLOT}+*.conf" 2>/dev/null \
                  | sort -r | head -1)
    if [ -n "$CURRENT_CONF" ]; then
        # Keep the current (old) slot bootable: restore it to +3 if it is
        # sitting at +0 for any reason, otherwise leave its count as found.
        # Never exhaust it here — see the section comment above (BUG-245).
        CURRENT_3="$ENTRIES/slot-${CURRENT_SLOT}+3.conf"
        if [ "$CURRENT_CONF" != "$CURRENT_3" ]; then
            OLD_NAME=$(basename "$CURRENT_CONF")
            mv "$CURRENT_CONF" "$CURRENT_3"
            CURRENT_CONF="$CURRENT_3"
            echo "ArtifactReboot_Enter: restored current slot-${CURRENT_SLOT} entry to +3 (was ${OLD_NAME})"
        fi
        TARGET_3="$ENTRIES/slot-${TARGET_SLOT}+3.conf"
        if [ -n "$TARGET_CONF" ]; then
            # Target entry already exists (e.g. +0 left from an earlier reverse OTA) — restore to +3
            [ "$TARGET_CONF" != "$TARGET_3" ] && mv "$TARGET_CONF" "$TARGET_3"
        else
            # No target entry yet — generate from the current template, swapping root=PARTLABEL=
            sed "s/root=PARTLABEL=${CURRENT_LABEL}/root=PARTLABEL=${TARGET_LABEL}/g" \
                "$CURRENT_CONF" > "$TARGET_3"
        fi
        sync
        # systemd-boot honours loader.conf's `default` pin OVER the ABA try-counts,
        # so the entry rename alone is not enough — repoint default to the target slot.
        if [ -f "$MNT/loader/loader.conf" ]; then
            sed -i "s/^default .*/default slot-${TARGET_SLOT}*/" "$MNT/loader/loader.conf"
            sync
            # BUG-252: the sed above matches nothing if loader.conf has no
            # '^default ' line — a silent no-op that leaves boot selection to
            # the ABA try-counts alone (both entries now sit at +3). Verify
            # the pin actually landed and say so loudly if it did not.
            if ! grep -q "^default slot-${TARGET_SLOT}" "$MNT/loader/loader.conf" 2>/dev/null; then
                echo "ArtifactReboot_Enter: WARNING (BUG-252): loader.conf has no 'default slot-${TARGET_SLOT}*' line after rewrite (no '^default ' line to rewrite?) — default pin NOT set; systemd-boot will pick by ABA try-counts alone and may re-select the OLD slot" >&2
            fi
        else
            echo "ArtifactReboot_Enter: WARNING (BUG-252): no loader/loader.conf on ESP — cannot pin default; systemd-boot will pick by ABA try-counts alone and may re-select the OLD slot" >&2
        fi
        echo "ArtifactReboot_Enter: EFI ABA -> slot-${TARGET_SLOT}+3.conf (root=PARTLABEL=${TARGET_LABEL}, target p${TARGET_PART}; currently running root=$RUNNING_ROOT_DEV), old slot-${CURRENT_SLOT} kept bootable as fallback (BUG-245)" >&2
    else
        echo "ArtifactReboot_Enter: EFI ABA: no slot-${CURRENT_SLOT}+*.conf in loader/entries — skip" >&2
    fi
fi

cleanup
exit 0
