#!/bin/sh
# OTAPulse State Script: ArtifactReboot_Enter
#
# Two responsibilities, checked in order:
#
# 1. RPi4 tryboot: if /boot/tryboot.txt exists AND /boot/cmdline.txt exists
#    (VideoCore direct-boot platform), schedule a tryboot reboot instead of
#    the plain reboot the agent would otherwise issue.  The tryboot mechanism
#    is self-reverting — if the new slot does not run otapulse-tryboot-commit
#    to promote tryboot.txt → cmdline.txt, the next power cycle reverts to the
#    original cmdline.txt automatically (no SD-card-pull required).
#
# 2. FAT boot-env sync (iMX8MP and any boot.scr board): copy
#    /data/ota/mender_boot_part to the FAT boot partition so U-Boot's boot.scr
#    can read the target slot on the next boot.

set -e

# ── 1. RPi4 tryboot ──────────────────────────────────────────────────────────
# Detect: VideoCore direct-boot platform has cmdline.txt on the FAT /boot.
# tryboot.txt is written by the test framework (e2e_ota.py) before triggering
# the OTA, replacing the permanent cmdline.txt modification with a trial boot.
if [ -f "/boot/cmdline.txt" ] && [ -f "/boot/tryboot.txt" ]; then
    echo "ArtifactReboot_Enter: tryboot.txt found — scheduling tryboot reboot"
    # Issue the tryboot reboot after a short delay so the agent can log the
    # state-machine transition before the system goes down.  Exit 0 immediately
    # so the agent proceeds; the nohup reboot fires ~2s later.
    # 'reboot "0 tryboot"' passes the argument to reboot(2)/LINUX_REBOOT_CMD_RESTART2;
    # the RPi VideoCore firmware reads it and uses tryboot.txt for ONE boot only.
    # If the new slot commits (otapulse-tryboot-commit.service runs), tryboot.txt
    # is promoted to cmdline.txt.  Otherwise the next power cycle reverts to the
    # original cmdline.txt (brick-proof).
    nohup sh -c 'sleep 2; reboot "0 tryboot" 2>/dev/null || reboot' >/dev/null 2>&1 &
    exit 0
fi

# ── 2. FAT boot-env sync (boot.scr platforms: iMX8, BeaglePlay) ─────────────
BOOT_PART_FILE="/data/ota/mender_boot_part"

if [ ! -f "$BOOT_PART_FILE" ]; then
    echo "ArtifactReboot_Enter: No $BOOT_PART_FILE, nothing to sync"
    exit 0
fi

TARGET_PART=$(cat "$BOOT_PART_FILE")

# Find the FAT boot partition by label
FAT_DEV=""
for dev in /dev/mmcblk*p1 /dev/sd?1; do
    [ -b "$dev" ] || continue
    FSTYPE=$(blkid -s TYPE -o value "$dev" 2>/dev/null)
    LABEL=$(blkid -s LABEL -o value "$dev" 2>/dev/null)
    if [ "$FSTYPE" = "vfat" ] && [ "$LABEL" = "boot" ]; then
        FAT_DEV="$dev"
        break
    fi
done

if [ -z "$FAT_DEV" ]; then
    echo "ArtifactReboot_Enter: No FAT boot partition found, skipping"
    exit 0
fi

MNT="/tmp/.bootfat_reboot_$$"
mkdir -p "$MNT"

if mount "$FAT_DEV" "$MNT" 2>/dev/null; then
    if [ -f "$MNT/boot.scr" ]; then
        printf '%s' "$TARGET_PART" > "$MNT/mender_boot_part"
        sync
        echo "ArtifactReboot_Enter: Updated $FAT_DEV mender_boot_part=$TARGET_PART"
    else
        echo "ArtifactReboot_Enter: No boot.scr on $FAT_DEV, skipping"
    fi
    umount "$MNT" 2>/dev/null
else
    echo "ArtifactReboot_Enter: Failed to mount $FAT_DEV"
fi

rmdir "$MNT" 2>/dev/null || true
exit 0
