[Unit]
Description=OTAPulse - SoC OTA Agent for Firmware Updates
Documentation=https://github.com/binaryblack/OTA-Pulse
After=network-online.target systemd-resolved.service otapulse-partition-setup.service
Wants=network-online.target
Requires=otapulse-partition-setup.service
Conflicts=mender.service mender-client.service

[Service]
Type=simple
User=root
# Check for config file (new OTAPulse path with fallback to legacy Mender path)
ExecStartPre=/bin/sh -c 'test -f /etc/otapulse/otapulse.conf || test -f /etc/mender/mender.conf'
ExecStart=/usr/bin/soc-ota-agent daemon
Restart=on-failure
RestartSec=30
# Disable watchdog - OTA updates for 6GB images can take 30+ minutes
# The agent has its own timeout handling for network operations
WatchdogSec=0

# systemd's default soft RLIMIT_CORE is 0, and a zero limit makes the kernel
# skip a PIPED core_pattern entirely — socmond-core-handler is never even
# invoked, so a crash of this agent produces no coredump at all. The coredump
# pipeline exists precisely to capture crashes of this process, so it needs a
# non-zero limit here; a shell `ulimit -c` cannot help, since this service
# inherits systemd's limit rather than any shell's.
LimitCORE=infinity

# Hardening.
# BUG-095: ProtectSystem=full|true|strict all remount the FAT /boot partition
# read-only, and ReadWritePaths=/boot / BindPaths=/boot CANNOT carve a SEPARATE
# filesystem mount back to read-write (verified on systemd 255 — the protected
# read-only remount shadows the rw bind). The agent must write the boot-slot file
# (/boot/mender_boot_part) and, on direct-boot boards, cmdline.txt to /boot for the
# A/B slot switch; under ProtectSystem the write got EROFS and silently no-op'd, so
# the device always booted the OLD slot and rolled back. Disable ProtectSystem so
# /boot is writable. The agent already runs as User=root and legitimately needs to
# write the boot/rootfs partitions, so this is not a meaningful additional exposure.
ProtectSystem=false
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=no

# Allow write access to required paths
# Note: Legacy /etc/mender and /var/lib/mender paths removed to prevent
# mount namespacing failures on clean OTAPulse installations.
# Backward compatibility is handled by the agent code's fallback logic.
ReadWritePaths=/var/lib/otapulse
ReadWritePaths=/etc/otapulse
ReadWritePaths=/data
ReadWritePaths=/data/ota
ReadWritePaths=/data/otapulse

# Environment
Environment="PATH=/usr/bin:/bin:/usr/sbin:/sbin"
# Use persistent /data partition for runtime config (API key, device ID)
# This ensures credentials persist across A/B OTA updates
Environment="OTAPULSE_DATASTORE_DIR=/data/otapulse"

[Install]
WantedBy=multi-user.target
