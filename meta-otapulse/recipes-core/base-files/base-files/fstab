# /etc/fstab: static file system information.
#
# SoC Monitoring Platform fstab

/dev/root            /                    auto       defaults              1  1
proc                 /proc                proc       defaults              0  0
devpts               /dev/pts             devpts     mode=0620,ptmxmode=0666,gid=5      0  0
tmpfs                /run                 tmpfs      mode=0755,nodev,nosuid,strictatime 0  0
tmpfs                /var/volatile        tmpfs      defaults              0  0

# Data partition for OTA downloads and persistent storage
# NOTE: /data is mounted by otapulse-partition-setup.service which:
#   - Handles dynamic partition creation on first boot
#   - Auto-detects device (mmcblk0/mmcblk1/etc.) using partlabel
#   - Runs early in boot before other services need /data
# Do NOT add /data here - it would conflict with the partition setup service
