# /etc/fstab: static file system information.
#
# SoC Monitoring Platform fstab

/dev/root            /                    auto       defaults              1  1
proc                 /proc                proc       defaults              0  0
devpts               /dev/pts             devpts     mode=0620,ptmxmode=0666,gid=5      0  0
tmpfs                /run                 tmpfs      mode=0755,nodev,nosuid,strictatime 0  0
tmpfs                /var/volatile        tmpfs      defaults              0  0

# Data partition for OTA downloads and persistent storage
# Uses GPT partition label for auto-detection across all platforms (eMMC, SD, NVMe, virtio).
# nofail: boot continues even if data partition doesn't exist yet (first boot before
#         otapulse-partition-setup creates it on dynamic-partition images).
# x-systemd.device-timeout=10: don't wait too long if partition is missing.
/dev/disk/by-partlabel/data  /data  ext4  defaults,nofail,x-systemd.device-timeout=10  0  2
