#!/bin/bash
# OTAPulse First-Boot Partition Setup
# Creates A/B partitions dynamically on first boot
#
# This script:
# 1. Detects the boot device
# 2. Creates rootfs_b partition (same size as rootfs_a)
# 3. Creates data partition (remaining space, min 1GB)
# 4. Sets GPT partition labels for OTA agent
#
# Benefits:
# - Minimal initial image size (only boot + rootfs_a)
# - Works on any storage size (16GB, 32GB, 64GB, etc.)
# - Platform agnostic - no WKS customization needed

set -e

LOG_TAG="otapulse-setup"
MARKER_FILE="/var/lib/otapulse/.partitions-created"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
    logger -t "$LOG_TAG" "$1"
}

error() {
    log "ERROR: $1"
    exit 1
}

# =============================================================================
# Seed /data/otapulse/device_type so soc-ota-agent can verify HW compatibility
# of incoming OTA artifacts. Without this file, the agent logs "Unable to
# verify the existing hardware. Update will continue anyways" on every poll
# and silently bypasses the device-type match check.
#
# Source priority: /etc/otapulse/device_type (always installed by the
# soc-ota-agent recipe with `device_type=${MACHINE}`) → /etc/mender/device_type
# (legacy mender layout) → /proc/device-tree/model (best-effort kernel name) →
# "unknown".
#
# BUG-237: the static-GPT (Tegra) path used to have its own divergent inline
# copy of this logic (missing the /etc/otapulse/device_type priority) — it
# now calls this same helper, so both paths share one source of truth.
# =============================================================================
seed_device_type() {
    local otapulse_dir="/data/otapulse"
    [ -d "$otapulse_dir" ] || mkdir -p "$otapulse_dir"
    [ -f "$otapulse_dir/device_type" ] && return 0

    local src=""
    for candidate in /etc/otapulse/device_type /etc/mender/device_type; do
        [ -s "$candidate" ] && src="$candidate" && break
    done

    if [ -n "$src" ]; then
        cp "$src" "$otapulse_dir/device_type"
        log "Seeded device_type from $src: $(cat $otapulse_dir/device_type)"
        return 0
    fi

    if [ -r /proc/device-tree/model ]; then
        local dev_type
        dev_type=$(tr -d '\0' < /proc/device-tree/model | tr ' ' '_' | tr '[:upper:]' '[:lower:]')
        if [ -n "$dev_type" ]; then
            echo "device_type=$dev_type" > "$otapulse_dir/device_type"
            log "Seeded device_type from /proc/device-tree/model: $dev_type"
            return 0
        fi
    fi

    echo "device_type=unknown" > "$otapulse_dir/device_type"
    log "WARNING: seeded device_type=unknown (no source available)"
}

# =============================================================================
# CRITICAL: Ensure SSH host keys are persistent (runs on EVERY boot)
# =============================================================================
# Problem: Each rootfs partition generates its own SSH host keys, causing
# "Host key verification failed" errors after OTA slot switch.
#
# Solution: Store SSH host keys in /data (persistent) and symlink from /etc/ssh
# =============================================================================
ensure_persistent_ssh_keys() {
    # ── Universal plain-file host-key scheme (BUG-001) ───────────────────────
    # SSH host keys are pre-generated at build time (by the openssh bbappend)
    # and shipped as plain files in /etc/ssh on every slot.  We deliberately do
    # NOT symlink them into /data on any BSP:
    #
    #   A /data symlink makes sshd depend on /data being mounted.  sshd.service
    #   was ordered After=otapulse-partition-setup.service, and this oneshot has
    #   TimeoutStartSec=900 — so on a board where partition-setup stalls (e.g.
    #   beagleplay's GPT-repair path), sshd is held off for the FULL 900s and
    #   the board is SSH-dead for >15 min after a soft reboot until a hard power
    #   cycle (BUG-001).  Keeping host keys as plain files removes the /data
    #   dependency entirely, so sshd can start immediately from the baked-in
    #   keys regardless of partition-setup timing.
    #
    # Previously only static-GPT (Tegra) BSPs took the plain-file path; that
    # carve-out left dynamic-partition boards (beagleplay et al.) symlinking
    # into /data and exposed to the stall.  This is now applied to ALL BSPs.
    # Test clients use StrictHostKeyChecking=no, so distinct per-slot keys after
    # an OTA slot switch do not break reconnection.
    #
    # If a previous image revision left /data symlinks behind, convert them
    # back to regular files so sshd has no /data dependency.
    local SSH_KEY_TYPES="rsa ecdsa ed25519"
    for key_type in $SSH_KEY_TYPES; do
        local system_key="/etc/ssh/ssh_host_${key_type}_key"
        local system_pub="/etc/ssh/ssh_host_${key_type}_key.pub"

        [ -L "$system_key" ] || continue  # already a regular file — nothing to do

        if [ -f "$system_key" ]; then
            # Valid symlink: copy the target content into a regular file
            cp --remove-destination "$(readlink -f "$system_key")" "$system_key"
            chmod 600 "$system_key"
            log "SSH $key_type key: converted symlink → regular file"
            if [ -L "$system_pub" ] && [ -f "$system_pub" ]; then
                cp --remove-destination "$(readlink -f "$system_pub")" "$system_pub"
                chmod 644 "$system_pub"
            fi
        else
            # Broken symlink: /data not mounted yet.  Try the bind-mount
            # source directory directly (always on the rootfs ext4).
            local fallback="/var/local/otapulse-data/ssh/ssh_host_${key_type}_key"
            if [ -f "$fallback" ]; then
                rm -f "$system_key" "$system_pub"
                cp "$fallback" "$system_key" && chmod 600 "$system_key"
                [ -f "${fallback}.pub" ] && cp "${fallback}.pub" "$system_pub" && chmod 644 "$system_pub"
                log "SSH $key_type key: restored from $fallback (broken symlink)"
            else
                # Last resort: regenerate the key
                rm -f "$system_key" "$system_pub"
                if command -v ssh-keygen >/dev/null 2>&1; then
                    ssh-keygen -q -t "$key_type" -f "$system_key" -N '' 2>/dev/null \
                        && log "SSH $key_type key: regenerated (no backup found)"
                else
                    log "WARNING: cannot restore SSH $key_type key — ssh-keygen not available"
                fi
            fi
        fi
    done
    return 0
}

# =============================================================================
# CRITICAL: Ensure boot scripts are persistent (runs on EVERY boot)
# =============================================================================
# Problem: switch-boot-slot.sh is needed to switch A/B partitions during OTA.
# If the current rootfs doesn't have it, OTA will fail to switch partitions.
#
# Solution: Store boot scripts in /data (persistent) and copy to /usr/sbin if missing
# =============================================================================
ensure_persistent_boot_scripts() {
    PERSISTENT_SCRIPTS_DIR="/data/scripts"
    BOOT_SCRIPT="switch-boot-slot.sh"
    SYSTEM_SCRIPT="/usr/sbin/$BOOT_SCRIPT"
    PERSISTENT_SCRIPT="$PERSISTENT_SCRIPTS_DIR/$BOOT_SCRIPT"

    # Check if /data is mounted
    if ! mountpoint -q /data 2>/dev/null; then
        return 1
    fi

    # Create persistent scripts directory
    mkdir -p "$PERSISTENT_SCRIPTS_DIR"
    chmod 755 "$PERSISTENT_SCRIPTS_DIR"

    # If system has the script but persistent doesn't, save to persistent
    if [ -f "$SYSTEM_SCRIPT" ] && [ ! -L "$SYSTEM_SCRIPT" ] && [ ! -f "$PERSISTENT_SCRIPT" ]; then
        cp "$SYSTEM_SCRIPT" "$PERSISTENT_SCRIPT"
        chmod 755 "$PERSISTENT_SCRIPT"
        log "Saved $BOOT_SCRIPT to persistent storage"
    fi

    # If persistent has the script but system doesn't, restore to system
    if [ -f "$PERSISTENT_SCRIPT" ] && [ ! -f "$SYSTEM_SCRIPT" ]; then
        cp "$PERSISTENT_SCRIPT" "$SYSTEM_SCRIPT"
        chmod 755 "$SYSTEM_SCRIPT"
        log "Restored $BOOT_SCRIPT from persistent storage"
    fi

    return 0
}

# =============================================================================
# Static-GPT BSP support (e.g. NVIDIA Tegra / meta-tegra)
# =============================================================================
# Some BSPs (notably meta-tegra for NVIDIA Jetson) ship a fixed GPT layout
# at flash time and do not allow dynamic partition creation. They also use
# different label conventions (APP / APP_b instead of rootfs_a / rootfs_b).
#
# For these BSPs:
#   1. The udev rule 99-otapulse-bsp-aliases.rules creates the rootfs_a/_b
#      symlinks at boot via udev SYMLINK+= directives.
#   2. We can't create a real data partition — fall back to a persistent
#      directory on the rootfs that we bind-mount to /data.
#   3. Skip the dynamic sgdisk-based partition creation entirely.
#
# This whole code path is gated on detection — non-Tegra BSPs are unaffected.
# =============================================================================

is_static_gpt_bsp() {
    # NVIDIA Tegra detection via device tree
    if [ -r /proc/device-tree/compatible ] && \
       grep -q "nvidia,tegra" /proc/device-tree/compatible 2>/dev/null; then
        return 0
    fi
    return 1
}

setup_data_partition_fallback() {
    # Persistent directory on rootfs, bind-mounted to /data so all the
    # existing code that writes to /data works unchanged.
    #
    # Note: This data is on the *active* rootfs partition, not a separate
    # data partition. After an OTA slot switch, the new rootfs will have a
    # fresh empty /data unless the BSP provides a real data partition.
    # Users wanting persistent data across OTA updates should add a real
    # data partition to their flash layout (e.g. flash.xml.in for Tegra).
    local fallback_dir="/var/local/otapulse-data"

    if mountpoint -q /data 2>/dev/null; then
        return 0
    fi

    log "No data partition found — using rootfs fallback: $fallback_dir"
    mkdir -p "$fallback_dir"
    mkdir -p /data
    if mount --bind "$fallback_dir" /data; then
        log "Bind-mounted $fallback_dir → /data"
        # Remove any conflicting /data entries from fstab before adding the
        # bind-mount.  The base-files template ships a PARTLABEL=data line
        # that will never work on boards without a dedicated data partition
        # (e.g. Tegra / Jetson with UDA label).  Leaving both lines in fstab
        # causes systemd to only process the first (failing) entry, so the
        # bind-mount never activates after reboot.
        #
        # Pattern: delete non-comment lines whose mount-point field is
        # exactly "/data".  The bind-mount is then added as the sole /data
        # entry, making the setting durable across reboots.
        sed -i '/^[^#].* \/data /d' /etc/fstab
        echo "$fallback_dir /data none bind 0 0" >> /etc/fstab
        log "Updated /etc/fstab: removed stale /data entries, added bind mount"
        return 0
    fi
    return 1
}

handle_static_gpt_bsp() {
    log "Static-GPT BSP detected (Tegra) — using BSP partition layout"

    # Wait for udev to apply the alias rules (rootfs_a → APP, rootfs_b → APP_b)
    if command -v udevadm >/dev/null 2>&1; then
        udevadm settle --timeout=30 || true
    fi

    if [ ! -e /dev/disk/by-partlabel/rootfs_a ]; then
        error "rootfs_a alias not present — check that 99-otapulse-bsp-aliases.rules is installed and the BSP uses APP/APP_b labels"
    fi
    log "  rootfs_a → $(readlink -f /dev/disk/by-partlabel/rootfs_a)"

    if [ -e /dev/disk/by-partlabel/rootfs_b ]; then
        log "  rootfs_b → $(readlink -f /dev/disk/by-partlabel/rootfs_b)"
    else
        log "  rootfs_b not present (single-slot layout — set USE_REDUNDANT_FLASH_LAYOUT=1 in meta-tegra for A/B)"
    fi

    # Set up /data — either a real partition or a rootfs-backed fallback
    setup_data_partition_fallback || log "WARNING: /data setup failed"

    # Now that /data is available, ensure persistence files exist.
    # machine-id is handled by the dedicated otapulse-machine-id.service
    # (a symlink can't work because systemd PID 1 reads /etc/machine-id
    # before /data is mounted).
    ensure_persistent_ssh_keys || true
    ensure_persistent_boot_scripts || true

    # Initialize OTA boot environment files
    if mountpoint -q /data 2>/dev/null; then
        local ota_dir="/data/ota"
        mkdir -p "$ota_dir"
        [ -f "$ota_dir/mender_boot_part" ] || echo "$ROOT_PART_NUM" > "$ota_dir/mender_boot_part"
        [ -f "$ota_dir/boot_count" ]       || echo "0" > "$ota_dir/boot_count"
        [ -f "$ota_dir/upgrade_available" ] || echo "0" > "$ota_dir/upgrade_available"
        [ -f "$ota_dir/current_slot" ]     || echo "a" > "$ota_dir/current_slot"
        log "Boot environment initialized in $ota_dir"

        # Seed device_type for OTA agent compatibility checking.
        # The agent checks /data/otapulse/device_type against update artifacts.
        # BUG-237: this used to be a hand-rolled copy of seed_device_type() that
        # only consulted /etc/mender/device_type and /proc/device-tree/model —
        # never /etc/otapulse/device_type, the value the soc-ota-agent recipe
        # actually installs (device_type=${MACHINE}) and the same value baked
        # into every artifact's device_types header at build time. On a board
        # whose /etc/mender/device_type doesn't exist (OTAPulse-only image,
        # never had Mender), that left /proc/device-tree/model (a
        # human-readable marketing string, e.g. "NVIDIA Jetson Xavier NX
        # Developer Kit" -> "nvidia_jetson_xavier_nx_developer_kit") as the
        # only fallback, which never matches ${MACHINE} (e.g.
        # "jetson-xavier-nx-devkit-emmc") and fails every OTA at the
        # artifact-header compatibility check. Call the shared helper so the
        # static-GPT path uses the same MACHINE-authoritative priority order
        # as every other BSP.
        seed_device_type
    fi

    # Mark complete and exit
    mkdir -p "$(dirname $MARKER_FILE)"
    touch "$MARKER_FILE"
    log "Partition setup complete (static-GPT BSP path)"
    exit 0
}

# Always ensure persistent SSH keys
# (machine-id persistence is handled by otapulse-machine-id.service, which
# runs After=otapulse-partition-setup.service.)
ensure_persistent_ssh_keys || log "SSH key persistence skipped (data partition not ready)"

# Always ensure boot scripts are available
ensure_persistent_boot_scripts || log "Boot scripts persistence skipped (data partition not ready)"

# Check if already configured
if [ -f "$MARKER_FILE" ]; then
    log "Partitions already configured, skipping setup"
    exit 0
fi

log "Starting OTAPulse partition setup..."

# =============================================================================
# Wait for storage device to be fully ready
# This prevents issues with GPT not being readable at early boot
# =============================================================================
wait_for_device_ready() {
    local device="$1"
    local max_retries=10
    local retry=0

    log "Waiting for device $device to be ready..."

    # Wait for udev to settle
    if command -v udevadm &> /dev/null; then
        udevadm settle --timeout=30 || true
    fi

    # Check device accessibility via blockdev rather than sgdisk -E.
    # sgdisk -E returns empty/0 whenever the primary GPT header has an invalid
    # CRC (e.g. WIC image flashed to a larger card), so it is not usable as a
    # readiness signal. blockdev --getsz reads device size directly from the
    # kernel and works regardless of GPT state.
    while [ $retry -lt $max_retries ]; do
        local device_sectors
        device_sectors=$(blockdev --getsz "$device" 2>/dev/null)
        device_sectors="${device_sectors:-0}"

        # >100 MB (204800 sectors × 512 B) means the block device is accessible
        if [ "$device_sectors" -gt 204800 ]; then
            log "Device ready: device_sectors=$device_sectors"
            return 0
        fi

        retry=$((retry + 1))
        log "Device not ready yet (device_sectors=$device_sectors), retry $retry/$max_retries..."
        sleep 2
    done

    log "WARNING: Device may not be fully ready, proceeding anyway..."
    return 1
}

# =============================================================================
# Move GPT backup header to the actual end of disk if needed.
#
# WIC images are sized for the rootfs they contain (e.g. ~5 GB). When dd'd to
# a larger SD card / eMMC / NVMe (e.g. 32 GB), the primary GPT still claims
# the disk ends at the WIC's last sector, so sgdisk -E reports a tiny
# last-usable-sector and free-space math goes negative. `sgdisk -e` rewrites
# the backup header at the real end of disk and updates the primary header's
# alternate-LBA + last-usable fields.
#
# This is idempotent on a correctly-sized GPT (sgdisk skips the rewrite when
# the backup is already at the end), so it is safe to run on every first-boot.
# =============================================================================
repair_gpt_if_needed() {
    local device="$1"
    local last_sector device_sectors
    last_sector=$(sgdisk -E "$device" 2>/dev/null | tail -1)
    last_sector="${last_sector:-0}"
    device_sectors=$(blockdev --getsz "$device" 2>/dev/null)
    device_sectors="${device_sectors:-0}"

    # Repair when: device is readable AND (GPT is unreadable OR backup is in first half).
    # last_sector=0 means sgdisk -E returned nothing (corrupted primary GPT, or
    # sgdisk printed warnings but no sector number) — still attempt sgdisk -e.
    if [ "$device_sectors" -gt 0 ] && \
        { [ "$last_sector" -eq 0 ] || [ "$last_sector" -lt $((device_sectors / 2)) ]; }; then
        log "GPT backup at sector $last_sector but device has $device_sectors sectors — moving backup to end of disk"
        if sgdisk -e "$device" 2>&1 | while IFS= read -r line; do log "sgdisk: $line"; done; then
            sync
            partprobe "$device" 2>/dev/null || blockdev --rereadpt "$device" 2>/dev/null || true
            udevadm settle --timeout=10 2>/dev/null || true
            log "GPT repair complete"
            # Rebuild the primary GPT header from the now-correctly-placed backup.
            # sgdisk -e moves the backup to end of disk but leaves the primary
            # header CRC stale, so every subsequent sgdisk call still sees
            # "Invalid partition data!" and exits non-zero. A backup→load cycle
            # writes fresh primary and secondary headers with correct CRCs.
            local _tmpgpt
            _tmpgpt=$(mktemp /tmp/gpt_XXXXXXXX.bin 2>/dev/null || echo /tmp/gpt_repair.bin)
            if sgdisk --backup="$_tmpgpt" "$device" 2>/dev/null && \
               sgdisk --load-backup="$_tmpgpt" "$device" 2>/dev/null; then
                sync
                partprobe "$device" 2>/dev/null || blockdev --rereadpt "$device" 2>/dev/null || true
                udevadm settle --timeout=10 2>/dev/null || true
                log "GPT primary header rebuilt — CRC errors cleared"
            else
                log "WARNING: GPT primary header rebuild failed (sgdisk --backup/--load-backup)"
            fi
            rm -f "$_tmpgpt" 2>/dev/null || true
        else
            log "WARNING: sgdisk -e failed (proceeding anyway, partition setup will likely fail too)"
        fi
    fi
}

# Find the root device
ROOT_PART=$(findmnt -n -o SOURCE /)
if [ -z "$ROOT_PART" ]; then
    error "Cannot find root partition"
fi

log "Root partition: $ROOT_PART"

# Extract base device (e.g., /dev/mmcblk1p2 -> /dev/mmcblk1)
if [[ "$ROOT_PART" =~ ^/dev/mmcblk[0-9]+p[0-9]+$ ]]; then
    BASE_DEV=$(echo "$ROOT_PART" | sed 's/p[0-9]*$//')
    ROOT_PART_NUM=$(echo "$ROOT_PART" | sed 's/.*p//')
elif [[ "$ROOT_PART" =~ ^/dev/sd[a-z][0-9]+$ ]]; then
    BASE_DEV=$(echo "$ROOT_PART" | sed 's/[0-9]*$//')
    ROOT_PART_NUM=$(echo "$ROOT_PART" | sed 's/.*[a-z]//')
elif [[ "$ROOT_PART" =~ ^/dev/vd[a-z][0-9]+$ ]]; then
    # Virtio block devices (QEMU, KVM, cloud instances)
    BASE_DEV=$(echo "$ROOT_PART" | sed 's/[0-9]*$//')
    ROOT_PART_NUM=$(echo "$ROOT_PART" | sed 's/.*[a-z]//')
elif [[ "$ROOT_PART" =~ ^/dev/nvme[0-9]+n[0-9]+p[0-9]+$ ]]; then
    # NVMe devices (e.g., /dev/nvme0n1p2 -> /dev/nvme0n1)
    BASE_DEV=$(echo "$ROOT_PART" | sed 's/p[0-9]*$//')
    ROOT_PART_NUM=$(echo "$ROOT_PART" | sed 's/.*p//')
else
    error "Unsupported device format: $ROOT_PART"
fi

log "Base device: $BASE_DEV"
log "Root partition number: $ROOT_PART_NUM"

# Static-GPT BSP fast path (Tegra etc.) — handle and exit before any sgdisk work.
# Non-Tegra systems fall through to the normal dynamic-partition logic below.
if is_static_gpt_bsp; then
    handle_static_gpt_bsp
fi

# EARLY CHECK: If all required partitions exist with correct labels and are formatted,
# we don't need to do anything. This handles WIC images that pre-create partitions
# and also the OTA-to-partition-B case (marker file only on partition A's rootfs).
# This check uses /dev/disk/by-partlabel symlinks (set up by udev, no sgdisk needed)
# and MUST run BEFORE wait_for_device_ready to avoid sgdisk hangs on some eMMC.
check_all_partitions_ready() {
    local all_ready=1

    # Check rootfs_a (should be the current root)
    if [ ! -e "/dev/disk/by-partlabel/rootfs_a" ]; then
        log "rootfs_a partition label not found"
        all_ready=0
    fi

    # Check rootfs_b (GPT partition label must exist; no fstype required —
    # OTA agent writes the filesystem during install, so it is intentionally
    # unformatted in static WIC images at first boot)
    if [ ! -e "/dev/disk/by-partlabel/rootfs_b" ]; then
        log "rootfs_b partition not found"
        all_ready=0
    fi

    # Check data partition — accept both "data" and "userdata" labels
    # (Rockchip BSPs use "userdata", most others use "data")
    local data_label=""
    if [ -e "/dev/disk/by-partlabel/data" ]; then
        data_label="data"
    elif [ -e "/dev/disk/by-partlabel/userdata" ]; then
        data_label="userdata"
    fi
    if [ -n "$data_label" ]; then
        local fstype=$(lsblk -no FSTYPE "/dev/disk/by-partlabel/$data_label" 2>/dev/null || true)
        if [ -z "$fstype" ]; then
            log "$data_label partition exists but not formatted"
            all_ready=0
        fi
    else
        log "data partition not found (checked 'data' and 'userdata' labels)"
        all_ready=0
    fi

    return $((1 - all_ready))
}

if check_all_partitions_ready; then
    log "All partitions (rootfs_a, rootfs_b, data) already exist and are formatted"
    log "Partition setup not needed - likely a WIC image with pre-created partitions"

    # Mount data partition if not already mounted (check both "data" and "userdata" labels)
    if ! mountpoint -q /data 2>/dev/null; then
        mount_dev=""
        if [ -e "/dev/disk/by-partlabel/data" ]; then
            mount_dev="/dev/disk/by-partlabel/data"
        elif [ -e "/dev/disk/by-partlabel/userdata" ]; then
            mount_dev="/dev/disk/by-partlabel/userdata"
        fi
        if [ -n "$mount_dev" ]; then
            mkdir -p /data
            mount "$mount_dev" /data 2>/dev/null || true
            log "Mounted $mount_dev at /data"
        fi
    fi

    # Initialize boot environment files for A/B partition management
    if [ -d "/data" ] && mountpoint -q /data; then
        OTA_DIR="/data/ota"
        mkdir -p "$OTA_DIR"

        # Initialize boot env files if they don't exist
        if [ ! -f "$OTA_DIR/mender_boot_part" ]; then
            echo "$ROOT_PART_NUM" > "$OTA_DIR/mender_boot_part"
            log "Initialized mender_boot_part=$ROOT_PART_NUM"
        fi
        if [ ! -f "$OTA_DIR/boot_count" ]; then
            echo "0" > "$OTA_DIR/boot_count"
            log "Initialized boot_count=0"
        fi
        if [ ! -f "$OTA_DIR/upgrade_available" ]; then
            echo "0" > "$OTA_DIR/upgrade_available"
            log "Initialized upgrade_available=0"
        fi
        if [ ! -f "$OTA_DIR/current_slot" ]; then
            echo "a" > "$OTA_DIR/current_slot"
            log "Initialized current_slot=a"
        fi
        log "Boot environment initialized"

        # Seed /data/otapulse/device_type for OTA HW-compatibility checks.
        seed_device_type
    fi

    # Create marker file
    mkdir -p "$(dirname $MARKER_FILE)"
    touch "$MARKER_FILE"
    log "Partition setup complete (pre-existing partitions detected)"
    exit 0
fi

# --- Past this point, partitions need to be created. sgdisk is required. ---

# Check if sgdisk is available
if ! command -v sgdisk &> /dev/null; then
    error "sgdisk not found. Install gptfdisk package."
fi

# Repair GPT first if the WIC image was flashed to a larger disk than it
# was sized for. Without this, sgdisk -E returns the WIC's last sector and
# free-space math goes negative.
repair_gpt_if_needed "$BASE_DEV"

# Wait for device to be fully ready before reading GPT.
# Use || true so a "not ready" result (e.g. no free sectors on a fully-allocated
# static WIC image) does not abort the script via set -e.  udevadm settle has
# already run inside wait_for_device_ready, so by-partlabel symlinks are present.
wait_for_device_ready "$BASE_DEV" || true

# Print current partition info (diagnostic only — failure is non-fatal)
log "Current partition layout:"
sgdisk -p "$BASE_DEV" || true

# Check if rootfs_b already exists and is formatted (partial setup)
if [ -e "/dev/disk/by-partlabel/rootfs_b" ]; then
    ROOTFS_B_FSTYPE=$(lsblk -no FSTYPE /dev/disk/by-partlabel/rootfs_b 2>/dev/null || true)
    if [ -n "$ROOTFS_B_FSTYPE" ]; then
        log "rootfs_b partition already exists and formatted ($ROOTFS_B_FSTYPE)"
        # Continue to check/create data partition
    else
        log "rootfs_b partition exists but not formatted, will format it"
    fi
fi

# Get sector size (always works regardless of GPT state)
SECTOR_SIZE=$(blockdev --getss "$BASE_DEV")

# Detect partition-table type so we use the right tool: sgdisk for GPT, sfdisk
# for MBR (DOS). Amlogic/ODROID-C4 boots from an MBR medium because the FIP at
# sector 1 would corrupt a GPT (see odroid-c4.wks). On MBR there are no
# partition names — identification is via filesystem LABELs aliased to
# /dev/disk/by-partlabel by 99-otapulse-bsp-aliases.rules. Crucially, sfdisk
# only rewrites the sector-0 MBR table and never the FIP, so growing the table
# at firstboot is safe. Default to gpt when blkid can't tell (every other board).
PTTYPE=$(blkid -o value -s PTTYPE "$BASE_DEV" 2>/dev/null || true)
[ -z "$PTTYPE" ] && PTTYPE="gpt"
log "Partition table type: $PTTYPE"

# Get rootfs_a size (in sectors). sgdisk -i may return empty when the primary
# GPT header CRC is invalid, so fall back to /sys/class/block which the kernel
# always exports from the in-memory partition table.
ROOTFS_A_SIZE=$(sgdisk -i "$ROOT_PART_NUM" "$BASE_DEV" 2>/dev/null | grep "Partition size" | awk '{print $3}')
ROOTFS_A_SIZE="${ROOTFS_A_SIZE:-0}"
if [ "$ROOTFS_A_SIZE" -eq 0 ]; then
    _dev_name=$(basename "${BASE_DEV}p${ROOT_PART_NUM}" 2>/dev/null || basename "${BASE_DEV}${ROOT_PART_NUM}")
    ROOTFS_A_SIZE=$(cat "/sys/class/block/${_dev_name}/size" 2>/dev/null || echo 0)
    ROOTFS_A_SIZE="${ROOTFS_A_SIZE:-0}"
    [ "$ROOTFS_A_SIZE" -gt 0 ] && log "rootfs_a size read from /sys/class/block: $ROOTFS_A_SIZE sectors"
fi

log "rootfs_a size: $ROOTFS_A_SIZE sectors ($SECTOR_SIZE bytes/sector)"

# Calculate sizes
ROOTFS_A_SIZE_MB=$((ROOTFS_A_SIZE * SECTOR_SIZE / 1024 / 1024))
log "rootfs_a size: ${ROOTFS_A_SIZE_MB}MB"

# Get total device size — prefer blockdev (bypasses GPT entirely).
DEVICE_SIZE_SECTORS=$(blockdev --getsz "$BASE_DEV" 2>/dev/null)
DEVICE_SIZE_SECTORS="${DEVICE_SIZE_SECTORS:-0}"

# Last usable sector: try sgdisk -E first; fall back to device_size - 34
# (GPT reserves 33 LBAs + 1 protective MBR = 34 LBAs at the end of disk).
# sgdisk -E returns empty when the primary GPT header is invalid, which is
# expected on first boot after flashing a WIC image to a larger card.
LAST_SECTOR=$(sgdisk -E "$BASE_DEV" 2>/dev/null | grep -E '^[0-9]+$' | tail -1)
LAST_SECTOR="${LAST_SECTOR:-0}"
if [ "$LAST_SECTOR" -eq 0 ] && [ "$DEVICE_SIZE_SECTORS" -gt 0 ]; then
    LAST_SECTOR=$((DEVICE_SIZE_SECTORS - 34))
    log "sgdisk -E unavailable, calculated last usable sector: $LAST_SECTOR"
fi

log "Device total sectors: $DEVICE_SIZE_SECTORS"
log "Last usable sector: $LAST_SECTOR"

# Find the end of the last partition.
# Try sgdisk -p first; if it returns empty (corrupted primary GPT), fall back
# to reading start+size from /sys/class/block which reflects the kernel's
# in-memory partition table (populated from the valid backup GPT).
LAST_PART_END=$(sgdisk -p "$BASE_DEV" 2>/dev/null | grep '^ *[0-9]' | awk '{print $3}' | sort -n | tail -1)
LAST_PART_END="${LAST_PART_END:-0}"
if [ "$LAST_PART_END" -eq 0 ]; then
    _base=$(basename "$BASE_DEV")
    for _part_dir in /sys/class/block/${_base}/${_base}*/; do
        [ -f "${_part_dir}start" ] && [ -f "${_part_dir}size" ] || continue
        _pstart=$(cat "${_part_dir}start")
        _psize=$(cat "${_part_dir}size")
        _pend=$((_pstart + _psize - 1))
        [ "$_pend" -gt "$LAST_PART_END" ] && LAST_PART_END=$_pend
    done
    [ "$LAST_PART_END" -gt 0 ] && log "sgdisk partition info unavailable, last partition end from /sys: $LAST_PART_END"
fi
FREE_START=$((LAST_PART_END + 1))
FREE_SECTORS=$((LAST_SECTOR - FREE_START))
FREE_SIZE_MB=$((FREE_SECTORS * SECTOR_SIZE / 1024 / 1024))

log "Free space starts at sector: $FREE_START"
log "Free space: ${FREE_SIZE_MB}MB"

# Check if we have enough space for rootfs_b + data
MIN_DATA_SIZE_MB=1024  # Minimum 1GB for data partition
REQUIRED_MB=$((ROOTFS_A_SIZE_MB + MIN_DATA_SIZE_MB))

if [ "$FREE_SIZE_MB" -lt "$REQUIRED_MB" ]; then
    error "Not enough free space. Need ${REQUIRED_MB}MB, have ${FREE_SIZE_MB}MB"
fi

# Calculate partition numbers
ROOTFS_B_PART_NUM=$((ROOT_PART_NUM + 1))
DATA_PART_NUM=$((ROOT_PART_NUM + 2))

# Calculate partition boundaries
ROOTFS_B_START=$FREE_START
ROOTFS_B_END=$((ROOTFS_B_START + ROOTFS_A_SIZE - 1))
DATA_START=$((ROOTFS_B_END + 1))
DATA_END=$LAST_SECTOR

# Check if partitions already exist (from previous interrupted run)
PARTITIONS_EXIST=0
if [ -e "/dev/disk/by-partlabel/rootfs_b" ] && { [ -e "/dev/disk/by-partlabel/data" ] || [ -e "/dev/disk/by-partlabel/userdata" ]; }; then
    log "Partitions already exist, skipping creation"
    PARTITIONS_EXIST=1
fi

if [ "$PARTITIONS_EXIST" -eq 0 ]; then
    log "Creating rootfs_b: partition $ROOTFS_B_PART_NUM, sectors $ROOTFS_B_START-$ROOTFS_B_END"
    log "Creating data: partition $DATA_PART_NUM, sectors $DATA_START-$DATA_END"

    log "Creating rootfs_b and data partitions ($PTTYPE)..."
    if [ "$PTTYPE" = "dos" ]; then
        # MBR: append two Linux (type 83) primary partitions with sfdisk. This
        # only touches the sector-0 partition table — never the FIP at sector 1.
        # Partition names don't exist on MBR; the ext4 LABELs set when formatting
        # below drive /dev/disk/by-partlabel via 99-otapulse-bsp-aliases.rules.
        printf 'start=%s, size=%s, type=83\nstart=%s, type=83\n' \
            "$ROOTFS_B_START" "$ROOTFS_A_SIZE" "$DATA_START" \
            | sfdisk --append --force "$BASE_DEV"
    else
        # GPT: create named, typed partitions with sgdisk (unchanged path).
        sgdisk \
               -n "$ROOTFS_B_PART_NUM:$ROOTFS_B_START:$ROOTFS_B_END" \
               -c "$ROOTFS_B_PART_NUM:rootfs_b" \
               -t "$ROOTFS_B_PART_NUM:8300" \
               -n "$DATA_PART_NUM:$DATA_START:$DATA_END" \
               -c "$DATA_PART_NUM:data" \
               -t "$DATA_PART_NUM:8300" \
               "$BASE_DEV"
    fi

    # Inform kernel of partition changes
    log "Updating kernel partition table..."
    # Use partx (util-linux) as partprobe may not be available
    if command -v partprobe &> /dev/null; then
        partprobe "$BASE_DEV" || true
    else
        # partx -u updates the kernel's partition table
        partx -u "$BASE_DEV" || true
    fi
    sleep 2
fi

# Wait for partition devices to appear
for i in $(seq 1 10); do
    if [ -e "${BASE_DEV}p${ROOTFS_B_PART_NUM}" ] || [ -e "${BASE_DEV}${ROOTFS_B_PART_NUM}" ]; then
        break
    fi
    log "Waiting for partition devices... ($i/10)"
    sleep 1
done

# Determine partition device naming
if [ -e "${BASE_DEV}p${ROOTFS_B_PART_NUM}" ]; then
    ROOTFS_B_DEV="${BASE_DEV}p${ROOTFS_B_PART_NUM}"
    DATA_DEV="${BASE_DEV}p${DATA_PART_NUM}"
else
    ROOTFS_B_DEV="${BASE_DEV}${ROOTFS_B_PART_NUM}"
    DATA_DEV="${BASE_DEV}${DATA_PART_NUM}"
fi

# Format partitions (only if not already formatted)
ROOTFS_B_FSTYPE=$(lsblk -no FSTYPE "$ROOTFS_B_DEV" 2>/dev/null || true)
if [ -z "$ROOTFS_B_FSTYPE" ]; then
    log "Formatting rootfs_b ($ROOTFS_B_DEV)..."
    mkfs.ext4 -F -E nodiscard -L "rootfs_b" "$ROOTFS_B_DEV"
else
    log "rootfs_b already formatted ($ROOTFS_B_FSTYPE), skipping"
fi

DATA_FSTYPE=$(lsblk -no FSTYPE "$DATA_DEV" 2>/dev/null || true)
if [ -z "$DATA_FSTYPE" ]; then
    log "Formatting data ($DATA_DEV)..."
    mkfs.ext4 -F -E nodiscard -L "data" "$DATA_DEV"
else
    log "data already formatted ($DATA_FSTYPE), skipping"
fi

ROOTFS_A_DEV="$ROOT_PART"

# GPT partition-NAME maintenance (rootfs_a / boot). Skipped on MBR, which has no
# partition names — and where running sgdisk -c would convert the disk to GPT
# and corrupt the FIP. On MBR, identification comes from the filesystem LABELs
# (set by the WKS and by mkfs above) via 99-otapulse-bsp-aliases.rules.
if [ "$PTTYPE" != "dos" ]; then
    # Update rootfs_a partition label if needed
    CURRENT_LABEL=$(sgdisk -i "$ROOT_PART_NUM" "$BASE_DEV" 2>/dev/null | grep "Partition name" | cut -d"'" -f2)
    if [ "$CURRENT_LABEL" != "rootfs_a" ]; then
        log "Setting rootfs_a partition label..."
        sgdisk -c "$ROOT_PART_NUM:rootfs_a" "$BASE_DEV"
    fi

    # Set the boot partition's GPT name — but ONLY on the real FAT boot
    # partition, found dynamically. DO NOT hardcode partition 1: on RK3588
    # (Radxa CM5) partition 1 is the raw "uboot" partition that the Rockchip
    # Miniloader locates by its GPT name "uboot" to find U-Boot. Renaming it to
    # "boot" makes SPL unable to find U-Boot -> the board fails to boot from eMMC
    # ("spl: partition error / failed to boot from all boot devices"). The wic
    # already names the FAT partition "boot", so this is usually a no-op; we only
    # act if no "boot" GPT name exists yet, and never touch a "uboot" partition.
    if [ ! -e /dev/disk/by-partlabel/boot ]; then
        BOOT_DEV=$(lsblk -lnpo NAME,FSTYPE "$BASE_DEV" 2>/dev/null | awk '$2=="vfat"{print $1; exit}')
        if [ -n "$BOOT_DEV" ]; then
            BOOT_PART_NUM=$(echo "$BOOT_DEV" | grep -oE '[0-9]+$')
            BOOT_LABEL=$(sgdisk -i "$BOOT_PART_NUM" "$BASE_DEV" 2>/dev/null | grep "Partition name" | cut -d"'" -f2)
            if [ "$BOOT_LABEL" != "boot" ] && [ "$BOOT_LABEL" != "uboot" ]; then
                log "Setting boot partition label on $BOOT_DEV (p$BOOT_PART_NUM)..."
                sgdisk -c "$BOOT_PART_NUM:boot" "$BASE_DEV"
            fi
        fi
    fi
fi

# Final partition table update
if command -v partprobe &> /dev/null; then
    partprobe "$BASE_DEV" || true
else
    partx -u "$BASE_DEV" || true
fi
sleep 2

# Verify partitions were created
log "Verifying partition labels..."
ls -la /dev/disk/by-partlabel/ || true

# Create marker file
mkdir -p "$(dirname $MARKER_FILE)"
touch "$MARKER_FILE"

log "Partition setup complete!"
log "Final partition layout:"
# Diagnostic only — MUST be non-fatal (script runs under `set -e`). Use the tool
# that matches the table: `sgdisk -p` on an MBR disk finds "invalid GPT + valid
# MBR", converts to GPT in memory and prints alarming "may be garbage" warnings;
# worse, on some gptfdisk versions it can exit non-zero, which under set -e would
# abort the script HERE — after partitions exist but before /data/ota boot-env is
# seeded, leaving a half-provisioned device. sfdisk -l lists MBR cleanly and is
# already a dependency (used for --append above). All guarded with || true.
if [ "$PTTYPE" = "dos" ]; then
    sfdisk -l "$BASE_DEV" || true
else
    sgdisk -p "$BASE_DEV" || true
fi
lsblk -o NAME,SIZE,LABEL,PARTLABEL,FSTYPE "$BASE_DEV" || true

# Mount data partition
if [ ! -d "/data" ]; then
    mkdir -p /data
fi

if ! mountpoint -q /data; then
    mount "$DATA_DEV" /data
    log "Mounted data partition at /data"
fi

# Create OTAPulse persistent directories on /data partition
# These directories persist across A/B OTA updates
mkdir -p /data/otapulse
mkdir -p /data/ota
log "Created persistent directories: /data/otapulse, /data/ota"

# Ensure SSH keys are persistent (now that /data is definitely mounted).
# machine-id persistence is owned by otapulse-machine-id.service.
ensure_persistent_ssh_keys || log "Warning: SSH key persistence failed"

# Seed /data/otapulse/device_type for OTA HW-compatibility checks.
seed_device_type

# Initialize boot environment files for OTA agent
# These files are required for A/B partition management
initialize_boot_env() {
    local ota_dir="/data/ota"
    mkdir -p "$ota_dir"

    # Determine current boot partition number
    # rootfs_a is partition $ROOT_PART_NUM, rootfs_b is $ROOTFS_B_PART_NUM
    local current_part="$ROOT_PART_NUM"

    # Initialize mender_boot_part with current partition
    if [ ! -f "$ota_dir/mender_boot_part" ]; then
        echo "$current_part" > "$ota_dir/mender_boot_part"
        log "Initialized mender_boot_part=$current_part"
    fi

    # Initialize boot_count to 0 (fresh boot)
    if [ ! -f "$ota_dir/boot_count" ]; then
        echo "0" > "$ota_dir/boot_count"
        log "Initialized boot_count=0"
    fi

    # Initialize upgrade_available to 0 (no pending upgrade)
    if [ ! -f "$ota_dir/upgrade_available" ]; then
        echo "0" > "$ota_dir/upgrade_available"
        log "Initialized upgrade_available=0"
    fi

    # Initialize current_slot to 'a' (booting from rootfs_a)
    if [ ! -f "$ota_dir/current_slot" ]; then
        echo "a" > "$ota_dir/current_slot"
        log "Initialized current_slot=a"
    fi

    log "Boot environment initialized in $ota_dir"
}

initialize_boot_env

log "OTAPulse partition setup completed successfully!"
exit 0
