#!/bin/bash
# OTAPulse First-Boot Partition Setup
# Creates A/B partitions dynamically on first boot
#
# This script:
# 1. Detects the boot device
# 2. Creates rootfs_b partition (same size as rootfs_a)
# 3. Creates data partition (remaining space, min 1GB)
# 4. Sets GPT partition labels for OTA agent
#
# Benefits:
# - Minimal initial image size (only boot + rootfs_a)
# - Works on any storage size (16GB, 32GB, 64GB, etc.)
# - Platform agnostic - no WKS customization needed

set -e

LOG_TAG="otapulse-setup"
MARKER_FILE="/var/lib/otapulse/.partitions-created"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"
    logger -t "$LOG_TAG" "$1"
}

error() {
    log "ERROR: $1"
    exit 1
}

# =============================================================================
# CRITICAL: Ensure machine-id is persistent (runs on EVERY boot)
# =============================================================================
# This MUST run before early exit to handle both:
# 1. First boot on partition A - save machine-id to /data
# 2. First boot on partition B (after OTA) - symlink to existing /data/machine-id
# 3. Subsequent boots - verify symlink exists
# =============================================================================
ensure_persistent_machine_id() {
    PERSISTENT_MACHINE_ID="/data/machine-id"

    # Check if /data is mounted (may not be on very first boot before partitioning)
    if ! mountpoint -q /data 2>/dev/null; then
        # Try to mount data partition if it exists
        if [ -e "/dev/disk/by-partlabel/data" ]; then
            mkdir -p /data
            mount /dev/disk/by-partlabel/data /data || return 1
            log "Mounted /data partition for machine-id persistence"
        else
            # /data partition doesn't exist yet, skip for now
            return 1
        fi
    fi

    if [ ! -f "$PERSISTENT_MACHINE_ID" ]; then
        # First boot ever - save current machine-id to persistent storage
        if [ -f /etc/machine-id ] && [ ! -L /etc/machine-id ]; then
            cp /etc/machine-id "$PERSISTENT_MACHINE_ID"
            log "Saved machine-id to persistent storage: $(cat $PERSISTENT_MACHINE_ID)"
        else
            # Generate new machine-id if not exists
            if command -v systemd-machine-id-setup &> /dev/null; then
                systemd-machine-id-setup
                cp /etc/machine-id "$PERSISTENT_MACHINE_ID"
            else
                # Manual generation fallback
                cat /proc/sys/kernel/random/uuid | tr -d '-' > "$PERSISTENT_MACHINE_ID"
            fi
            log "Generated new persistent machine-id: $(cat $PERSISTENT_MACHINE_ID)"
        fi
    fi

    # Replace /etc/machine-id with symlink to persistent copy
    # This handles: partition B after OTA (has different machine-id file)
    if [ -f "$PERSISTENT_MACHINE_ID" ]; then
        if [ ! -L /etc/machine-id ]; then
            # /etc/machine-id is a regular file, replace with symlink
            rm -f /etc/machine-id
            ln -sf "$PERSISTENT_MACHINE_ID" /etc/machine-id
            log "Created symlink: /etc/machine-id -> $PERSISTENT_MACHINE_ID"
        elif [ "$(readlink /etc/machine-id)" != "$PERSISTENT_MACHINE_ID" ]; then
            # Symlink exists but points elsewhere, fix it
            rm -f /etc/machine-id
            ln -sf "$PERSISTENT_MACHINE_ID" /etc/machine-id
            log "Fixed symlink: /etc/machine-id -> $PERSISTENT_MACHINE_ID"
        fi
    fi

    return 0
}

# =============================================================================
# CRITICAL: Ensure SSH host keys are persistent (runs on EVERY boot)
# =============================================================================
# Problem: Each rootfs partition generates its own SSH host keys, causing
# "Host key verification failed" errors after OTA slot switch.
#
# Solution: Store SSH host keys in /data (persistent) and symlink from /etc/ssh
# =============================================================================
ensure_persistent_ssh_keys() {
    PERSISTENT_SSH_DIR="/data/ssh"
    SSH_KEY_TYPES="rsa ecdsa ed25519"

    # Check if /data is mounted
    if ! mountpoint -q /data 2>/dev/null; then
        return 1
    fi

    # Create persistent SSH directory
    mkdir -p "$PERSISTENT_SSH_DIR"
    chmod 700 "$PERSISTENT_SSH_DIR"

    for key_type in $SSH_KEY_TYPES; do
        PERSISTENT_KEY="$PERSISTENT_SSH_DIR/ssh_host_${key_type}_key"
        SYSTEM_KEY="/etc/ssh/ssh_host_${key_type}_key"

        if [ ! -f "$PERSISTENT_KEY" ]; then
            # First boot - copy existing key or generate new one
            if [ -f "$SYSTEM_KEY" ] && [ ! -L "$SYSTEM_KEY" ]; then
                cp "$SYSTEM_KEY" "$PERSISTENT_KEY"
                cp "${SYSTEM_KEY}.pub" "${PERSISTENT_KEY}.pub" 2>/dev/null || true
                log "Saved SSH $key_type key to persistent storage"
            fi
        fi

        # Symlink system key to persistent key
        if [ -f "$PERSISTENT_KEY" ]; then
            if [ ! -L "$SYSTEM_KEY" ]; then
                rm -f "$SYSTEM_KEY" "${SYSTEM_KEY}.pub"
                ln -sf "$PERSISTENT_KEY" "$SYSTEM_KEY"
                ln -sf "${PERSISTENT_KEY}.pub" "${SYSTEM_KEY}.pub" 2>/dev/null || true
                log "Created symlink: $SYSTEM_KEY -> $PERSISTENT_KEY"
            fi
        fi
    done

    # Restart sshd if keys were changed (only if sshd is running)
    if systemctl is-active --quiet sshd 2>/dev/null; then
        systemctl restart sshd || true
    fi

    return 0
}

# =============================================================================
# CRITICAL: Ensure boot scripts are persistent (runs on EVERY boot)
# =============================================================================
# Problem: switch-boot-slot.sh is needed to switch A/B partitions during OTA.
# If the current rootfs doesn't have it, OTA will fail to switch partitions.
#
# Solution: Store boot scripts in /data (persistent) and copy to /usr/sbin if missing
# =============================================================================
ensure_persistent_boot_scripts() {
    PERSISTENT_SCRIPTS_DIR="/data/scripts"
    BOOT_SCRIPT="switch-boot-slot.sh"
    SYSTEM_SCRIPT="/usr/sbin/$BOOT_SCRIPT"
    PERSISTENT_SCRIPT="$PERSISTENT_SCRIPTS_DIR/$BOOT_SCRIPT"

    # Check if /data is mounted
    if ! mountpoint -q /data 2>/dev/null; then
        return 1
    fi

    # Create persistent scripts directory
    mkdir -p "$PERSISTENT_SCRIPTS_DIR"
    chmod 755 "$PERSISTENT_SCRIPTS_DIR"

    # If system has the script but persistent doesn't, save to persistent
    if [ -f "$SYSTEM_SCRIPT" ] && [ ! -L "$SYSTEM_SCRIPT" ] && [ ! -f "$PERSISTENT_SCRIPT" ]; then
        cp "$SYSTEM_SCRIPT" "$PERSISTENT_SCRIPT"
        chmod 755 "$PERSISTENT_SCRIPT"
        log "Saved $BOOT_SCRIPT to persistent storage"
    fi

    # If persistent has the script but system doesn't, restore to system
    if [ -f "$PERSISTENT_SCRIPT" ] && [ ! -f "$SYSTEM_SCRIPT" ]; then
        cp "$PERSISTENT_SCRIPT" "$SYSTEM_SCRIPT"
        chmod 755 "$SYSTEM_SCRIPT"
        log "Restored $BOOT_SCRIPT from persistent storage"
    fi

    return 0
}

# Always ensure persistent machine-id (even if partitions already configured)
ensure_persistent_machine_id || log "machine-id persistence skipped (data partition not ready)"

# Always ensure persistent SSH keys
ensure_persistent_ssh_keys || log "SSH key persistence skipped (data partition not ready)"

# Always ensure boot scripts are available
ensure_persistent_boot_scripts || log "Boot scripts persistence skipped (data partition not ready)"

# Check if already configured
if [ -f "$MARKER_FILE" ]; then
    log "Partitions already configured, skipping setup"
    exit 0
fi

log "Starting OTAPulse partition setup..."

# Find the root device
ROOT_PART=$(findmnt -n -o SOURCE /)
if [ -z "$ROOT_PART" ]; then
    error "Cannot find root partition"
fi

log "Root partition: $ROOT_PART"

# Extract base device (e.g., /dev/mmcblk1p2 -> /dev/mmcblk1)
if [[ "$ROOT_PART" =~ ^/dev/mmcblk[0-9]+p[0-9]+$ ]]; then
    BASE_DEV=$(echo "$ROOT_PART" | sed 's/p[0-9]*$//')
    ROOT_PART_NUM=$(echo "$ROOT_PART" | sed 's/.*p//')
elif [[ "$ROOT_PART" =~ ^/dev/sd[a-z][0-9]+$ ]]; then
    BASE_DEV=$(echo "$ROOT_PART" | sed 's/[0-9]*$//')
    ROOT_PART_NUM=$(echo "$ROOT_PART" | sed 's/.*[a-z]//')
else
    error "Unsupported device format: $ROOT_PART"
fi

log "Base device: $BASE_DEV"
log "Root partition number: $ROOT_PART_NUM"

# Check if sgdisk is available
if ! command -v sgdisk &> /dev/null; then
    error "sgdisk not found. Install gptfdisk package."
fi

# Get current partition info
log "Current partition layout:"
sgdisk -p "$BASE_DEV"

# EARLY CHECK: If all required partitions exist with correct labels and are formatted,
# we don't need to do anything. This handles WIC images that pre-create partitions.
check_all_partitions_ready() {
    local all_ready=1

    # Check rootfs_a (should be the current root)
    if [ ! -e "/dev/disk/by-partlabel/rootfs_a" ]; then
        log "rootfs_a partition label not found"
        all_ready=0
    fi

    # Check rootfs_b
    if [ -e "/dev/disk/by-partlabel/rootfs_b" ]; then
        local fstype=$(lsblk -no FSTYPE /dev/disk/by-partlabel/rootfs_b 2>/dev/null || true)
        if [ -z "$fstype" ]; then
            log "rootfs_b exists but not formatted"
            all_ready=0
        fi
    else
        log "rootfs_b partition not found"
        all_ready=0
    fi

    # Check data partition
    if [ -e "/dev/disk/by-partlabel/data" ]; then
        local fstype=$(lsblk -no FSTYPE /dev/disk/by-partlabel/data 2>/dev/null || true)
        if [ -z "$fstype" ]; then
            log "data partition exists but not formatted"
            all_ready=0
        fi
    else
        log "data partition not found"
        all_ready=0
    fi

    return $((1 - all_ready))
}

if check_all_partitions_ready; then
    log "All partitions (rootfs_a, rootfs_b, data) already exist and are formatted"
    log "Partition setup not needed - likely a WIC image with pre-created partitions"

    # Mount data partition if not already mounted
    if [ -e "/dev/disk/by-partlabel/data" ]; then
        if [ ! -d "/data" ]; then
            mkdir -p /data
        fi
        if ! mountpoint -q /data; then
            mount /dev/disk/by-partlabel/data /data 2>/dev/null || true
            log "Mounted data partition at /data"
        fi
    fi

    # Initialize boot environment files for A/B partition management
    if [ -d "/data" ] && mountpoint -q /data; then
        OTA_DIR="/data/ota"
        mkdir -p "$OTA_DIR"

        # Initialize boot env files if they don't exist
        if [ ! -f "$OTA_DIR/mender_boot_part" ]; then
            echo "$ROOT_PART_NUM" > "$OTA_DIR/mender_boot_part"
            log "Initialized mender_boot_part=$ROOT_PART_NUM"
        fi
        if [ ! -f "$OTA_DIR/boot_count" ]; then
            echo "0" > "$OTA_DIR/boot_count"
            log "Initialized boot_count=0"
        fi
        if [ ! -f "$OTA_DIR/upgrade_available" ]; then
            echo "0" > "$OTA_DIR/upgrade_available"
            log "Initialized upgrade_available=0"
        fi
        if [ ! -f "$OTA_DIR/current_slot" ]; then
            echo "a" > "$OTA_DIR/current_slot"
            log "Initialized current_slot=a"
        fi
        log "Boot environment initialized"
    fi

    # Create marker file
    mkdir -p "$(dirname $MARKER_FILE)"
    touch "$MARKER_FILE"
    log "Partition setup complete (pre-existing partitions detected)"
    exit 0
fi

# Check if rootfs_b already exists and is formatted (partial setup)
if [ -e "/dev/disk/by-partlabel/rootfs_b" ]; then
    ROOTFS_B_FSTYPE=$(lsblk -no FSTYPE /dev/disk/by-partlabel/rootfs_b 2>/dev/null || true)
    if [ -n "$ROOTFS_B_FSTYPE" ]; then
        log "rootfs_b partition already exists and formatted ($ROOTFS_B_FSTYPE)"
        # Continue to check/create data partition
    else
        log "rootfs_b partition exists but not formatted, will format it"
    fi
fi

# Get rootfs_a size (in sectors)
ROOTFS_A_SIZE=$(sgdisk -i "$ROOT_PART_NUM" "$BASE_DEV" | grep "Partition size" | awk '{print $3}')
# Get sector size - sgdisk shows "512/512" (logical/physical), we need just the logical size
SECTOR_SIZE=$(blockdev --getss "$BASE_DEV")

log "rootfs_a size: $ROOTFS_A_SIZE sectors ($SECTOR_SIZE bytes/sector)"

# Calculate sizes
ROOTFS_A_SIZE_MB=$((ROOTFS_A_SIZE * SECTOR_SIZE / 1024 / 1024))
log "rootfs_a size: ${ROOTFS_A_SIZE_MB}MB"

# Get total device size and find free space
DEVICE_SIZE_SECTORS=$(sgdisk -p "$BASE_DEV" | grep "Disk.*sectors" | awk '{print $3}')
LAST_SECTOR=$(sgdisk -E "$BASE_DEV")

log "Device total sectors: $DEVICE_SIZE_SECTORS"
log "Last usable sector: $LAST_SECTOR"

# Find the end of the last partition
LAST_PART_END=$(sgdisk -p "$BASE_DEV" | tail -n +9 | awk '{print $3}' | sort -n | tail -1)
FREE_START=$((LAST_PART_END + 1))
FREE_SECTORS=$((LAST_SECTOR - FREE_START))
FREE_SIZE_MB=$((FREE_SECTORS * SECTOR_SIZE / 1024 / 1024))

log "Free space starts at sector: $FREE_START"
log "Free space: ${FREE_SIZE_MB}MB"

# Check if we have enough space for rootfs_b + data
MIN_DATA_SIZE_MB=1024  # Minimum 1GB for data partition
REQUIRED_MB=$((ROOTFS_A_SIZE_MB + MIN_DATA_SIZE_MB))

if [ "$FREE_SIZE_MB" -lt "$REQUIRED_MB" ]; then
    error "Not enough free space. Need ${REQUIRED_MB}MB, have ${FREE_SIZE_MB}MB"
fi

# Calculate partition numbers
ROOTFS_B_PART_NUM=$((ROOT_PART_NUM + 1))
DATA_PART_NUM=$((ROOT_PART_NUM + 2))

# Calculate partition boundaries
ROOTFS_B_START=$FREE_START
ROOTFS_B_END=$((ROOTFS_B_START + ROOTFS_A_SIZE - 1))
DATA_START=$((ROOTFS_B_END + 1))
DATA_END=$LAST_SECTOR

# Check if partitions already exist (from previous interrupted run)
PARTITIONS_EXIST=0
if [ -e "/dev/disk/by-partlabel/rootfs_b" ] && [ -e "/dev/disk/by-partlabel/data" ]; then
    log "Partitions already exist, skipping creation"
    PARTITIONS_EXIST=1
fi

if [ "$PARTITIONS_EXIST" -eq 0 ]; then
    log "Creating rootfs_b: partition $ROOTFS_B_PART_NUM, sectors $ROOTFS_B_START-$ROOTFS_B_END"
    log "Creating data: partition $DATA_PART_NUM, sectors $DATA_START-$DATA_END"

    # Create partitions
    log "Creating rootfs_b partition..."
    sgdisk -n "$ROOTFS_B_PART_NUM:$ROOTFS_B_START:$ROOTFS_B_END" \
           -c "$ROOTFS_B_PART_NUM:rootfs_b" \
           -t "$ROOTFS_B_PART_NUM:8300" \
           "$BASE_DEV"

    log "Creating data partition..."
    sgdisk -n "$DATA_PART_NUM:$DATA_START:$DATA_END" \
           -c "$DATA_PART_NUM:data" \
           -t "$DATA_PART_NUM:8300" \
           "$BASE_DEV"

    # Inform kernel of partition changes
    log "Updating kernel partition table..."
    # Use partx (util-linux) as partprobe may not be available
    if command -v partprobe &> /dev/null; then
        partprobe "$BASE_DEV" || true
    else
        # partx -u updates the kernel's partition table
        partx -u "$BASE_DEV" || true
    fi
    sleep 2
fi

# Wait for partition devices to appear
for i in $(seq 1 10); do
    if [ -e "${BASE_DEV}p${ROOTFS_B_PART_NUM}" ] || [ -e "${BASE_DEV}${ROOTFS_B_PART_NUM}" ]; then
        break
    fi
    log "Waiting for partition devices... ($i/10)"
    sleep 1
done

# Determine partition device naming
if [ -e "${BASE_DEV}p${ROOTFS_B_PART_NUM}" ]; then
    ROOTFS_B_DEV="${BASE_DEV}p${ROOTFS_B_PART_NUM}"
    DATA_DEV="${BASE_DEV}p${DATA_PART_NUM}"
else
    ROOTFS_B_DEV="${BASE_DEV}${ROOTFS_B_PART_NUM}"
    DATA_DEV="${BASE_DEV}${DATA_PART_NUM}"
fi

# Format partitions (only if not already formatted)
ROOTFS_B_FSTYPE=$(lsblk -no FSTYPE "$ROOTFS_B_DEV" 2>/dev/null || true)
if [ -z "$ROOTFS_B_FSTYPE" ]; then
    log "Formatting rootfs_b ($ROOTFS_B_DEV)..."
    mkfs.ext4 -F -L "rootfs_b" "$ROOTFS_B_DEV"
else
    log "rootfs_b already formatted ($ROOTFS_B_FSTYPE), skipping"
fi

DATA_FSTYPE=$(lsblk -no FSTYPE "$DATA_DEV" 2>/dev/null || true)
if [ -z "$DATA_FSTYPE" ]; then
    log "Formatting data ($DATA_DEV)..."
    mkfs.ext4 -F -L "data" "$DATA_DEV"
else
    log "data already formatted ($DATA_FSTYPE), skipping"
fi

# Update rootfs_a partition label if needed
ROOTFS_A_DEV="$ROOT_PART"
CURRENT_LABEL=$(sgdisk -i "$ROOT_PART_NUM" "$BASE_DEV" | grep "Partition name" | cut -d"'" -f2)
if [ "$CURRENT_LABEL" != "rootfs_a" ]; then
    log "Setting rootfs_a partition label..."
    sgdisk -c "$ROOT_PART_NUM:rootfs_a" "$BASE_DEV"
fi

# Set boot partition label
BOOT_PART_NUM=1
BOOT_LABEL=$(sgdisk -i "$BOOT_PART_NUM" "$BASE_DEV" | grep "Partition name" | cut -d"'" -f2)
if [ "$BOOT_LABEL" != "boot" ]; then
    log "Setting boot partition label..."
    sgdisk -c "$BOOT_PART_NUM:boot" "$BASE_DEV"
fi

# Final partition table update
if command -v partprobe &> /dev/null; then
    partprobe "$BASE_DEV" || true
else
    partx -u "$BASE_DEV" || true
fi
sleep 2

# Verify partitions were created
log "Verifying partition labels..."
ls -la /dev/disk/by-partlabel/ || true

# Create marker file
mkdir -p "$(dirname $MARKER_FILE)"
touch "$MARKER_FILE"

log "Partition setup complete!"
log "Final partition layout:"
sgdisk -p "$BASE_DEV"
lsblk -o NAME,SIZE,LABEL,PARTLABEL,FSTYPE "$BASE_DEV"

# Mount data partition
if [ ! -d "/data" ]; then
    mkdir -p /data
fi

if ! mountpoint -q /data; then
    mount "$DATA_DEV" /data
    log "Mounted data partition at /data"
fi

# Create OTAPulse persistent directories on /data partition
# These directories persist across A/B OTA updates
mkdir -p /data/otapulse
mkdir -p /data/ota
log "Created persistent directories: /data/otapulse, /data/ota"

# Ensure machine-id and SSH keys are persistent (now that /data is definitely mounted)
ensure_persistent_machine_id || log "Warning: machine-id persistence failed"
ensure_persistent_ssh_keys || log "Warning: SSH key persistence failed"

# Initialize boot environment files for OTA agent
# These files are required for A/B partition management
initialize_boot_env() {
    local ota_dir="/data/ota"
    mkdir -p "$ota_dir"

    # Determine current boot partition number
    # rootfs_a is partition $ROOT_PART_NUM, rootfs_b is $ROOTFS_B_PART_NUM
    local current_part="$ROOT_PART_NUM"

    # Initialize mender_boot_part with current partition
    if [ ! -f "$ota_dir/mender_boot_part" ]; then
        echo "$current_part" > "$ota_dir/mender_boot_part"
        log "Initialized mender_boot_part=$current_part"
    fi

    # Initialize boot_count to 0 (fresh boot)
    if [ ! -f "$ota_dir/boot_count" ]; then
        echo "0" > "$ota_dir/boot_count"
        log "Initialized boot_count=0"
    fi

    # Initialize upgrade_available to 0 (no pending upgrade)
    if [ ! -f "$ota_dir/upgrade_available" ]; then
        echo "0" > "$ota_dir/upgrade_available"
        log "Initialized upgrade_available=0"
    fi

    # Initialize current_slot to 'a' (booting from rootfs_a)
    if [ ! -f "$ota_dir/current_slot" ]; then
        echo "a" > "$ota_dir/current_slot"
        log "Initialized current_slot=a"
    fi

    log "Boot environment initialized in $ota_dir"
}

initialize_boot_env

log "OTAPulse partition setup completed successfully!"
exit 0
