[Unit]
Description=OTAPulse Auto-Provisioning
Documentation=https://github.com/binaryblack/OTA-Pulse
# Run after network is available, partitions are set up, and machine-id is restored
After=network-online.target otapulse-partition-setup.service otapulse-machine-id.service
Wants=network-online.target
# NOTE: this unit intentionally has NO ConditionPathExists on
# /data/otapulse/.auto-provisioned. otapulse-auto-provision must run on
# EVERY boot (including after an OTA) so it can re-align the Remote SSH
# tunnel's proxyName/credential with the device's current identity even when
# main provisioning is already done — /etc/otapulse/tunnel.conf ships on the
# rootfs (wiped by every OTA) while the provisioning markers live on /data
# (survive OTA), so a marker-gated unit would never run the realignment
# again. The script itself does the fast, local-only "already aligned, skip"
# check so a healthy re-run stays cheap and makes no network calls.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/otapulse-auto-provision
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=180

# Admin credentials used by auto-provision to mint the device API key + sotc
# tunnel credential on first boot. No default credentials are shipped (GAP-OTA-015)
# — the operator must supply OTAPULSE_ADMIN_EMAIL/OTAPULSE_ADMIN_PASSWORD via
# /etc/otapulse/provision.env (mode 0600, not tracked in this repo). The '-'
# prefix makes the file optional so a board with no override still boots;
# otapulse-auto-provision itself logs a loud, explicit error and skips
# admin-based registration if the variables are unset.
EnvironmentFile=-/etc/otapulse/provision.env

[Install]
WantedBy=multi-user.target
