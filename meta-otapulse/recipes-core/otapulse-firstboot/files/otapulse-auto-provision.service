[Unit]
Description=OTAPulse Auto-Provisioning
Documentation=https://github.com/binaryblack/OTA-Pulse
# Run after network is available, partitions are set up, and machine-id is restored
After=network-online.target otapulse-partition-setup.service otapulse-machine-id.service
Wants=network-online.target
# Don't run if already provisioned
ConditionPathExists=!/data/otapulse/.auto-provisioned

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/otapulse-auto-provision
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=180

# Admin credentials for first-boot registration.
# Per-deployment override: write KEY=value lines to /etc/otapulse/provision.env
# (OTAPULSE_ADMIN_EMAIL=, OTAPULSE_ADMIN_PASSWORD=). The leading '-' makes the
# file optional. The script also sources this file directly so manual runs match.
EnvironmentFile=-/etc/otapulse/provision.env
Environment="OTAPULSE_ADMIN_EMAIL=admin@socmon.local"
Environment="OTAPULSE_ADMIN_PASSWORD=Admin@123"

[Install]
WantedBy=multi-user.target
