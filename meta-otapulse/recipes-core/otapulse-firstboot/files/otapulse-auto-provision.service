[Unit]
Description=OTAPulse Auto-Provisioning
Documentation=https://github.com/binaryblack/OTA-Pulse
# Run after network is available, partitions are set up, and machine-id is restored
After=network-online.target otapulse-partition-setup.service otapulse-machine-id.service
Wants=network-online.target
# Don't run if already provisioned
ConditionPathExists=!/data/otapulse/.auto-provisioned

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/otapulse-auto-provision
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=180

# Admin credentials used by auto-provision to mint the device API key + sotc
# tunnel credential on first boot. DEFAULT = the LAN server admin so flashed
# boards self-provision against 192.168.0.123 out of the box. Override for a
# staging image via a systemd drop-in or bbappend (do NOT bake real prod creds):
#   /etc/systemd/system/otapulse-auto-provision.service.d/10-creds.conf
Environment="OTAPULSE_ADMIN_EMAIL=admin@socmon.local"
Environment="OTAPULSE_ADMIN_PASSWORD=Admin@123"

[Install]
WantedBy=multi-user.target
