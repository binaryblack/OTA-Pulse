[Unit]
Description=Data Partition Mount for OTA Storage
Documentation=https://github.com/example/soc-monitoring
Before=socmond.service
# Use partlabel for device-agnostic mounting (works on mmcblk0, mmcblk1, etc.)
ConditionPathExists=/dev/disk/by-partlabel/data
DefaultDependencies=no
After=local-fs-pre.target

[Mount]
What=/dev/disk/by-partlabel/data
Where=/data
Type=ext4
Options=defaults,nofail
TimeoutSec=10

[Install]
WantedBy=local-fs.target
