def get_cpu_usage():
    """Get CPU usage percentage."""
    try:
        with open('/proc/stat', 'r') as f:
            line = f.readline()
        parts = line.split()
        idle = int(parts[4])
        total = sum(int(p) for p in parts[1:])
        
        time.sleep(0.1)
        
        with open('/proc/stat', 'r') as f:
            line = f.readline()
        parts = line.split()
        idle2 = int(parts[4])
        total2 = sum(int(p) for p in parts[1:])
        
        idle_delta = idle2 - idle
        total_delta = total2 - total
        
        if total_delta == 0:
            return 0
        return round((1 - idle_delta / total_delta) * 100, 1)
    except:
        return 0

def get_memory_info():
    """Get memory usage information."""
    try:
        with open('/proc/meminfo', 'r') as f:
            lines = f.readlines()
        
        mem_info = {}
        for line in lines:
            parts = line.split()
            key = parts[0].rstrip(':')
            value = int(parts[1]) * 1024  # Convert to bytes
            mem_info[key] = value
        
        total = mem_info.get('MemTotal', 0)
        available = mem_info.get('MemAvailable', mem_info.get('MemFree', 0))
        used = total - available
        percent = round((used / total) * 100, 1) if total > 0 else 0
        
        return {
            'total': total,
            'used': used,
            'available': available,
            'percent': percent
        }
    except:
        return {'total': 0, 'used': 0, 'available': 0, 'percent': 0}

def get_disk_info():
    """Get disk usage information."""
    try:
        stat = os.statvfs('/')
        total = stat.f_blocks * stat.f_frsize
        free = stat.f_bavail * stat.f_frsize
        used = total - free
        percent = round((used / total) * 100, 1) if total > 0 else 0
        
        return {
            'total': total,
            'used': used,
            'free': free,
            'percent': percent
        }
    except:
        return {'total': 0, 'used': 0, 'free': 0, 'percent': 0}

def get_temperature():
    """Get CPU temperature."""
    temp_paths = [
        '/sys/class/thermal/thermal_zone0/temp',
        '/sys/class/thermal/thermal_zone1/temp',
    ]
    for path in temp_paths:
        try:
            with open(path, 'r') as f:
                temp = int(f.read().strip()) / 1000
                return round(temp, 1)
        except:
            continue
    return None

def get_uptime():
    """Get system uptime."""
    try:
        with open('/proc/uptime', 'r') as f:
            uptime_seconds = float(f.read().split()[0])
        
        days = int(uptime_seconds // 86400)
        hours = int((uptime_seconds % 86400) // 3600)
        minutes = int((uptime_seconds % 3600) // 60)
        
        if days > 0:
            return f"{days}d {hours}h {minutes}m"
        elif hours > 0:
            return f"{hours}h {minutes}m"
        else:
            return f"{minutes}m"
    except:
        return "Unknown"

def get_load_average():
    """Get system load average."""
    try:
        with open('/proc/loadavg', 'r') as f:
            parts = f.read().split()
        return {
            '1min': float(parts[0]),
            '5min': float(parts[1]),
            '15min': float(parts[2])
        }
    except:
        return {'1min': 0, '5min': 0, '15min': 0}

def get_network_info():
    """Get network interface information."""
    interfaces = []
    try:
        for iface in ['eth0', 'end0', 'wlan0']:
            iface_path = f'/sys/class/net/{iface}'
            if os.path.exists(iface_path):
                # Get IP address
                try:
                    result = subprocess.run(
                        ['ip', '-4', 'addr', 'show', iface],
                        capture_output=True, text=True, timeout=5
                    )
                    ip = "No IP"
                    for line in result.stdout.split('\n'):
                        if 'inet ' in line:
                            ip = line.split()[1].split('/')[0]
                            break
                except:
                    ip = "Unknown"
                
                # Get status
                try:
                    with open(f'{iface_path}/operstate', 'r') as f:
                        status = f.read().strip()
                except:
                    status = "unknown"
                
                # Get RX/TX bytes
                try:
                    with open(f'{iface_path}/statistics/rx_bytes', 'r') as f:
                        rx = int(f.read().strip())
                    with open(f'{iface_path}/statistics/tx_bytes', 'r') as f:
                        tx = int(f.read().strip())
                except:
                    rx, tx = 0, 0
                
                interfaces.append({
                    'name': iface,
                    'ip': ip,
                    'status': status,
                    'rx_bytes': rx,
                    'tx_bytes': tx
                })
    except:
        pass
    return interfaces


def get_service_status(service_name):
    """Get systemd service status."""
    try:
        result = subprocess.run(
            ['systemctl', 'is-active', service_name],
            capture_output=True, text=True, timeout=5
        )
        return result.stdout.strip() == 'active'
    except:
        return False

def get_device_info():
    """Get device identification information."""
    info = {
        'device_id': 'Unknown',
        'mac_address': 'Unknown',
        'hostname': 'Unknown',
        'firmware_version': 'Unknown',
        'hardware_version': 'Unknown',
        'server_url': 'Not configured',
        'server_device_id': 'Not registered',
        'provisioned': False
    }
    
    # Get MAC address / Device ID
    for iface in ['eth0', 'end0']:
        try:
            with open(f'/sys/class/net/{iface}/address', 'r') as f:
                info['mac_address'] = f.read().strip()
                info['device_id'] = info['mac_address'].replace(':', '')
                break
        except:
            continue
    
    # Get hostname
    try:
        info['hostname'] = socket.gethostname()
    except:
        pass
    
    # Get firmware version
    try:
        with open('/etc/os-release', 'r') as f:
            for line in f:
                if line.startswith('VERSION='):
                    info['firmware_version'] = line.split('=')[1].strip().strip('"')
                    break
    except:
        pass
    
    # Get hardware version
    try:
        with open('/proc/device-tree/model', 'r') as f:
            info['hardware_version'] = f.read().strip('\x00').strip()
    except:
        pass
    
    # Get server URL from config
    try:
        with open(CONFIG_FILE, 'r') as f:
            config = json.load(f)
            info['server_url'] = config.get('server', {}).get('base_url', 'Not configured')
    except:
        pass
    
    # Check if provisioned
    if os.path.exists(API_KEY_FILE) and os.path.getsize(API_KEY_FILE) > 0:
        info['provisioned'] = True
    
    # Get server device ID
    try:
        with open(SERVER_DEVICE_ID_FILE, 'r') as f:
            info['server_device_id'] = f.read().strip()
    except:
        pass
    
    return info

def get_server_connection_status():
    """Check server connectivity and get last upload info."""
    status = {
        'reachable': False,
        'last_upload': 'Never',
        'last_heartbeat': 'Never',
        'pending_metrics': 0,
        'last_error': None
    }
    
    # Count pending metrics
    try:
        if os.path.exists(METRICS_DIR):
            status['pending_metrics'] = len([f for f in os.listdir(METRICS_DIR) if f.endswith('.json')])
    except:
        pass
    
    # Check server reachability
    try:
        with open(CONFIG_FILE, 'r') as f:
            config = json.load(f)
            server_url = config.get('server', {}).get('base_url', '')
        
        if server_url:
            import urllib.request
            req = urllib.request.Request(f"{server_url}/health", method='GET')
            req.add_header('User-Agent', 'soc-dashboard/1.0')
            with urllib.request.urlopen(req, timeout=5) as response:
                status['reachable'] = response.status == 200
    except:
        status['reachable'] = False
    
    # Parse log for last upload/heartbeat times
    try:
        if os.path.exists(LOG_FILE):
            with open(LOG_FILE, 'r') as f:
                lines = f.readlines()[-100:]  # Last 100 lines
            
            for line in reversed(lines):
                if 'Uploaded' in line and status['last_upload'] == 'Never':
                    # Extract timestamp
                    try:
                        ts = line.split()[0]
                        status['last_upload'] = ts
                    except:
                        pass
                if 'heartbeat' in line.lower() and status['last_heartbeat'] == 'Never':
                    try:
                        ts = line.split()[0]
                        status['last_heartbeat'] = ts
                    except:
                        pass
                if status['last_upload'] != 'Never' and status['last_heartbeat'] != 'Never':
                    break
    except:
        pass
    
    return status

def get_recent_failures():
    """Get recent failures from logs."""
    failures = []
    
    try:
        # Check socmond log for errors
        if os.path.exists(LOG_FILE):
            with open(LOG_FILE, 'r') as f:
                lines = f.readlines()[-200:]
            
            for line in lines:
                line_lower = line.lower()
                if any(word in line_lower for word in ['error', 'failed', 'failure', 'critical']):
                    try:
                        parts = line.split(None, 2)
                        if len(parts) >= 2:
                            failures.append({
                                'timestamp': parts[0],
                                'message': parts[-1].strip()[:100]
                            })
                    except:
                        pass
        
        # Check dedicated failure log
        if os.path.exists(FAILURE_LOG):
            with open(FAILURE_LOG, 'r') as f:
                for line in f.readlines()[-20:]:
                    try:
                        parts = line.split(None, 2)
                        if len(parts) >= 2:
                            failures.append({
                                'timestamp': parts[0],
                                'message': parts[-1].strip()[:100]
                            })
                    except:
                        pass
    except:
        pass
    
    # Return last 10 failures, most recent first
    return sorted(failures, key=lambda x: x.get('timestamp', ''), reverse=True)[:10]

def format_bytes(bytes_val):
    """Format bytes to human readable string."""
    for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
        if bytes_val < 1024:
            return f"{bytes_val:.1f} {unit}"
        bytes_val /= 1024
    return f"{bytes_val:.1f} PB"


