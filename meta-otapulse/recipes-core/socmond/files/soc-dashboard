            </div>
            '''
    else:
        failures_html = '<div class="no-failures">✓ No recent failures</div>'
    
    # Temperature display
    if temperature is not None:
        temp_str = f"{temperature}°C"
        temp_class = get_status_class(temperature, 60, 80)
    else:
        temp_str = "N/A"
        temp_class = ""
    
    # Format the HTML
    html = HTML_TEMPLATE.format(
        hostname=device_info['hostname'],
        update_time=datetime.now().strftime('%H:%M:%S'),
        
        # Server status
        server_status_class='green' if server_status['reachable'] else 'red',
        server_status_text='Connected' if server_status['reachable'] else 'Disconnected',
        
        # CPU
        cpu_usage=cpu_usage,
        cpu_class=get_status_class(cpu_usage, 70, 90),
        
        # Memory
        mem_percent=mem_info['percent'],
        mem_class=get_status_class(mem_info['percent'], 70, 90),
        mem_used=format_bytes(mem_info['used']),
        mem_total=format_bytes(mem_info['total']),
        
        # Disk
        disk_percent=disk_info['percent'],
        disk_class=get_status_class(disk_info['percent'], 70, 90),
        disk_used=format_bytes(disk_info['used']),
        disk_total=format_bytes(disk_info['total']),
        
        # Temperature
        temperature=temp_str,
        temp_class=temp_class,
        
        # Load & Uptime
        load_avg=f"{load_avg['1min']:.2f} / {load_avg['5min']:.2f} / {load_avg['15min']:.2f}",
        uptime=uptime,
        
        # Services
        socmond_status='Running' if socmond_running else 'Stopped',
        socmond_icon_class='running' if socmond_running else 'stopped',
        watchdog_status='Running' if watchdog_running else 'Stopped',
        watchdog_icon_class='running' if watchdog_running else 'stopped',
        
        # Connection
        conn_status='Connected' if server_status['reachable'] else 'Disconnected',
        conn_class='good' if server_status['reachable'] else 'critical',
        last_upload=server_status['last_upload'],
        pending_metrics=server_status['pending_metrics'],
        pending_class='good' if server_status['pending_metrics'] == 0 else 'warning',
        
        # Provisioning
        provisioned='Yes' if device_info['provisioned'] else 'No',
        prov_class='good' if device_info['provisioned'] else 'critical',
        
        # Network
        network_html=network_html,
        
        # Device info
        device_id=device_info['device_id'],
        mac_address=device_info['mac_address'],
        firmware_version=device_info['firmware_version'],
        hardware_version=device_info['hardware_version'],
        server_url=device_info['server_url'],
        server_device_id=device_info['server_device_id'],
        
        # Failures
        failures_html=failures_html
    )
    
    return html


class DashboardHandler(BaseHTTPRequestHandler):
    """HTTP request handler for the dashboard."""
    
    def log_message(self, format, *args):
        """Suppress default logging."""
        pass
    
    def do_GET(self):
        """Handle GET requests."""
        if self.path == '/' or self.path == '/index.html':
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            html = generate_html()
            self.wfile.write(html.encode('utf-8'))
        elif self.path == '/api/status':
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            data = {
                'cpu': get_cpu_usage(),
                'memory': get_memory_info(),
                'disk': get_disk_info(),
                'temperature': get_temperature(),
                'uptime': get_uptime(),
                'services': {
                    'socmond': get_service_status('socmond'),
                    'watchdog': get_service_status('socmond-watchdog')
                },
                'server': get_server_connection_status(),
                'device': get_device_info()
            }
            self.wfile.write(json.dumps(data).encode('utf-8'))
        else:
            self.send_response(404)
            self.end_headers()


def main():
    """Main entry point."""
    import argparse
    
    parser = argparse.ArgumentParser(description='SoC Monitoring Local Dashboard')
    parser.add_argument('-p', '--port', type=int, default=PORT, help=f'Port to listen on (default: {PORT})')
    parser.add_argument('-b', '--bind', default='0.0.0.0', help='Address to bind to (default: 0.0.0.0)')
    args = parser.parse_args()
    
    server_address = (args.bind, args.port)
    httpd = HTTPServer(server_address, DashboardHandler)
    
    print(f"SoC Dashboard starting on http://{args.bind}:{args.port}")
    print("Press Ctrl+C to stop")
    
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down...")
        httpd.shutdown()


if __name__ == '__main__':
    main()
