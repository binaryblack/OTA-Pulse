[Unit]
Description=SoC Monitoring Daemon
Documentation=https://github.com/example/soc-monitoring
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main

# Create required directories before starting
# Use -p flag and handle symlinks gracefully
ExecStartPre=/bin/mkdir -p /var/lib/socmond/coredumps
ExecStartPre=/bin/mkdir -p /var/lib/socmond/metrics
ExecStartPre=/bin/sh -c 'mkdir -p /data/ota 2>/dev/null || true'
ExecStartPre=/bin/sh -c 'if [ ! -e /var/lib/socmond/ota ]; then ln -sf /data/ota /var/lib/socmond/ota; elif [ -L /var/lib/socmond/ota ]; then mkdir -p "$(readlink -f /var/lib/socmond/ota)" 2>/dev/null || true; else mkdir -p /var/lib/socmond/ota; fi'
ExecStartPre=/bin/mkdir -p /var/log/socmond
ExecStartPre=/bin/mkdir -p /run/socmond

ExecStart=/usr/bin/socmond
Restart=on-failure
RestartSec=30
TimeoutStartSec=60
TimeoutStopSec=30

# Don't restart too aggressively
StartLimitIntervalSec=300
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=socmond

# -----------------------------------------------------------------------
# Hardening (GAP-SEC-F6)
# -----------------------------------------------------------------------
# socmond is network-facing (curls the OTA server, ingests coredumps,
# jq-parses responses) and previously ran with no sandboxing at all.
# Mirrors soc-ota-tunneld.service's ProtectSystem=full + ProtectHome=yes +
# PrivateTmp=yes + ReadWritePaths=/data pattern. Stays User=root (default,
# no User= line) — it manages /data mounts and coredump ingestion; unlike
# soc-ota-tunneld it does not exec a child process needing a privileged
# port, so NoNewPrivileges=yes is safe here (tunneld explicitly cannot use
# it, socmond can).
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# /var/lib/socmond, /var/log/socmond, /run/socmond, and /data are all
# UNRESTRICTED under ProtectSystem=full (only /usr, /boot, /etc are
# protected), so none of them strictly need an explicit ReadWritePaths
# today. /data is listed anyway, matching soc-ota-tunneld.service's
# pattern, so it stays correct for free if this is ever tightened to
# ProtectSystem=strict (which DOES require explicit ReadWritePaths for
# every writable path, including /var/lib/socmond etc — not done here,
# left as a possible follow-up).
ReadWritePaths=/data

[Install]
WantedBy=multi-user.target
