[Unit]
Description=SoC Monitoring Daemon
Documentation=https://github.com/example/soc-monitoring
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main

# Create required directories before starting
# Use -p flag and handle symlinks gracefully
ExecStartPre=/bin/mkdir -p /var/lib/socmond/coredumps
ExecStartPre=/bin/mkdir -p /var/lib/socmond/metrics
ExecStartPre=/bin/sh -c 'mkdir -p /data/ota 2>/dev/null || true'
ExecStartPre=/bin/sh -c 'if [ ! -e /var/lib/socmond/ota ]; then ln -sf /data/ota /var/lib/socmond/ota; elif [ -L /var/lib/socmond/ota ]; then mkdir -p "$(readlink -f /var/lib/socmond/ota)" 2>/dev/null || true; else mkdir -p /var/lib/socmond/ota; fi'
ExecStartPre=/bin/mkdir -p /var/log/socmond
ExecStartPre=/bin/mkdir -p /run/socmond

ExecStart=/usr/bin/socmond
Restart=on-failure
RestartSec=30
TimeoutStartSec=60
TimeoutStopSec=30

# Don't restart too aggressively
StartLimitIntervalSec=300
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=socmond

[Install]
WantedBy=multi-user.target
