#!/bin/sh
# Socmond - SoC Monitoring Daemon
# This is a reference implementation shell script
# For production, replace with compiled Rust binary

# Don't use set -e to prevent daemon from exiting on non-critical errors
set +e

# Configuration
CONFIG_FILE="/etc/socmond/config.json"
CUSTOM_METRICS_FILE="/etc/socmond/custom_metrics.conf"
METRICS_DIR="/var/lib/socmond/metrics"
COREDUMP_DIR="/var/lib/socmond/coredumps"
LOG_DIR="/var/log/socmond"
SOCKET_PATH="/run/socmond/metrics.sock"
PID_FILE="/run/socmond/socmond.pid"

# Persistent storage for provisioned API key and device ID
API_KEY_FILE="/var/lib/socmond/api_key"
SERVER_DEVICE_ID_FILE="/var/lib/socmond/server_device_id"

# Set by upload_metrics (BUG-288) when the server rejects our API key
# (401/403) so it's no longer accepted for this device — signals the main
# loop to re-provision immediately instead of waiting for the
# interval-gated retry, which only fires while provisioned=false.
NEEDS_REPROVISION_FILE="/var/lib/socmond/.needs_reprovision"

# TASK-S42-013: 402 billing_required means the ORG is blocked, so uploads
# pause entirely (per product) until the server's Retry-After deadline
# rather than retrying every UPLOAD_INTERVAL forever; collect_metrics keeps
# running on its own schedule regardless of either pause. These persist
# across daemon restarts on purpose — if the org is disabled and socmond
# restarts, it should still honor the deadline rather than immediately
# hammering the server again.
METRICS_UPLOAD_PAUSED_UNTIL_FILE="/var/lib/socmond/.metrics_upload_paused_until"
COREDUMP_UPLOAD_PAUSED_UNTIL_FILE="/var/lib/socmond/.coredump_upload_paused_until"
# Set when the most recent metrics upload attempt was told quota_exceeded
# (200, batch knowingly dropped); cleared on the next real success. Agent-side
# operational telemetry flag, matching the touch/rm convention already used
# by NEEDS_REPROVISION_FILE above.
METRICS_QUOTA_EXCEEDED_FILE="/var/lib/socmond/.metrics_quota_exceeded"

# Ensure directories exist
# NOTE: OTA functionality moved to soc-ota-agent
mkdir -p "${METRICS_DIR}" "${COREDUMP_DIR}" "${LOG_DIR}" "$(dirname "${SOCKET_PATH}")" "$(dirname "${API_KEY_FILE}")"

# Parse config
if [ -f "${CONFIG_FILE}" ]; then
    SERVER_URL=$(jq -r '.server.base_url // "https://api.example.com"' "${CONFIG_FILE}")
    # Load API key from file if exists (provisioned), otherwise from config
    # Use tr to remove any whitespace/newlines
    if [ -f "${API_KEY_FILE}" ] && [ -s "${API_KEY_FILE}" ]; then
        API_KEY=$(cat "${API_KEY_FILE}" | tr -d '[:space:]')
    else
        API_KEY=$(jq -r '.auth.api_key // ""' "${CONFIG_FILE}")
    fi
    PROVISIONING_TOKEN=$(jq -r '.auth.provisioning_token // ""' "${CONFIG_FILE}")
    # Also check for provisioning token file
    if [ -z "${PROVISIONING_TOKEN}" ] && [ -f "/etc/socmond/provisioning_token" ]; then
        PROVISIONING_TOKEN=$(cat "/etc/socmond/provisioning_token" | tr -d '[:space:]')
    fi
    DEVICE_ID=$(jq -r '.device.device_id // ""' "${CONFIG_FILE}")
    UPLOAD_INTERVAL=$(jq -r '.metrics.upload_interval_seconds // 300' "${CONFIG_FILE}")
    COLLECTION_INTERVAL=$(jq -r '.metrics.collection_interval_seconds // 60' "${CONFIG_FILE}")
    # NOTE: OTA functionality moved to soc-ota-agent
else
    echo "ERROR: Config file not found: ${CONFIG_FILE}"
    exit 1
fi

# Load server device ID if previously provisioned
if [ -f "${SERVER_DEVICE_ID_FILE}" ]; then
    SERVER_DEVICE_ID=$(cat "${SERVER_DEVICE_ID_FILE}")
fi

# Generate device ID if not set (use MAC address without colons)
if [ -z "${DEVICE_ID}" ]; then
    # Try eth0 first, then end0 (some systems use this naming)
    if [ -f /sys/class/net/eth0/address ]; then
        DEVICE_ID=$(cat /sys/class/net/eth0/address | tr -d ':')
    elif [ -f /sys/class/net/end0/address ]; then
        DEVICE_ID=$(cat /sys/class/net/end0/address | tr -d ':')
    elif [ -f /etc/machine-id ]; then
        DEVICE_ID=$(cat /etc/machine-id)
    else
        DEVICE_ID=$(uuidgen | tr -d '-')
    fi
fi

# Get MAC address for provisioning
get_mac_address() {
    if [ -f /sys/class/net/eth0/address ]; then
        cat /sys/class/net/eth0/address
    elif [ -f /sys/class/net/end0/address ]; then
        cat /sys/class/net/end0/address
    else
        echo ""
    fi
}

MAC_ADDRESS=$(get_mac_address)

# Get firmware version - prioritize build version file
if [ -f /etc/build-version ]; then
    FIRMWARE_VERSION=$(cat /etc/build-version)
else
    FIRMWARE_VERSION=$(cat /etc/os-release 2>/dev/null | grep "^VERSION=" | cut -d= -f2 | tr -d '"' || echo "unknown")
fi
HARDWARE_VERSION=$(cat /proc/device-tree/model 2>/dev/null | tr -d '\0' || echo "generic")

log() {
    echo "$(date -Iseconds) [socmond] $*"
    echo "$(date -Iseconds) $*" >> "${LOG_DIR}/socmond.log"
}

# Provision device with server using provisioning token
# This creates a unique API key for this device
provision_device() {
    # Skip if already provisioned (have API key)
    if [ -f "${API_KEY_FILE}" ] && [ -n "$(cat "${API_KEY_FILE}")" ]; then
        API_KEY=$(cat "${API_KEY_FILE}")
        log "Device already provisioned with API key: $(printf '%.12s' "$API_KEY")..."
        return 0
    fi

    # Skip if no provisioning token
    if [ -z "${PROVISIONING_TOKEN}" ]; then
        log "No provisioning token configured, skipping provisioning"
        return 1
    fi

    if [ -z "${SERVER_URL}" ]; then
        log "No server URL configured, skipping provisioning"
        return 1
    fi

    log "Provisioning device with server..."

    local response
    response=$(curl -s -X POST \
        -H "Content-Type: application/json" \
        -H "X-Provisioning-Token: ${PROVISIONING_TOKEN}" \
        -d "{\"device_id\":\"${DEVICE_ID}\",\"mac_address\":\"${MAC_ADDRESS}\",\"serial_number\":\"${DEVICE_ID}\",\"hardware_version\":\"${HARDWARE_VERSION}\",\"firmware_version\":\"${FIRMWARE_VERSION}\",\"device_type\":\"${HARDWARE_VERSION}\"}" \
        "${SERVER_URL}/api/v1/provision" \
        --connect-timeout 30 \
        --max-time 60 2>/dev/null || echo "{}")

    local status
    status=$(echo "${response}" | jq -r '.status // "error"')

    if [ "${status}" = "ok" ]; then
        local new_api_key new_device_id
        new_api_key=$(echo "${response}" | jq -r '.api_key')
        new_device_id=$(echo "${response}" | jq -r '.device_id')

        if [ -n "${new_api_key}" ] && [ "${new_api_key}" != "null" ]; then
            # Save the unique API key for this device
            echo "${new_api_key}" > "${API_KEY_FILE}"
            chmod 600 "${API_KEY_FILE}"
            API_KEY="${new_api_key}"

            # Save the hardware device ID for soc-ota-agent to use
            echo "${DEVICE_ID}" > "/var/lib/socmond/device_id"
            chmod 644 "/var/lib/socmond/device_id"

            if [ -n "${new_device_id}" ] && [ "${new_device_id}" != "null" ]; then
                echo "${new_device_id}" > "${SERVER_DEVICE_ID_FILE}"
                SERVER_DEVICE_ID="${new_device_id}"
            fi

            log "Device provisioned successfully!"
            log "  Device ID: ${SERVER_DEVICE_ID}"
            log "  Hardware ID: ${DEVICE_ID}"
            log "  API Key: $(printf '%.12s' "$API_KEY")... (stored securely)"

            # Notify soc-ota-agent to reload credentials if running
            if command -v systemctl >/dev/null 2>&1; then
                systemctl restart soc-ota-agent 2>/dev/null || true
            fi

            return 0
        fi
    fi

    local error_detail
    error_detail=$(echo "${response}" | jq -r '.detail // "Unknown error"')
    log "Device provisioning failed: ${error_detail}"
    return 1
}

# Register device with server (legacy flow using API key)
register_device() {
    # Check if we already have a server device ID
    if [ -f "${SERVER_DEVICE_ID_FILE}" ]; then
        SERVER_DEVICE_ID=$(cat "${SERVER_DEVICE_ID_FILE}")
        if [ -n "${SERVER_DEVICE_ID}" ]; then
            log "Using cached server device ID: ${SERVER_DEVICE_ID}"
            return 0
        fi
    fi

    if [ -z "${API_KEY}" ] || [ -z "${SERVER_URL}" ]; then
        log "No API key or server URL configured, skipping registration"
        return 1
    fi

    log "Registering device with server..."

    local response
    response=$(curl -s -X POST \
        -H "Content-Type: application/json" \
        -H "X-API-Key: ${API_KEY}" \
        -d "{\"device_id\":\"${DEVICE_ID}\",\"name\":\"${HARDWARE_VERSION}\",\"serial_number\":\"${DEVICE_ID}\",\"hardware_version\":\"${HARDWARE_VERSION}\",\"firmware_version\":\"${FIRMWARE_VERSION}\"}" \
        "${SERVER_URL}/api/v1/register" \
        --connect-timeout 30 \
        --max-time 60 2>/dev/null || echo "{}")

    local status
    status=$(echo "${response}" | jq -r '.status // "error"')

    if [ "${status}" = "ok" ]; then
        SERVER_DEVICE_ID=$(echo "${response}" | jq -r '.device_id')
        if [ -n "${SERVER_DEVICE_ID}" ] && [ "${SERVER_DEVICE_ID}" != "null" ]; then
            echo "${SERVER_DEVICE_ID}" > "${SERVER_DEVICE_ID_FILE}"
            log "Device registered successfully: ${SERVER_DEVICE_ID}"
            return 0
        fi
    fi

    log "Device registration failed: ${response}"
    return 1
}

# Notify systemd we're ready
notify_systemd() {
    if [ -n "${NOTIFY_SOCKET}" ]; then
        # Use systemd-notify if available, fallback to netcat
        if command -v systemd-notify >/dev/null 2>&1; then
            systemd-notify --ready 2>/dev/null || true
        else
            echo "READY=1" | nc -U -u -w1 "${NOTIFY_SOCKET}" 2>/dev/null || true
        fi
    fi
}

# Pet systemd watchdog
pet_watchdog() {
    if [ -n "${NOTIFY_SOCKET}" ]; then
        # Use systemd-notify if available, fallback to netcat
        if command -v systemd-notify >/dev/null 2>&1; then
            systemd-notify WATCHDOG=1 2>/dev/null || true
        else
            echo "WATCHDOG=1" | nc -U -u -w1 "${NOTIFY_SOCKET}" 2>/dev/null || true
        fi
    fi
}

# Collect custom metrics from configuration file
collect_custom_metrics() {
    local custom_metrics=""

    if [ -f "${CUSTOM_METRICS_FILE}" ]; then
        while IFS='=' read -r name command || [ -n "$name" ]; do
            # Skip comments and empty lines
            case "$name" in '#'*) continue ;; esac
            [ -z "$name" ] && continue

            # Parse metric definition: name=command [unit]
            local metric_name="${name%%=*}"
            local metric_cmd="${name#*=}"
            local metric_unit=""

            # Check if unit is specified: "command [unit]"
            case "$metric_cmd" in
                *'['*']')
                    metric_unit=$(echo "$metric_cmd" | sed 's/.*\[\([^]]*\)\]$/\1/')
                    metric_cmd=$(echo "$metric_cmd" | sed 's/[[:space:]]*\[[^]]*\]$//')
                    ;;
            esac

            # Execute the command to get the metric value
            local metric_value
            metric_value=$(eval "${metric_cmd}" 2>/dev/null || echo "0")

            # Validate it's a number
            if echo "$metric_value" | grep -qE '^-?[0-9]*\.?[0-9]+$'; then
                local unit_json=""
                if [ -n "${metric_unit}" ]; then
                    unit_json=", \"unit\": \"${metric_unit}\""
                fi
                if [ -n "${custom_metrics}" ]; then
                    custom_metrics="${custom_metrics},"
                fi
                custom_metrics="${custom_metrics}
        {\"name\": \"${metric_name}\", \"value\": ${metric_value}${unit_json}, \"timestamp\": \"\${timestamp}\"}"
            fi
        done < "${CUSTOM_METRICS_FILE}"
    fi

    echo "${custom_metrics}"
}

# Collect system metrics
collect_metrics() {
    local timestamp
    timestamp=$(date -Iseconds)

    # CPU usage
    local cpu_usage
    cpu_usage=$(grep 'cpu ' /proc/stat | awk '{usage=($2+$4)*100/($2+$4+$5)} END {printf "%.1f", usage}')

    # Memory usage
    local mem_info
    mem_info=$(awk '/MemTotal/{total=$2} /MemAvailable/{available=$2} END {printf "%.1f %d", (1-available/total)*100, available*1024}' /proc/meminfo)
    local mem_percent mem_available
    mem_percent=$(echo "${mem_info}" | cut -d' ' -f1)
    mem_available=$(echo "${mem_info}" | cut -d' ' -f2)

    # Disk usage
    local disk_usage
    disk_usage=$(df / | awk 'NR==2 {gsub(/%/,""); print $5}')

    # Temperature (if available)
    local temperature="0"
    if [ -f /sys/class/thermal/thermal_zone0/temp ]; then
        temperature=$(awk '{printf "%.1f", $1/1000}' /sys/class/thermal/thermal_zone0/temp)
    fi

    # Network stats
    local net_rx net_tx
    if [ -f /sys/class/net/eth0/statistics/rx_bytes ]; then
        net_rx=$(cat /sys/class/net/eth0/statistics/rx_bytes)
        net_tx=$(cat /sys/class/net/eth0/statistics/tx_bytes)
    elif [ -f /sys/class/net/end0/statistics/rx_bytes ]; then
        net_rx=$(cat /sys/class/net/end0/statistics/rx_bytes)
        net_tx=$(cat /sys/class/net/end0/statistics/tx_bytes)
    else
        net_rx=0
        net_tx=0
    fi

    # Uptime
    local uptime_seconds
    uptime_seconds=$(awk '{print int($1)}' /proc/uptime)

    # Collect custom metrics
    local custom_metrics
    custom_metrics=$(collect_custom_metrics)
    # Replace ${timestamp} placeholder with actual timestamp
    custom_metrics=$(echo "${custom_metrics}" | sed "s/\${timestamp}/${timestamp}/g")

    # Add comma before custom metrics if we have any
    local custom_metrics_section=""
    if [ -n "${custom_metrics}" ]; then
        custom_metrics_section=",${custom_metrics}"
    fi

    # Create metrics JSON (metric names match server dashboard expectations)
    cat > "${METRICS_DIR}/metrics_$(date +%s).json" << EOF
{
    "device_id": "${DEVICE_ID}",
    "firmware_version": "${FIRMWARE_VERSION}",
    "hardware_version": "${HARDWARE_VERSION}",
    "timestamp": "${timestamp}",
    "metrics": [
        {"name": "cpu_usage", "value": ${cpu_usage}, "unit": "percent", "timestamp": "${timestamp}"},
        {"name": "memory_usage", "value": ${mem_percent}, "unit": "percent", "timestamp": "${timestamp}"},
        {"name": "memory_available", "value": ${mem_available}, "unit": "bytes", "timestamp": "${timestamp}"},
        {"name": "disk_usage", "value": ${disk_usage}, "unit": "percent", "timestamp": "${timestamp}"},
        {"name": "temperature", "value": ${temperature}, "unit": "celsius", "timestamp": "${timestamp}"},
        {"name": "network_rx_bytes", "value": ${net_rx}, "unit": "bytes", "timestamp": "${timestamp}"},
        {"name": "network_tx_bytes", "value": ${net_tx}, "unit": "bytes", "timestamp": "${timestamp}"},
        {"name": "uptime", "value": ${uptime_seconds}, "unit": "seconds", "timestamp": "${timestamp}"}${custom_metrics_section}
    ]
}
EOF
}

# Upload metrics to server
upload_metrics() {
    # Whole org is billing_required (402) as of a previous attempt — skip
    # uploading entirely until the server's Retry-After deadline. New metrics
    # still get collected on COLLECTION_INTERVAL's own schedule; only the
    # upload attempt is paused.
    if [ -f "${METRICS_UPLOAD_PAUSED_UNTIL_FILE}" ]; then
        local metrics_paused_until metrics_now
        metrics_paused_until=$(cat "${METRICS_UPLOAD_PAUSED_UNTIL_FILE}" 2>/dev/null || echo 0)
        metrics_now=$(date +%s)
        if [ "${metrics_now}" -lt "${metrics_paused_until}" ]; then
            return
        fi
        rm -f "${METRICS_UPLOAD_PAUSED_UNTIL_FILE}"
    fi

    local count=0
    for file in "${METRICS_DIR}"/metrics_*.json; do
        [ -f "${file}" ] || continue

        if [ -n "${API_KEY}" ] && [ -n "${SERVER_URL}" ] && [ -n "${DEVICE_ID}" ]; then
            # Use correct API endpoint and headers for SoC Monitoring server
            # X-Device-ID must be the hardware device_id (not the server UUID)
            local upload_http_code body_file header_file
            body_file=$(mktemp)
            header_file=$(mktemp)
            upload_http_code=$(curl -s -X POST \
                -H "Content-Type: application/json" \
                -H "X-API-Key: ${API_KEY}" \
                -H "X-Device-ID: ${DEVICE_ID}" \
                -d "@${file}" \
                "${SERVER_URL}/api/v1/metrics" \
                --connect-timeout 30 \
                --max-time 60 \
                -D "${header_file}" \
                -o "${body_file}" \
                -w "%{http_code}")
            if printf '%s' "${upload_http_code}" | grep -q "^2"; then
                # HTTP success does not guarantee the server stored the data:
                # TASK-S42-006 uses 200 with {"status":"quota_exceeded"} when
                # the org is over its data-point ceiling with overage off.
                # Treat that as a knowing drop, not a successful upload —
                # resending the identical batch would just hit the same
                # ceiling again, so it is discarded (not retried).
                local resp_status
                resp_status=$(jq -r '.status // ""' "${body_file}" 2>/dev/null)
                if [ "${resp_status}" = "quota_exceeded" ]; then
                    log "Metrics upload rejected: data-point quota exceeded, dropping ${file} (will not retry this batch)"
                    touch "${METRICS_QUOTA_EXCEEDED_FILE}"
                else
                    rm -f "${METRICS_QUOTA_EXCEEDED_FILE}"
                    count=$((count + 1))
                fi
                rm -f "${file}"
            elif [ "${upload_http_code}" = "402" ]; then
                # Org is billing_required (disabled) — this is not a
                # per-batch problem, so unlike quota_exceeded the file is
                # kept for retry once unpaused. Every other pending file
                # would hit the same 402, so stop this round entirely rather
                # than hammering the server once per file.
                local retry_after
                retry_after=$(grep -i '^Retry-After:' "${header_file}" | tail -1 | sed 's/^[Rr]etry-[Aa]fter:[ \t]*//' | tr -d '\r\n')
                # A leading zero (e.g. "08") is a valid all-digit string but
                # POSIX $(( )) arithmetic treats a leading-zero literal as
                # octal, and "08"/"09" aren't valid octal digits at all —
                # busybox ash/dash abort with "arithmetic syntax error"
                # (fatal, even under set +e, since this is a non-interactive
                # shell); bash instead just returns 1 from the whole
                # command substitution, silently skipping the pause. A value
                # like "0060" would silently compute 48 instead of 60
                # (octal). Reject any leading zero up front so it falls
                # through to the safe 3600 default instead of ever reaching
                # $(( )).
                case "${retry_after}" in
                    ''|0*|*[!0-9]*) retry_after=3600 ;;
                esac
                log "Metrics upload blocked: org billing disabled (402); pausing uploads for ${retry_after}s per server Retry-After, will keep collecting"
                echo "$(($(date +%s) + retry_after))" > "${METRICS_UPLOAD_PAUSED_UNTIL_FILE}"
                rm -f "${body_file}" "${header_file}"
                break
            else
                log "Failed to upload metrics from ${file} (HTTP ${upload_http_code})"
                if [ "${upload_http_code}" = "401" ] || [ "${upload_http_code}" = "403" ]; then
                    # This API key is no longer accepted for this device (rotated
                    # or revoked out from under us — socmond has no other reload
                    # trigger once it has loaded a key at startup/last
                    # provisioning, so without this it would retry the same
                    # rejected key forever, BUG-288). Remove it so
                    # provision_device()'s "skip if already provisioned" check
                    # (it only looks at whether API_KEY_FILE is non-empty, not
                    # whether the server still accepts it) doesn't just hand
                    # the same rejected key straight back, and flag for
                    # immediate re-provisioning instead of waiting on the
                    # interval-gated retry in the main loop, which only fires
                    # when provisioned=false.
                    log "API key rejected (HTTP ${upload_http_code}) — clearing it and flagging for re-provisioning"
                    rm -f "${API_KEY_FILE}"
                    touch "${NEEDS_REPROVISION_FILE}"
                fi
            fi
            rm -f "${body_file}" "${header_file}"
        else
            # No API key configured, just rotate old files (keep last 100)
            local file_count
            file_count=$(ls -1 "${METRICS_DIR}"/metrics_*.json 2>/dev/null | wc -l)
            if [ "${file_count}" -gt 100 ]; then
                rm -f "${file}"
            fi
        fi
    done

    if [ ${count} -gt 0 ]; then
        log "Uploaded ${count} metric batches"
    fi
}

# Upload pending coredumps
upload_coredumps() {
    # Crash-reporting is a different billing product from metrics, so it
    # pauses independently — see METRICS_UPLOAD_PAUSED_UNTIL_FILE above.
    if [ -f "${COREDUMP_UPLOAD_PAUSED_UNTIL_FILE}" ]; then
        local coredump_paused_until coredump_now
        coredump_paused_until=$(cat "${COREDUMP_UPLOAD_PAUSED_UNTIL_FILE}" 2>/dev/null || echo 0)
        coredump_now=$(date +%s)
        if [ "${coredump_now}" -lt "${coredump_paused_until}" ]; then
            return
        fi
        rm -f "${COREDUMP_UPLOAD_PAUSED_UNTIL_FILE}"
    fi

    for meta_file in "${COREDUMP_DIR}"/*.meta; do
        [ -f "${meta_file}" ] || continue

        local uploaded
        uploaded=$(jq -r '.uploaded' "${meta_file}")
        [ "${uploaded}" = "false" ] || continue

        # Server returned 200 quota_exceeded for this specific file on a
        # previous attempt: the crash-reporting ceiling was hit, so this
        # exact payload will never be accepted — dropped knowingly, not
        # retried (unlike `uploaded`, the server never actually got it).
        local quota_dropped
        quota_dropped=$(jq -r '.quota_dropped // false' "${meta_file}")
        [ "${quota_dropped}" = "false" ] || continue

        local coredump_file process_name signal_num executable
        coredump_file=$(jq -r '.coredump_file' "${meta_file}")
        # Fall back to .executable when core-handler.sh's .meta has no
        # process_name field (it currently never writes one, so this was
        # always "unknown" — BUG-179 cosmetic fix).
        process_name=$(jq -r '.process_name // .executable // "unknown"' "${meta_file}")
        signal_num=$(jq -r '.signal // "0"' "${meta_file}")
        executable=$(jq -r '.executable // ""' "${meta_file}")
        [ -f "${coredump_file}" ] || continue

        if [ -n "${API_KEY}" ] && [ -n "${SERVER_URL}" ] && [ -n "${DEVICE_ID}" ]; then
            local http_code curl_status body_file header_file
            body_file=$(mktemp)
            header_file=$(mktemp)
            http_code=$(curl -s -X POST \
                -H "X-API-Key: ${API_KEY}" \
                -H "X-Device-ID: ${DEVICE_ID}" \
                -H "X-Process-Name: ${process_name}" \
                -H "X-Signal: ${signal_num}" \
                -H "X-Executable: ${executable}" \
                -F "file=@${coredump_file}" \
                "${SERVER_URL}/api/v1/coredump" \
                --connect-timeout 30 \
                --max-time 300 \
                -D "${header_file}" \
                -o "${body_file}" \
                -w "%{http_code}")
            curl_status=$?
            if [ ${curl_status} -eq 0 ] && echo "${http_code}" | grep -q "^2"; then
                local resp_status
                resp_status=$(jq -r '.status // ""' "${body_file}" 2>/dev/null)
                if [ "${resp_status}" = "quota_exceeded" ]; then
                    log "Coredump upload rejected: crash-reporting quota exceeded, dropping ${coredump_file} (will not retry this file)"
                    jq '.quota_dropped = true' "${meta_file}" > "${meta_file}.tmp" && mv "${meta_file}.tmp" "${meta_file}"
                else
                    # Mark as uploaded
                    jq '.uploaded = true' "${meta_file}" > "${meta_file}.tmp" && mv "${meta_file}.tmp" "${meta_file}"
                    log "Uploaded coredump: ${coredump_file}"
                fi
            elif [ ${curl_status} -eq 0 ] && [ "${http_code}" = "402" ]; then
                # Whole org is blocked for crash-reporting — every remaining
                # pending file would hit the same 402, so stop this round
                # rather than hammering the server once per file. This file
                # stays pending (no failure recorded) for the next unpaused
                # round.
                local retry_after
                retry_after=$(grep -i '^Retry-After:' "${header_file}" | tail -1 | sed 's/^[Rr]etry-[Aa]fter:[ \t]*//' | tr -d '\r\n')
                # A leading zero (e.g. "08") is a valid all-digit string but
                # POSIX $(( )) arithmetic treats a leading-zero literal as
                # octal, and "08"/"09" aren't valid octal digits at all —
                # busybox ash/dash abort with "arithmetic syntax error"
                # (fatal, even under set +e, since this is a non-interactive
                # shell); bash instead just returns 1 from the whole
                # command substitution, silently skipping the pause. A value
                # like "0060" would silently compute 48 instead of 60
                # (octal). Reject any leading zero up front so it falls
                # through to the safe 3600 default instead of ever reaching
                # $(( )).
                case "${retry_after}" in
                    ''|0*|*[!0-9]*) retry_after=3600 ;;
                esac
                log "Coredump upload blocked: org billing disabled (402) for crash-reporting; pausing coredump uploads for ${retry_after}s per server Retry-After, will keep capturing new coredumps"
                echo "$(($(date +%s) + retry_after))" > "${COREDUMP_UPLOAD_PAUSED_UNTIL_FILE}"
                rm -f "${body_file}" "${header_file}"
                break
            else
                # BUG-179: a failing upload used to leave zero diagnostic trace
                # anywhere (no log line, no meta bookkeeping), which is exactly
                # what made BUG-177 look like an upload-path bug. Log it and
                # record it on the .meta so a stuck coredump is diagnosable.
                log "ERROR: Failed to upload coredump ${coredump_file} (curl_exit=${curl_status} http_status=${http_code:-none})"
                jq --arg ts "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
                    --arg msg "curl_exit=${curl_status} http_status=${http_code:-none}" \
                    '.last_upload_error = {"message": $msg, "timestamp": $ts} | .upload_attempts = ((.upload_attempts // 0) + 1)' \
                    "${meta_file}" > "${meta_file}.tmp" && mv "${meta_file}.tmp" "${meta_file}"
            fi
            rm -f "${body_file}" "${header_file}"
        fi
    done
}

# NOTE: OTA functionality has been removed from socmond
# OTA updates are now handled by soc-ota-agent (customized Mender client)
# See /etc/mender/mender.conf for OTA configuration

# Send heartbeat to server
send_heartbeat() {
    if [ -z "${API_KEY}" ] || [ -z "${SERVER_URL}" ] || [ -z "${SERVER_DEVICE_ID}" ]; then
        return
    fi

    local uptime_seconds
    uptime_seconds=$(awk '{print int($1)}' /proc/uptime)

    # Report tunnel connectivity so the backend can keep tunnel_online=true after
    # reboots without manual DB intervention (BUG-100).
    #
    # Signal: soc-ota-tunneld process active (daemon liveness, not frpc
    # establishment). There is a window of seconds after daemon start where
    # connected:true is emitted before frpc completes the Login handshake, but
    # that false-positive window is bounded and negligible compared to the prior
    # false-negative (tunnel_status permanently stuck at "unknown" after every
    # reboot until manual SQL).
    #
    # tunnel_id routing: this heartbeat itself authenticates via API key /
    # X-Device-ID and is applied by the backend to whichever device row that
    # resolves to (the canonical row, per the MONE2E-001 tiered device
    # matching) — so tunnel_id is self-aligning regardless of what proxyName
    # or SoCDeviceID happen to be on this device. What matters is that
    # tunnel_id is the EXACT proxy name frps sees on the wire, since the
    # session gateway looks tunnels up by that string (device.tunnel_id
    # falling back to device.device_id). NOTE: proxyName in tunnel.conf is
    # NOT guaranteed to equal any backend row's device_id (on live boards it
    # is frequently a backend-row UUID, not a dev-XXXX id) — its only job is
    # frps proxy-name uniqueness, not routing correctness. Routing
    # correctness comes from reading the name frpc actually rendered/sent,
    # not from re-deriving it from tunnel.conf.
    local tunnel_json=""
    if systemctl is-active --quiet soc-ota-tunneld 2>/dev/null; then
        local proxy_name="" tunnel_id_field=""
        if [ -f "/data/frp/frpc.toml" ]; then
            # Rendered frpc config is authoritative — this is the literal
            # `name` frpc registers with frps on NewProxy, taken from the
            # first [[proxies]] entry.
            proxy_name=$(sed -n 's/^name *= *"\(.*\)".*/\1/p' /data/frp/frpc.toml 2>/dev/null | head -1)
        fi
        if [ -z "${proxy_name}" ] && [ -f "/etc/otapulse/tunnel.conf" ]; then
            # Fallback: rendered config missing (e.g. daemon hasn't rendered
            # yet this boot) — tunnel.conf's proxyName is what it will render
            # to once it does.
            proxy_name=$(jq -r '.proxyName // ""' /etc/otapulse/tunnel.conf 2>/dev/null || true)
        fi
        if [ -n "${proxy_name}" ]; then
            # Strip characters that would break inline JSON (quotes, backslashes).
            proxy_name=$(printf '%s' "${proxy_name}" | tr -d '"\\')
            tunnel_id_field=",\"tunnel_id\":\"${proxy_name}\""
        fi
        tunnel_json=",\"tunnel\":{\"connected\":true${tunnel_id_field}}"
    fi

    # Send heartbeat (OTA updates are handled by soc-ota-agent)
    curl -s -X POST \
        -H "Content-Type: application/json" \
        -H "X-API-Key: ${API_KEY}" \
        -H "X-Device-ID: ${DEVICE_ID}" \
        -d "{\"firmware_version\":\"${FIRMWARE_VERSION}\",\"uptime\":${uptime_seconds}${tunnel_json}}" \
        "${SERVER_URL}/api/v1/heartbeat" \
        --connect-timeout 10 \
        --max-time 30 \
        -o /dev/null 2>/dev/null || true
}

# Report reboot reason to the server
report_reboot() {
    local reason_file="/var/lib/socmond/last_reboot_reason"
    local reason="unknown"

    # Try to determine reboot reason
    if [ -f "${reason_file}" ]; then
        reason=$(cat "${reason_file}")
    elif dmesg 2>/dev/null | grep -q "watchdog"; then
        reason="watchdog"
    elif [ -f /sys/kernel/reboot/reason ]; then
        reason=$(cat /sys/kernel/reboot/reason)
    fi

    log "Reboot reason: ${reason}"

    # Strip characters that would break inline JSON (quotes, backslashes, newlines).
    reason=$(printf '%s' "${reason}" | tr -d '"\\' | tr '\n' ' ')

    # The shell variant does not track pre-reboot uptime, so it reports null.
    if [ -n "${API_KEY}" ] && [ -n "${SERVER_URL}" ] && [ -n "${DEVICE_ID}" ]; then
        if curl -s -X POST \
            -H "Content-Type: application/json" \
            -H "X-API-Key: ${API_KEY}" \
            -H "X-Device-ID: ${DEVICE_ID}" \
            -d "{\"reason\":\"${reason}\",\"uptime_before_seconds\":null}" \
            "${SERVER_URL}/api/v1/reboot" \
            --connect-timeout 10 \
            --max-time 30 \
            -o /dev/null \
            -w "%{http_code}" | grep -q "^2"; then
            log "Reported reboot reason to server"
            # Only clear once the server has it — otherwise the next boot retries.
            rm -f "${reason_file}"
        else
            log "Failed to report reboot reason, will retry on next boot"
        fi
    fi
}

# Create Unix socket for IPC (simplified)
start_socket_listener() {
    rm -f "${SOCKET_PATH}"
    # Note: In production, use a proper socket server
    # This is a placeholder for the shell script version
}

# Cleanup on exit
cleanup() {
    log "Shutting down socmond"
    rm -f "${PID_FILE}" "${SOCKET_PATH}"
    exit 0
}

trap cleanup SIGTERM SIGINT

# Main daemon loop
main() {
    log "Starting socmond (device_id=${DEVICE_ID})"
    log "Server URL: ${SERVER_URL}"
    log "API Key source: $([ -f "${API_KEY_FILE}" ] && [ -s "${API_KEY_FILE}" ] && echo 'file' || echo 'config')"
    log "API Key: $(printf '%.12s' "$API_KEY")... (length: ${#API_KEY})"
    echo $$ > "${PID_FILE}"

    # Notify systemd we're ready EARLY so we don't block boot
    # Registration/provisioning will happen in background
    notify_systemd

    # Report reboot on startup
    report_reboot

    # First, try provisioning flow (new devices) - but don't block startup
    local provisioned=false
    if [ -n "${PROVISIONING_TOKEN}" ]; then
        log "Attempting device provisioning..."
        local provision_attempts=0
        while ! provision_device && [ ${provision_attempts} -lt 3 ]; do
            provision_attempts=$((provision_attempts + 1))
            log "Provisioning attempt ${provision_attempts} failed, retrying in 10s..."
            sleep 10
        done
        if [ -f "${API_KEY_FILE}" ]; then
            provisioned=true
            log "Device provisioned successfully"
        else
            log "Provisioning failed, will continue without server connectivity"
        fi
    else
        log "No provisioning token configured"
    fi

    # If not provisioned via token, try legacy registration
    if [ "${provisioned}" = "false" ] && [ -n "${API_KEY}" ]; then
        log "Attempting device registration..."
        local registration_attempts=0
        while ! register_device && [ ${registration_attempts} -lt 3 ]; do
            registration_attempts=$((registration_attempts + 1))
            log "Registration attempt ${registration_attempts} failed, retrying in 10s..."
            sleep 10
        done
        if [ ! -f "${SERVER_DEVICE_ID_FILE}" ]; then
            log "Registration failed, will continue without server connectivity"
        fi
    else
        log "No API key configured, skipping legacy registration"
    fi

    local last_collection=0
    local last_upload=0
    local last_heartbeat=0
    local heartbeat_interval=60
    local last_reprovision_attempt=0
    local reprovision_interval=300

    # NOTE: OTA updates are handled by soc-ota-agent, not socmond
    log "OTA updates are handled by soc-ota-agent service"

    while true; do
        local now
        now=$(date +%s)

        # Pet the watchdog
        pet_watchdog

        # upload_metrics flagged our API key as rejected (401/403) since the
        # last iteration — force the reprovision branch below to run now
        # rather than waiting up to reprovision_interval (BUG-288).
        if [ -f "${NEEDS_REPROVISION_FILE}" ]; then
            rm -f "${NEEDS_REPROVISION_FILE}"
            provisioned=false
            last_reprovision_attempt=0
            log "Re-provisioning triggered by a rejected API key"
        fi

        # Retry provisioning if still not provisioned. Provisioning state
        # lives on the rootfs and is wiped by every A/B slot switch, so
        # without this the daemon would stay a permanently unprovisioned,
        # watchdog-healthy zombie after any OTA update (RC-B3).
        if [ "${provisioned}" = "false" ] && [ $((now - last_reprovision_attempt)) -ge "${reprovision_interval}" ]; then
            if provision_device; then
                provisioned=true
                log "Re-provisioning succeeded — device is now connected"
            else
                log "Re-provisioning attempt failed, will retry in ${reprovision_interval}s"
            fi
            last_reprovision_attempt=${now}
        fi

        # Send heartbeat
        if [ $((now - last_heartbeat)) -ge "${heartbeat_interval}" ]; then
            send_heartbeat
            last_heartbeat=${now}
        fi

        # Collect metrics
        if [ $((now - last_collection)) -ge "${COLLECTION_INTERVAL}" ]; then
            collect_metrics
            last_collection=${now}
        fi

        # Upload metrics
        if [ $((now - last_upload)) -ge "${UPLOAD_INTERVAL}" ]; then
            upload_metrics
            upload_coredumps
            last_upload=${now}
        fi

        sleep 10
    done
}

# Handle command line arguments
case "${1:-}" in
    --config)
        CONFIG_FILE="${2}"
        shift 2
        ;;
    --version)
        echo "socmond 1.0.0"
        exit 0
        ;;
    --help)
        echo "Usage: socmond [--config FILE] [--version] [--help]"
        exit 0
        ;;
esac

main
