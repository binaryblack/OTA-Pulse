[Unit]
Description=SoC Monitoring Watchdog Service
Documentation=https://github.com/example/soc-monitoring
After=socmond.service
Requires=socmond.service
PartOf=socmond.service

[Service]
Type=simple
ExecStart=/usr/bin/socmond-watchdog
Restart=always
RestartSec=10

# Resource limits
MemoryMax=20M
CPUQuota=5%

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/socmond
ReadWritePaths=/var/log/socmond

# Access to watchdog device
DeviceAllow=/dev/watchdog rw

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=socmond-watchdog

[Install]
WantedBy=multi-user.target
