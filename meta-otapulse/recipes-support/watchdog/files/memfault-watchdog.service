[Unit]
Description=SoC Monitoring Watchdog Service
Documentation=https://github.com/example/soc-monitoring
After=memfaultd.service
Requires=memfaultd.service
PartOf=memfaultd.service

[Service]
Type=simple
ExecStart=/usr/bin/memfault-watchdog
Restart=always
RestartSec=10

# Resource limits
MemoryMax=20M
CPUQuota=5%

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/memfault
ReadWritePaths=/var/log/memfault

# Access to watchdog device
DeviceAllow=/dev/watchdog rw

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=memfault-watchdog

[Install]
WantedBy=multi-user.target
