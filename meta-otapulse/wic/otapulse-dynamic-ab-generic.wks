# OTAPulse Dynamic A/B WKS - Generic Template
# For platforms with u-boot at standard location
#
# Adapt for your platform:
# 1. Copy this file to your layer
# 2. Modify bootloader section for your platform
# 3. Replace --ondisk mmcblk0 with the right Linux mmc index for your board
#    (mmcblk0 is correct for most SD-boot ARM boards. iMX8MP eMMC = mmcblk2,
#    BeaglePlay / Radxa CM5 eMMC = mmcblk0.)
# 4. Set WKS_FILE in local.conf
#
# WARNING: --ondisk MUST end in a digit. wic concatenates this with the
# partition number to build /etc/fstab paths — passing "mmcblk" (no index)
# produces "/dev/mmcblkp1" which never exists, and systemd hangs ~1m30s
# at boot waiting for it. See `beagleplay-ti.wks` for the original bug report.
#
# Usage:
#   WKS_FILE = "otapulse-dynamic-ab-generic.wks"
#   IMAGE_INSTALL:append = " otapulse-firstboot"

# =============================================================================
# BOOTLOADER SECTION - CUSTOMIZE FOR YOUR PLATFORM
# =============================================================================
# Examples for different platforms:
#
# i.MX8:
#   part u-boot --source rawcopy --sourceparams="file=imx-boot" --ondisk mmcblk0 --no-table --align 32
#
# Raspberry Pi (no raw bootloader, uses boot partition):
#   (skip this section, firmware is in boot partition)
#
# STM32MP:
#   part fsbl1 --source rawcopy --sourceparams="file=tf-a-stm32mp.stm32" --ondisk mmcblk0 --no-table --align 17
#   part fsbl2 --source rawcopy --sourceparams="file=tf-a-stm32mp.stm32" --ondisk mmcblk0 --no-table --align 273
#
# Rockchip:
#   part idbloader --source rawcopy --sourceparams="file=idbloader.img" --ondisk mmcblk0 --no-table --align 64
#   part u-boot --source rawcopy --sourceparams="file=u-boot.itb" --ondisk mmcblk0 --no-table --align 16384
#
# =============================================================================

# Boot partition (FAT32) - Contains kernel, DTB, boot scripts
part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --part-name boot --active --align 8192 --size 64

# Root filesystem A - Sized to content, GPT label for OTA agent
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs_a --part-name rootfs_a --align 8192

# GPT partition table (required for partition labels)
bootloader --ptable gpt

# Note: rootfs_b and data partitions are created by otapulse-firstboot on first boot
