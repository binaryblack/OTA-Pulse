#!/bin/sh /etc/rc.common
# OTAPulse procd init script for OpenWrt
#
# Translates UCI configuration (/etc/config/otapulse) to the JSON
# config format expected by the agent (/tmp/otapulse.conf), then
# starts the daemon under procd supervision.

START=95
STOP=10

USE_PROCD=1
PROG=/usr/bin/otapulse
CONF_DIR=/etc/otapulse
CONF_FILE=/tmp/otapulse.conf

# Generate JSON config from UCI settings
generate_config() {
    local server_url tenant_token device_type
    local rootfs_part_a rootfs_part_b
    local update_poll inventory_poll retry_poll
    local verify_key use_file_bootenv

    config_load otapulse

    config_get server_url server url ""
    config_get tenant_token server tenant_token ""
    config_get device_type device type ""
    config_get rootfs_part_a device rootfs_part_a "/dev/mmcblk0p3"
    config_get rootfs_part_b device rootfs_part_b "/dev/mmcblk0p4"
    config_get update_poll timing update_poll 1800
    config_get inventory_poll timing inventory_poll 28800
    config_get retry_poll timing retry_poll 300
    config_get verify_key security verify_key ""
    config_get_bool use_file_bootenv device use_file_bootenv 1

    # Validate minimum config
    if [ -z "$server_url" ]; then
        logger -t otapulse "ERROR: server URL not configured in /etc/config/otapulse"
        return 1
    fi

    if [ -z "$device_type" ]; then
        logger -t otapulse "ERROR: device type not configured in /etc/config/otapulse"
        return 1
    fi

    # Write device_type file
    echo "device_type=${device_type}" > "${CONF_DIR}/device_type"

    # Generate JSON config using printf for safe value handling
    local use_file_bootenv_json="false"
    [ "$use_file_bootenv" -eq 1 ] 2>/dev/null && use_file_bootenv_json="true"

    local verify_key_line=""
    if [ -n "$verify_key" ]; then
        verify_key_line="$(printf ',\n    "ArtifactVerifyKey": "%s"' "$verify_key")"
    fi

    printf '{\n    "ServerURL": "%s",\n    "TenantToken": "%s",\n    "RootfsPartA": "%s",\n    "RootfsPartB": "%s",\n    "UpdatePollIntervalSeconds": %s,\n    "InventoryPollIntervalSeconds": %s,\n    "RetryPollIntervalSeconds": %s,\n    "UseFileBasedBootEnv": %s%s\n}\n' \
        "$server_url" "$tenant_token" "$rootfs_part_a" "$rootfs_part_b" \
        "$update_poll" "$inventory_poll" "$retry_poll" \
        "$use_file_bootenv_json" "$verify_key_line" > "$CONF_FILE"

    logger -t otapulse "Configuration generated: server=${server_url} device=${device_type}"
    return 0
}

start_service() {
    # Generate config from UCI
    if ! generate_config; then
        logger -t otapulse "Failed to generate config, not starting"
        return 1
    fi

    # Ensure data directories exist
    mkdir -p /data/ota
    mkdir -p /var/lib/otapulse

    procd_open_instance
    procd_set_param command "$PROG" daemon
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_set_param stdout 1
    procd_set_param file /etc/config/otapulse
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "otapulse"
}

reload_service() {
    # Regenerate config — procd will handle the restart via file trigger
    generate_config
}
