# Pinned build environment for the OTA-Pulse Debian packages (TASK-S109-024).
# Sourced by ota-pulse/scripts/build-debs.sh and read by Dockerfile.builder (as build args).
#
# BUILDER_BASE_IMAGE: Go toolchain on Debian 12 "bookworm", pinned by manifest-list digest
#   (golang:1.22.12-bookworm). Changing the digest changes the builder tag, which rebuilds the image.
# DEBIAN_SNAPSHOT: every apt package of the builder (cross compilers, -dev libraries, debhelper,
#   lintian) comes from snapshot.debian.org at this instant, so rebuilding the builder later yields
#   the same package versions. The snapshot is a pure pin: bump it deliberately, never implicitly.
BUILDER_BASE_IMAGE=golang@sha256:3d699e4d15d0f8f13c9195c0632a16702b8cbdece2955af1c23b37ae5d55a253
DEBIAN_SNAPSHOT=20260901T000000Z
