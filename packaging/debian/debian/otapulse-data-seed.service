[Unit]
Description=OTA-Pulse persistent data seeding
Documentation=man:soc-ota-agent(1)
# Seeds /data/otapulse/device_type from /etc/otapulse/device_type and verifies an existing one; it
# does not partition, format, mount or resize anything and never touches /data/u-boot (see the
# script header). It refuses to seed onto the root file system: /data must be a mount point, as on
# the images these packages are installed into.
RequiresMountsFor=/data
After=data.mount
Before=soc-ota-agent.service socmond.service
# A seed failure keeps the agent down (it Requires= this unit). On an uncommitted update nothing would
# ever commit or reboot it, so the failure handler reboots and the bootloader reverts the update; on a
# committed slot it only logs loudly (otapulse-bl-guard).
OnFailure=otapulse-bl-seed-failure.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/otapulse/otapulse-data-seed
StandardOutput=journal
StandardError=journal
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
