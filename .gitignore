# Build artifacts
build/
tmp/
*.o
*.a
*.so

# Go
vendor/
*.exe
*.exe~
*.test
*.out
coverage.*

# Yocto/BitBake
sstate-cache/
downloads/
cache/
tmp*/
*.pyc
__pycache__/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment
.env
.env.*

# Credentials (never commit private keys)
*.key
!*.pub

# PEM files - block private keys, allow public keys
*-private.pem
*-private-*.pem

# Allow example public keys for OTA-Pulse (these are placeholders, not real secrets)
!meta-otapulse/recipes-core/signing-keys/files/example-*.pem

# BUG-446: throwaway soc-ota-agent test-only TLS fixture keys (self-signed,
# localhost-only, protect nothing real), shared by client/*_test.go and
# app/*_test.go's mTLS tests via their fixed relative testdata paths.
# Regenerable via soc-ota-agent/client/testdata/generate_fixtures.sh and
# soc-ota-agent/client/test/generate_fixtures.sh.
!soc-ota-agent/client/testdata/*.key
!soc-ota-agent/client/test/*.key
