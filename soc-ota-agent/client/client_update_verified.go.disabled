// Enhanced Update Client with Signature Verification

package client

import (
	"io"
	"io/ioutil"
	"os"
	"time"

	"github.com/pkg/errors"
	log "github.com/sirupsen/logrus"
)

// UpdateClientWithVerification extends UpdateClient with signature verification
type UpdateClientWithVerification struct {
	*UpdateClient
	verifier *SignatureVerifier
}

// NewUpdateWithVerification creates an update client with signature verification
func NewUpdateWithVerification(keysDirectory string, enabled bool) (*UpdateClientWithVerification, error) {
	verifier, err := NewSignatureVerifier(keysDirectory, enabled)
	if err != nil {
		return nil, errors.Wrap(err, "failed to initialize signature verifier")
	}

	return &UpdateClientWithVerification{
		UpdateClient: NewUpdate(),
		verifier:     verifier,
	}, nil
}

// FetchUpdateWithVerification downloads and verifies firmware before returning
func (u *UpdateClientWithVerification) FetchUpdateWithVerification(
	api ApiRequester,
	url string,
	maxWait time.Duration,
) (io.ReadCloser, int64, error) {

	if u.verifier == nil || !u.verifier.verificationEnabled {
		// Fall back to standard fetch if verification disabled
		log.Info("Signature verification disabled, using standard FetchUpdate")
		return u.FetchUpdate(api, url, maxWait)
	}

	// Check if in security lockdown
	if u.verifier.IsLockdownActive() {
		return nil, -1, errors.New("Device in security lockdown - updates disabled")
	}

	log.Info("Starting firmware download with signature verification")

	// Download firmware and signature, then verify
	firmwareData, result, err := DownloadAndVerifyFirmware(api, url, u.verifier)
	if err != nil {
		log.Errorf("Download and verify failed: %v", err)
		return nil, -1, err
	}

	if !result.Valid {
		log.Errorf("Signature verification failed: %s", result.Error)
		return nil, -1, errors.Errorf("signature verification failed: %s", result.Error)
	}

	log.Infof("✓ Firmware verified successfully: %s (%s)",
		result.Algorithm, result.KeyFingerprint)

	// Save verified firmware to temporary file
	tmpPath, err := SaveVerifiedFirmware(firmwareData)
	if err != nil {
		return nil, -1, errors.Wrap(err, "failed to save verified firmware")
	}

	// Open file for reading
	file, err := os.Open(tmpPath)
	if err != nil {
		CleanupVerifiedFirmware(tmpPath)
		return nil, -1, errors.Wrap(err, "failed to open verified firmware")
	}

	// Create a ReadCloser that also cleans up the temp file
	readCloser := &verifiedFirmwareReader{
		file:    file,
		tmpPath: tmpPath,
	}

	return readCloser, int64(len(firmwareData)), nil
}

// verifiedFirmwareReader wraps a file reader and cleans up on close
type verifiedFirmwareReader struct {
	file    *os.File
	tmpPath string
}

func (r *verifiedFirmwareReader) Read(p []byte) (n int, err error) {
	return r.file.Read(p)
}

func (r *verifiedFirmwareReader) Close() error {
	// Close file first
	if err := r.file.Close(); err != nil {
		log.Warnf("Failed to close verified firmware file: %v", err)
	}

	// Then cleanup temp file
	if err := CleanupVerifiedFirmware(r.tmpPath); err != nil {
		log.Warnf("Failed to cleanup verified firmware: %v", err)
	}

	return nil
}

// GetVerifier returns the signature verifier instance
func (u *UpdateClientWithVerification) GetVerifier() *SignatureVerifier {
	return u.verifier
}

// ResetLockdown resets security lockdown (for manual intervention)
func (u *UpdateClientWithVerification) ResetLockdown() {
	if u.verifier != nil {
		u.verifier.ResetFailureCount()
		log.Info("Security lockdown reset")
	}
}

// GetVerificationStatus returns current verification status
func (u *UpdateClientWithVerification) GetVerificationStatus() map[string]interface{} {
	if u.verifier == nil {
		return map[string]interface{}{
			"enabled": false,
		}
	}

	return map[string]interface{}{
		"enabled":        u.verifier.verificationEnabled,
		"keys_loaded":    len(u.verifier.keys),
		"failure_count":  u.verifier.GetFailureCount(),
		"lockdown_active": u.verifier.IsLockdownActive(),
		"keys_directory": u.verifier.keysDirectory,
	}
}
