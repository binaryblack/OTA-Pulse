# SoC OTA Agent Configuration
# Configuration for firmware signature verification

# Security Settings
[security]
# Enable/disable signature verification
verify_signatures = true

# Reject firmware without valid signature
reject_unsigned = true

# Directory containing public keys for verification
keys_directory = /etc/soc-monitoring/signing-keys/active

# Maximum consecutive verification failures before lockdown
max_verification_failures = 5

# Failure window in hours (reset counter after this time)
failure_window_hours = 24

# Actions on Verification Failure
[security.failure_actions]
# Send alert to server when verification fails
alert_on_failure = true

# Delete unverified firmware immediately
delete_on_failure = true

# Disable automatic updates during lockdown
lockdown_disable_auto_update = true

# Require manual approval to restore after lockdown
lockdown_require_manual_approval = true

# Logging
[security.logging]
# Write security events to dedicated log
security_log_file = /var/log/soc-ota-security.log

# Log level for security events (DEBUG, INFO, WARN, ERROR)
security_log_level = INFO

# Server Integration
[server]
# Server URL for verification logging
server_url = https://your-server.com

# Endpoint for verification logs
verification_log_endpoint = /api/signing/verify-log

# Device ID for logging
device_id = your-device-id

# Notes:
# - Private keys should NEVER be on the device
# - Only public keys are needed for verification
# - Keys are embedded in firmware via Yocto recipe
# - Key rotation requires firmware update
# - Multiple keys supported for smooth rotation
