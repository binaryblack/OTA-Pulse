[Unit]
Description=OTAPulse - SoC OTA Agent for Firmware Updates
Documentation=https://github.com/binaryblack/OTA-Pulse
# BUG-317: Requires= alone does not order startup — without an explicit
# After=data.mount, systemd can start this unit in parallel with (or before)
# data.mount finishing, letting this agent's first ReadEnv/WriteEnv race the
# mount. See the shipped meta-otapulse copy of this file for the full
# rationale (this dev/support copy is not baked into real images, but the
# gap is identical).
After=network-online.target systemd-resolved.service data.mount
Wants=network-online.target
Requires=data.mount
Conflicts=mender.service mender-client.service

[Service]
Type=simple
User=root
# Check for config file (new OTAPulse path with fallback to legacy Mender path)
ExecStartPre=/bin/sh -c 'test -f /etc/otapulse/otapulse.conf || test -f /etc/mender/mender.conf'
ExecStart=/usr/bin/soc-ota-agent daemon
Restart=on-failure
RestartSec=30
# Disable watchdog - OTA updates for 6GB images can take 30+ minutes
# The agent has its own timeout handling for network operations
WatchdogSec=0

# Hardening - use 'full' instead of 'strict' to allow /data writes
# BUG-095: ProtectSystem=full|true|strict remount /boot read-only and
# ReadWritePaths/BindPaths cannot carve a separate FS mount back to rw, so the
# agent's boot-slot write (A/B switch) got EROFS and the device always booted the
# old slot. Disable it; the agent runs as root and must write /boot + partitions.
ProtectSystem=false
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=no

# Allow write access to required paths
# Note: Legacy /etc/mender and /var/lib/mender paths removed to prevent
# mount namespacing failures on clean OTAPulse installations.
# Backward compatibility is handled by the agent code's fallback logic.
ReadWritePaths=/var/lib/otapulse
ReadWritePaths=/etc/otapulse
ReadWritePaths=/data
ReadWritePaths=/data/ota

# Environment
Environment="PATH=/usr/bin:/bin:/usr/sbin:/sbin"
# The agent is a Go binary. Go's runtime catches fatal signals (SIGSEGV/etc)
# and by default exits without re-raising them, so the kernel's core_pattern
# pipe handler is never invoked and a crash produces no coredump. GOTRACEBACK
# =crash makes Go reset the signal disposition to default and re-raise, so
# the real coredump pipeline fires (CRASH-004).
Environment="GOTRACEBACK=crash"

[Install]
WantedBy=multi-user.target
